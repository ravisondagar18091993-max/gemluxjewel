{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-product.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-pdp-faq">
  <div class="gemluxjewel-container">
    <div class="gemluxjewel-pdp-faq__grid">
      <div class="gemluxjewel-pdp-faq__intro-col">
        <div class="gemluxjewel-pdp-faq__header">
          {%- if section.settings.prefix != blank -%}
            <p class="gemluxjewel-prefix gemluxjewel-pdp-faq__prefix">{{ section.settings.prefix | escape }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="gemluxjewel-section-title gemluxjewel-pdp-faq__title">{{ section.settings.title | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="gemluxjewel-section-desc gemluxjewel-pdp-faq__desc">{{ section.settings.text | escape }}</p>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            {% render 'gemluxjewel-btn', label: section.settings.button_label, url: section.settings.button_link, style: 'green' %}
          {%- endif -%}
        </div>
      </div>

      <div class="gemluxjewel-pdp-faq__accordion-col">
        <div class="gemluxjewel-pdp-faq__accordian-block">
          <div class="closet-accordion" data-gemluxjewel-accordion>
            {%- for block in section.blocks -%}
              <div class="closet-item" {{ block.shopify_attributes }}>
                <div
                  class="closet-header"
                  role="button"
                  tabindex="0"
                  aria-expanded="false"
                >
                  <div class="closet-header-title">{{ block.settings.question | escape }}</div>
                  <div class="accordion-close">
                    <img src="{{ 'down-arrow.svg' | asset_url }}" alt="" width="24" height="24">
                  </div>
                </div>
                <div class="closet-content">
                  <div class="closet-content__inner rte">
                    {{ block.settings.answer }}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "gemluxjewel Product FAQ",
  "tag": "section",
  "class": "gemluxjewel-section",
  "settings": [
    { "type": "text", "id": "prefix", "label": "Prefix", "default": "NEED HELP?" },
    { "type": "text", "id": "title", "label": "Heading", "default": "FREQUENTLY ASKED QUESTIONS" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Find answers to common questions about our jewellery, materials, and care to help you shop with confidence."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View All FAQ's" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Is Titanium Jewellery Safe For Sensitive Skin?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes, absolutely. Titanium is completely hypoallergenic and biocompatible.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Product FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Is Titanium Jewellery Safe For Sensitive Skin?",
            "answer": "<p>Yes, absolutely. Titanium is completely hypoallergenic and biocompatible. This means it is entirely free from nickel and other common irritants, making it perfectly safe for even the most sensitive skin without causing redness or green discoloration.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I Wear The Jewellery Daily?",
            "answer": "<p>Yes! In fact, it is designed for it. Titanium is incredibly lightweight yet remarkably strong. You will barely feel it on your skin, making it the perfect, comfortable choice for everyday, all-day wear.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is The Jewellery Waterproof?",
            "answer": "<p>Yes, our titanium jewellery is 100% waterproof and tarnish-resistant. You can confidently wear it while showering, swimming, or working out without worrying about it rusting, fading, or losing its color.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Will The Jewellery Lose Its Shine Over Time?",
            "answer": "<p>Titanium is highly durable and resistant to scratches and fading. While all metals can naturally show minor wear over decades, titanium maintains its premium finish and beautiful shine far longer than traditional metals like silver or brass.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How Should I Care For My Jewellery?",
            "answer": "<p>Caring for your titanium jewellery is effortless. Simply wash it occasionally with warm water and a mild soap, then gently pat it dry with a soft cloth. Avoid using harsh chemicals or abrasive cleaners to keep it looking brand new.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
