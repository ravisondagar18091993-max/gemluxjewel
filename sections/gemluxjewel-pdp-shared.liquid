{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-product.css' | asset_url | stylesheet_tag }}

{%- assign promo_cards = section.blocks | where: 'type', 'promo_card' -%}

<section class="gemluxjewel gemluxjewel-pdp-shared">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'intro_banner' -%}
        <div class="gemluxjewel-pdp-shared__intro" {{ block.shopify_attributes }}>
          <div class="gemluxjewel-container">
            <div class="gemluxjewel-section-header gemluxjewel-section-header--center gemluxjewel-pdp-shared__intro-header">
              {%- if block.settings.prefix != blank -%}
                <p class="gemluxjewel-prefix">{{ block.settings.prefix | escape }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h2 class="gemluxjewel-section-title">{{ block.settings.title | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="gemluxjewel-section-desc rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>
        </div>
    {%- endcase -%}
  {%- endfor -%}

  {%- if promo_cards.size > 0 -%}
    <div class="gemluxjewel-pdp-shared__cards">
      <div class="gemluxjewel-container">
        <div class="gemluxjewel-dual-cards__grid">
          {%- for block in promo_cards -%}
            {% render 'gemluxjewel-dual-card',
              image: block.settings.image,
              title: block.settings.title,
              button_label: block.settings.button_label,
              button_link: block.settings.button_link,
              seed: forloop.index,
              shopify_attributes: block.shopify_attributes
            %}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "gemluxjewel PDP Shared",
  "tag": "section",
  "class": "gemluxjewel-section",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "intro_banner",
      "name": "Intro banner",
      "settings": [
        {
          "type": "text",
          "id": "prefix",
          "label": "Prefix",
          "default": "Discover More"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Quality Features & Why"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Every piece is thoughtfully designed and expertly crafted to deliver lasting beauty, comfort, and confidence — from premium materials to the finest finishing details.</p>"
        }
      ]
    },
    {
      "type": "promo_card",
      "name": "Promo card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Materials"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel PDP Shared",
      "blocks": [
        { "type": "intro_banner" },
        {
          "type": "promo_card",
          "settings": {
            "title": "Premium Materials",
            "button_label": "Shop Now",
            "button_link": "shopify://collections/all"
          }
        },
        {
          "type": "promo_card",
          "settings": {
            "title": "Certified Quality",
            "button_label": "Shop Now",
            "button_link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
