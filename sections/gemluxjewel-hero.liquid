{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gemluxjewel-home.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign media_type = section.settings.media_type | default: 'image'
  assign hero_video = section.settings.video
  assign hero_image = section.settings.image
  assign hero_poster = section.settings.video_poster | default: hero_image
  if hero_poster != blank
    assign hero_poster_url = hero_poster | image_url: width: 1920
  endif
-%}

<section class="gemluxjewel gemluxjewel-hero">
  <div class="gemluxjewel-hero__media-wrap" aria-hidden="true">
    {%- if media_type == 'video' and hero_video != blank -%}
      {{
        hero_video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'gemluxjewel-hero__media',
          image_size: '3840x',
          preload: 'auto',
          poster: hero_poster_url
      }}
    {%- elsif hero_image != blank -%}
      {{
        hero_image
        | image_url: width: 3840
        | image_tag:
          widths: '750, 1100, 1500, 2000, 3840',
          sizes: '100vw',
          class: 'gemluxjewel-hero__media',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.title
      }}
    {%- else -%}
      {% render 'gemluxjewel-theme-image',
        use_store_media: true,
        seed: 1,
        width: 1920,
        widths: '750,1100,1500,1920',
        sizes: '100vw',
        class: 'gemluxjewel-hero__media',
        loading: 'eager',
        fetchpriority: 'high'
      %}
    {%- endif -%}
    <div class="gemluxjewel-hero__overlay"></div>
  </div>

  <div class="gemluxjewel-hero__content">
    <div class="gemluxjewel-hero__content-inner">
      {%- if section.settings.prefix != blank -%}
        <p class="gemluxjewel-hero__prefix">{{ section.settings.prefix | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h1 class="gemluxjewel-hero__title">{{ section.settings.title | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="gemluxjewel-hero__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <div class="gemluxjewel-hero__actions">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link | default: routes.collections_url }}" class="gemluxjewel-hero__btn gemluxjewel-hero__btn--primary">
            {{ section.settings.button_1_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link | default: routes.root_url }}" class="gemluxjewel-hero__btn gemluxjewel-hero__btn--secondary">
            {{ section.settings.button_2_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="gemluxjewel-hero__bottom-bar" aria-hidden="true"></div>
</section>

{% schema %}
{
  "name": "gemluxjewel Hero",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "settings": [
    {
      "type": "header",
      "content": "Background media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Background media type",
      "default": "image",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Used as the background when Image is selected. Also used as fallback or poster when Video is selected."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Hero video",
      "info": "Upload an MP4 from Shopify Files.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video poster image (optional)",
      "info": "Cover image before video plays. Uses hero image if left blank.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "prefix",
      "label": "Eyebrow text",
      "default": "Engagement Rings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "A Shift in Perspective"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subheading",
      "default": "East-West rings redefining modern bridal styling."
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Label",
      "default": "Discover East-West Rings"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Label",
      "default": "Book an Appointment"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Hero"
    }
  ]
}
{% endschema %}
