{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-dual-cards">
  <div class="gemluxjewel-container">
    {%- if section.blocks.size > 0 -%}
      <div class="gemluxjewel-dual-cards__grid">
        {%- for block in section.blocks -%}
          {% render 'gemluxjewel-dual-card',
            image: block.settings.image,
            title: block.settings.title,
            button_label: block.settings.button_label,
            button_link: block.settings.button_link,
            seed: forloop.index,
            shopify_attributes: block.shopify_attributes
          %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "gemluxjewel Dual Cards",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "max_blocks": 2,
  "settings": [],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Diamond Collection"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Dual Cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Engagement Rings",
            "button_label": "Shop Now",
            "button_link": "shopify://collections/all"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Diamond Pendants",
            "button_label": "Shop Now",
            "button_link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
