{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-shop.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign featured = section.settings.featured_article
  if featured == blank and blog.articles.size > 0
    assign featured = blog.articles.first
  endif

  assign page_number = 1
  if canonical_url contains '?page='
    assign page_query = canonical_url | split: '?page=' | last | split: '&' | first | plus: 0
    if page_query > 0
      assign page_number = page_query
    endif
  endif

  assign show_hero = false
  if featured != blank and page_number == 1
    assign show_hero = true
  endif
-%}

{%- if show_hero and featured != blank -%}
  <section class="gemluxjewel gemluxjewel-blog-hero">
    <div class="gemluxjewel-container">
      <div class="gemluxjewel-blog-hero__grid{% if featured.image == blank and section.settings.image == blank %} gemluxjewel-blog-hero__grid--no-image{% endif %}">
        <div class="gemluxjewel-blog-hero__content">
          <p class="gemluxjewel-blog-hero__date">
            {{ featured.published_at | default: featured.created_at | date: '%d %b, %Y' | upcase }}
          </p>
          <h1 class="gemluxjewel-blog-hero__title">{{ featured.title | escape }}</h1>
          <div class="gemluxjewel-blog-hero__desc">
            {%- if featured.excerpt != blank -%}
              {{ featured.excerpt | strip_html | truncate: 220 }}
            {%- else -%}
              {{ featured.content | strip_html | truncate: 220 }}
            {%- endif -%}
          </div>
          {%- assign hero_btn_url = section.settings.button_link -%}
          {%- if hero_btn_url == blank -%}
            {%- assign hero_btn_url = featured.url -%}
          {%- endif -%}
          {% render 'gemluxjewel-btn', label: section.settings.button_label, url: hero_btn_url, style: 'pink' %}
        </div>
        {%- if featured.image != blank -%}
          <div class="gemluxjewel-blog-hero__media">
            <div class="gemluxjewel-blog-hero__img">
              {{
                featured.image
                | image_url: width: 1036
                | image_tag: widths: '400, 600, 800, 1036', sizes: '(min-width: 990px) 518px, 100vw', loading: 'eager', alt: featured.title
              }}
            </div>
          </div>
        {%- elsif section.settings.image != blank -%}
          <div class="gemluxjewel-blog-hero__media">
            <div class="gemluxjewel-blog-hero__img">
              {{
                section.settings.image
                | image_url: width: 1036
                | image_tag: widths: '400, 600, 800, 1036', sizes: '(min-width: 990px) 518px, 100vw', loading: 'eager', alt: featured.title
              }}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Gemlux Blog Hero",
  "tag": "section",
  "class": "gemluxjewel-section",
  "settings": [
    {
      "type": "article",
      "id": "featured_article",
      "label": "Featured article"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image",
      "info": "Used when the featured article has no image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to the featured article URL"
    }
  ]
}
{% endschema %}
