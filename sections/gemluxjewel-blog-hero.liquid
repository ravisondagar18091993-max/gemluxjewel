{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign page_prefix = section.settings.prefix
  if page_prefix == blank
    assign page_prefix = blog.title
  endif

  assign page_title = section.settings.title
  if page_title == blank
    assign page_title = blog.title
  endif
-%}

<section class="gemluxjewel gemluxjewel-blog-page-hero">
  <div class="gemluxjewel-container">
    {%- if page_prefix != blank -%}
      <p class="gemluxjewel-blog-page-hero__prefix">{{ page_prefix | escape }}</p>
    {%- endif -%}
    <h1 class="gemluxjewel-blog-page-hero__title">{{ page_title | escape }}</h1>
  </div>
</section>

{% schema %}
{
  "name": "Gemlux Blog Header",
  "tag": "section",
  "class": "gemluxjewel-section",
  "settings": [
    {
      "type": "text",
      "id": "prefix",
      "label": "Prefix label",
      "info": "Defaults to blog title (e.g. Education)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Page heading",
      "default": "Lab-Grown Diamond Guidance",
      "info": "Defaults to blog title if empty"
    }
  ]
}
{% endschema %}
