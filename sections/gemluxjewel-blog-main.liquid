{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-blog.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gemluxjewel-blog.js' | asset_url }}" defer="defer"></script>

{%- paginate blog.articles by section.settings.articles_per_page -%}
  <section class="gemluxjewel gemluxjewel-blog">
    <div class="gemluxjewel-container">
      {%- if section.settings.show_filters -%}
        <div class="gemluxjewel-blog__filters" data-gemluxjewel-blog-filters>
          <button type="button" class="gemluxjewel-blog__filter is-active" data-filter="all">
            {{ section.settings.all_posts_label | default: 'All Posts' | escape }}
          </button>
          {%- if blog.all_tags.size > 0 -%}
            {%- for tag in blog.all_tags -%}
              <button type="button" class="gemluxjewel-blog__filter" data-filter="{{ tag | handleize }}">
                {{ tag | escape }}
              </button>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'filter' -%}
                <button type="button" class="gemluxjewel-blog__filter" data-filter="{{ block.settings.tag_handle | default: block.settings.label | handleize }}" {{ block.shopify_attributes }}>
                  {{ block.settings.label | escape }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if blog.articles.size == 0 -%}
        <p class="gemluxjewel-blog__empty">{{ 'blogs.article.no_articles' | t | default: 'No articles yet.' }}</p>
      {%- else -%}
        <div class="gemluxjewel-blog__grid" data-gemluxjewel-blog-grid>
          {%- for article in blog.articles -%}
            {% render 'gemluxjewel-blog-card', article: article %}
          {%- endfor -%}
        </div>
        {% render 'gemluxjewel-pagination', paginate: paginate %}
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Gemlux Blog List",
  "tag": "section",
  "class": "gemluxjewel-section",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "Articles per page"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show tag filters",
      "default": true
    },
    {
      "type": "text",
      "id": "all_posts_label",
      "label": "All posts label",
      "default": "All Posts"
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filter tag",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Materials"
        },
        {
          "type": "text",
          "id": "tag_handle",
          "label": "Tag handle",
          "info": "Must match article tag handle (e.g. everyday-wear)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gemlux Blog List",
      "blocks": [
        { "type": "filter", "settings": { "label": "Materials", "tag_handle": "materials" } },
        { "type": "filter", "settings": { "label": "Everyday Wear", "tag_handle": "everyday-wear" } },
        { "type": "filter", "settings": { "label": "Skin Problems", "tag_handle": "skin-problems" } },
        { "type": "filter", "settings": { "label": "Jewellery Care", "tag_handle": "jewellery-care" } }
      ]
    }
  ]
}
{% endschema %}
