{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-blog.css' | asset_url | stylesheet_tag }}

{%- paginate blog.articles by section.settings.articles_per_page -%}
  <section class="gemluxjewel gemluxjewel-blog">
    <div class="gemluxjewel-container">
      {%- if blog.articles.size == 0 -%}
        <p class="gemluxjewel-blog__empty">{{ 'blogs.article.no_articles' | t | default: 'No articles yet.' }}</p>
      {%- else -%}
        <div class="gemluxjewel-blog__grid">
          {%- for article in blog.articles -%}
            {% render 'gemluxjewel-blog-card', article: article, card_style: 'education' %}
          {%- endfor -%}
        </div>
        {% render 'gemluxjewel-pagination', paginate: paginate %}
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Gemlux Blog List",
  "tag": "section",
  "class": "gemluxjewel-section",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12,
      "label": "Articles per page"
    }
  ],
  "presets": [
    {
      "name": "Gemlux Blog List"
    }
  ]
}
{% endschema %}
