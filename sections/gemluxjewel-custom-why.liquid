{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-custom-jewellery.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-custom-why">
  <div class="gemluxjewel-container">
    {%- if section.settings.title != blank -%}
      <h2 class="gemluxjewel-custom-why__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.content != blank -%}
      <div class="gemluxjewel-custom-why__content rte">
        {{ section.settings.content }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GL Custom Why",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why to Buy Custom Engagement Ring?"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>A custom engagement ring lets you choose every detail — from the diamond shape and carat weight to the metal and setting — so the final piece reflects your story. Our lab grown diamonds offer exceptional beauty and value, with expert guidance at every step.</p>"
    }
  ],
  "presets": [{ "name": "GL Custom Why" }]
}
{% endschema %}
