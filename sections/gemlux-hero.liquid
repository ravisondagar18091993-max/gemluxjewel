{{ 'section-gemlux.css' | asset_url | stylesheet_tag }}

<section class="gemlux gemlux-hero">
  <div class="gemlux-hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: image_size: '1920x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 3840 | image_tag: widths: '750, 1100, 1500, 2000, 3840', sizes: '100vw', fetchpriority: 'high' }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="gemlux-hero__overlay"></div>
  <div class="gemlux-hero__inner">
    <div class="gemlux-hero__content">
      {%- if section.settings.title != blank -%}
        <h1 class="gemlux-hero__title">{{ section.settings.title }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="gemlux-hero__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="gemlux__btn gemlux__btn--green">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
  {%- assign float_product = section.settings.featured_product -%}
  {%- if float_product != blank -%}
    <a href="{{ float_product.url }}" class="gemlux-hero__float-card">
      {%- if float_product.featured_media -%}
        {{ float_product.featured_media | image_url: width: 120 | image_tag: width: 80, height: 80 }}
      {%- endif -%}
      <div>
        <p class="gemlux-hero__float-card-title">{{ float_product.title | escape }}</p>
        <p class="gemlux-hero__float-card-price">{{ float_product.price | money }}</p>
      </div>
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Gemlux Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "video", "id": "video", "label": "Background video", "info": "Overrides image" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Gentle on Your Skin, Perfect for Daily Wear" },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Discover handcrafted jewellery designed for everyday elegance. Hypoallergenic, lightweight, and beautifully made." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop All" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "product", "id": "featured_product", "label": "Floating product card" }
  ],
  "presets": [{ "name": "Gemlux Hero" }]
}
{% endschema %}
