{{ 'section-home.css' | asset_url | stylesheet_tag }}

<section class="home-section home-dual-images">
  {%- if section.settings.title != blank -%}
    <h2 class="home-dual-images__heading">{{ section.settings.title }}</h2>
  {%- endif -%}
  <div class="home-dual-images__grid">
    {%- for block in section.blocks -%}
      <div class="home-dual-images__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">
        {%- endif -%}
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 1500
            | image_tag:
              widths: '550, 750, 1100, 1500',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'hero-apparel-' | append: forloop.index | placeholder_svg_tag }}
        {%- endif -%}
        {%- if block.settings.label != blank -%}
          <span class="home-dual-images__label">{{ block.settings.label | escape }}</span>
        {%- endif -%}
        {%- if block.settings.link != blank -%}
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Home Dual Images",
  "tag": "section",
  "class": "section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Men's"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Dual Images",
      "blocks": [
        { "type": "image", "settings": { "label": "Groom" } },
        { "type": "image", "settings": { "label": "Lifestyle" } }
      ]
    }
  ]
}
{% endschema %}
