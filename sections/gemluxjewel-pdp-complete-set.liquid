<script src="{{ 'gemluxjewel-collection-slider.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.show_complete_set -%}
  {% render 'gemluxjewel-pdp-complete-set', product: product, section: section %}
{%- endif -%}

{% schema %}
{
  "name": "PDP Complete Set",
  "tag": "section",
  "class": "gemluxjewel-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add products per item in Admin → Products → Metafields → Complete The Set."
    },
    {
      "type": "checkbox",
      "id": "show_complete_set",
      "label": "Show Complete The Set carousel",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "complete_set_use_recommendations_fallback",
      "label": "Use Shopify recommendations when metafield is empty",
      "default": true
    },
    {
      "type": "text",
      "id": "complete_set_heading",
      "label": "Heading",
      "default": "Complete The Set"
    },
    {
      "type": "range",
      "id": "complete_set_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    }
  ],
  "presets": [{ "name": "PDP Complete Set" }]
}
{% endschema %}
