{{ 'section-dirona-home.css' | asset_url | stylesheet_tag }}

<section class="dirona dirona-marquee-strip">
  <div class="dirona-marquee-strip__track">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <div class="dirona-marquee-strip__item" {{ block.shopify_attributes }}>
          {{ block.settings.text | escape }}
          <span class="dirona-marquee-strip__star">
            <img src="{{ 'star.svg' | asset_url }}" alt="" width="50" height="50">
          </span>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Dirona Marquee Strip",
  "tag": "section",
  "class": "section dirona-section",
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Timeless Style" }]
    }
  ],
  "presets": [
    {
      "name": "Dirona Marquee Strip",
      "blocks": [
        { "type": "text", "settings": { "text": "Timeless Style" } },
        { "type": "text", "settings": { "text": "Cold Shield" } },
        { "type": "text", "settings": { "text": "Smart Insulation" } },
        { "type": "text", "settings": { "text": "Winter Comfort" } }
      ]
    }
  ]
}
{% endschema %}
