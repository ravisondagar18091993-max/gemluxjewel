{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-product.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-custom-jewellery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gemluxjewel-custom-jewellery.js' | asset_url }}" defer="defer"></script>

<section class="gemluxjewel gemluxjewel-custom-faq" data-gemluxjewel-custom-faq>
  <div class="gemluxjewel-container">
    {%- if section.settings.title != blank -%}
      <h2 class="gemluxjewel-custom-faq__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="gemluxjewel-custom-faq__accordion">
        <div class="closet-accordion" data-gemluxjewel-accordion>
          {%- for block in section.blocks -%}
            <div
              class="closet-item gemluxjewel-custom-faq__item"
              data-gemluxjewel-custom-faq-item
              data-category="{{ block.settings.category | default: 'general' }}"
              {{ block.shopify_attributes }}
            >
              <div class="closet-header" role="button" tabindex="0" aria-expanded="false">
                <div class="closet-header-title">{{ block.settings.question | escape }}</div>
                <span class="accordion-close" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" focusable="false">
                    <path d="M2 4.5 6 8.5 10 4.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
              <div class="closet-content" hidden>
                <div class="closet-content__inner rte">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GL Custom FAQ",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "max_blocks": 30,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Because It Means More When It's Made Just For You!"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "default": "general",
          "options": [
            { "value": "product", "label": "Product" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "returns", "label": "Returns" },
            { "value": "general", "label": "General" }
          ]
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is custom jewelry?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Custom jewelry is designed and crafted specifically for you, based on your preferences for metal, stone, shape, and setting style.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GL Custom FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "What is custom jewelry?",
            "answer": "<p>Custom jewelry is designed and crafted specifically for you, based on your preferences for metal, stone, shape, and setting style.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How is custom jewelry made at Gemlux?",
            "answer": "<p>Our team guides you from initial consultation through 3D design, stone selection, and handcrafting in our studio.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How much does it cost to get a custom design?",
            "answer": "<p>Pricing depends on metal, stone size, and complexity. Share your budget in the form above and we will recommend options within your range.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
