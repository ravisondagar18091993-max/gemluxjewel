{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-engagement-ring.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-engagement gemluxjewel-engagement-trust">
  <div class="gemluxjewel-container">
    {%- if section.settings.prefix != blank -%}
      <p class="gemluxjewel-engagement-trust__prefix">{{ section.settings.prefix | escape }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="gemluxjewel-engagement-trust__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    <ul class="gemluxjewel-engagement-trust__list">
      {%- for i in (1..6) -%}
        {%- liquid
          assign label_key = 'label_' | append: i
          assign icon_key = 'icon_' | append: i
          assign item_label = section.settings[label_key]
          assign item_icon = section.settings[icon_key]
        -%}
        {%- if item_label != blank -%}
          <li class="gemluxjewel-engagement-trust__item">
            <span class="gemluxjewel-engagement-trust__icon">
              {%- if item_icon != blank -%}
                {{
                  item_icon
                  | image_url: width: 80
                  | image_tag: widths: '40, 80', sizes: '28px', loading: 'lazy', alt: '', class: 'gemluxjewel-engagement-trust__icon-img'
                }}
              {%- else -%}
                <img src="{{ 'diamond.svg' | asset_url }}" alt="" width="28" height="28">
              {%- endif -%}
            </span>
            <span class="gemluxjewel-engagement-trust__label">{{ item_label | escape }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "GL Engagement Trust",
  "tag": "section",
  "class": "gemluxjewel-section",
  "settings": [
    {
      "type": "text",
      "id": "prefix",
      "label": "Prefix",
      "default": "Gemluxjewel Promise"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "You Should Know Before You Buy"
    },
    { "type": "text", "id": "label_1", "label": "Item 1", "default": "Free Shipping Worldwide" },
    { "type": "image_picker", "id": "icon_1", "label": "Icon 1" },
    { "type": "text", "id": "label_2", "label": "Item 2", "default": "24/7 Customer Service" },
    { "type": "image_picker", "id": "icon_2", "label": "Icon 2" },
    { "type": "text", "id": "label_3", "label": "Item 3", "default": "100% Money Back Guarantee" },
    { "type": "image_picker", "id": "icon_3", "label": "Icon 3" },
    { "type": "text", "id": "label_4", "label": "Item 4", "default": "Certified Quality" },
    { "type": "image_picker", "id": "icon_4", "label": "Icon 4" },
    { "type": "text", "id": "label_5", "label": "Item 5", "default": "Unbeatable Value" },
    { "type": "image_picker", "id": "icon_5", "label": "Icon 5" },
    { "type": "text", "id": "label_6", "label": "Item 6", "default": "Eco Friendly" },
    { "type": "image_picker", "id": "icon_6", "label": "Icon 6" }
  ],
  "presets": [{ "name": "GL Engagement Trust" }]
}
{% endschema %}
