        { "value": "support", "label": "Customer service" },
        { "value": "guarantee", "label": "Guarantee" },
        { "value": "certified", "label": "Certified quality" },
        { "value": "value", "label": "Value" },
        { "value": "eco", "label": "Eco friendly" }
      ]
    },
    { "type": "image_picker", "id": "icon_image_1", "label": "Custom icon 1 (optional)" },
