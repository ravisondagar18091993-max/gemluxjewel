{{ 'section-home.css' | asset_url | stylesheet_tag }}

<section class="home-section home-testimonials">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="home-section__heading">{{ section.settings.title }}</h2>
    {%- endif -%}
    <ul class="home-testimonials__grid">
      {%- for block in section.blocks -%}
        <li class="home-testimonials__item" {{ block.shopify_attributes }}>
          <div class="home-testimonials__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
          </div>
          {%- if block.settings.text != blank -%}
            <p class="home-testimonials__text">"{{ block.settings.text | escape }}"</p>
          {%- endif -%}
          {%- if block.settings.author != blank -%}
            <p class="home-testimonials__author">— {{ block.settings.author | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Home Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What Our Customers Say"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star rating"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "Absolutely stunning craftsmanship. The ring exceeded all my expectations."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "text": "The most beautiful engagement ring. Exceptional quality and service.",
            "author": "Sarah M."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "text": "Stunning pieces that feel truly bespoke. Will definitely return.",
            "author": "James T."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "text": "Elegant, timeless jewellery. The packaging alone feels luxurious.",
            "author": "Emma L."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "text": "Perfect gift for my wife. She hasn't taken the necklace off since.",
            "author": "David R."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "text": "Outstanding customer care from start to finish. Highly recommend.",
            "author": "Priya K."
          }
        }
      ]
    }
  ]
}
{% endschema %}
