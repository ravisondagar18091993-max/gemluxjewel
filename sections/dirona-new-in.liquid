{{ 'section-dirona-home.css' | asset_url | stylesheet_tag }}

{%- assign collection = section.settings.collection -%}

<section class="dirona dirona-new-in">
  <div class="dirona-container">
    <div class="dirona-new-in__grid">
      <div class="dirona-new-in__banner">
        {%- if section.settings.banner_image != blank -%}
          {{ section.settings.banner_image | image_url: width: 1200 | image_tag: widths: '600, 800, 1200', sizes: '(min-width: 1200px) 50vw, 100vw', loading: 'lazy' }}
        {%- else -%}
          <img src="{{ 'newin-left-img.png' | asset_url }}" alt="" width="800" height="958" loading="lazy">
        {%- endif -%}
        <div class="dirona-new-in__banner-content">
          {%- if section.settings.prefix != blank -%}
            <p class="dirona-prefix">{{ section.settings.prefix }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="dirona-section-title">{{ section.settings.title }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="dirona-section-desc" style="color:#fff;margin-bottom:24px;">{{ section.settings.text }}</p>
          {%- endif -%}
          {% render 'dirona-btn', label: section.settings.button_label, url: section.settings.button_link, style: 'green' %}
        </div>
      </div>
      <div class="dirona-new-in__products">
        {%- if collection != blank -%}
          {%- for product in collection.products limit: 4 -%}
            {% render 'dirona-product-card', product: product, badge_text: 'New In', show_discount: true %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            {% render 'dirona-product-card', product: blank, badge_text: 'New In', show_discount: true %}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dirona New In",
  "tag": "section",
  "class": "section dirona-section",
  "settings": [
    { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
    { "type": "text", "id": "prefix", "label": "Prefix", "default": "Just Arrived" },
    { "type": "text", "id": "title", "label": "Heading", "default": "New In" },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Discover our latest additions - fresh designs and timeless classics newly available" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View Collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "collection", "id": "collection", "label": "Collection" }
  ],
  "presets": [{ "name": "Dirona New In" }]
}
{% endschema %}
