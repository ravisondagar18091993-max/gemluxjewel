{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign source_collection = section.settings.collection
  if source_collection == blank
    assign source_collection = collections.all
  endif

  assign sort_key = section.settings.sort_by | default: 'created_at'
  assign products_limit = section.settings.products_to_show | default: 4
  assign new_within_days = section.settings.new_within_days | default: 0
  assign badge_label = section.settings.badge_text | default: 'New In'
  assign shown_count = 0

  if new_within_days > 0
    assign seconds_cutoff = new_within_days | times: 86400
    assign now_seconds = 'now' | date: '%s' | plus: 0
    assign cutoff_seconds = now_seconds | minus: seconds_cutoff
  endif
-%}

<section class="gemluxjewel gemluxjewel-products gemluxjewel-new-in-products">
  <div class="gemluxjewel-container">
    <div class="gemluxjewel-section-header">
      <div>
        {%- if section.settings.title != blank -%}
          <h2 class="gemluxjewel-section-title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="gemluxjewel-section-desc">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        {% render 'gemluxjewel-btn',
          label: section.settings.button_label,
          url: section.settings.button_link,
          style: 'green'
        %}
      {%- endif -%}
    </div>

    <div class="gemluxjewel-products__grid">
      {%- paginate source_collection.products by 250 -%}
        {%- assign sorted_products = source_collection.products | sort: sort_key | reverse -%}
        {%- if sorted_products.size > 0 -%}
          {%- for product in sorted_products -%}
            {%- if shown_count >= products_limit -%}
              {%- break -%}
            {%- endif -%}

            {%- liquid
              assign show_product = true

              if new_within_days > 0
                assign product_seconds = product.created_at | date: '%s' | plus: 0
                if product_seconds < cutoff_seconds
                  assign show_product = false
                endif
              endif
            -%}

            {%- if show_product -%}
              {% render 'gemluxjewel-product-card',
                product: product,
                badge_text: badge_label,
                show_discount: true
              %}
              {%- assign shown_count = shown_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..products_limit) -%}
            {% render 'gemluxjewel-product-card', product: blank, badge_text: badge_label, show_discount: true %}
          {%- endfor -%}
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "gemluxjewel New In",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "New In"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Shop the latest additions — newly added pieces sorted by date."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Product badge",
      "default": "New In"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products are pulled from this collection. Leave empty to use all products."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "select",
      "id": "sort_by",
      "label": "Sort by",
      "default": "created_at",
      "options": [
        { "value": "created_at", "label": "Date added (newest first)" },
        { "value": "published_at", "label": "Date published (newest first)" }
      ]
    },
    {
      "type": "range",
      "id": "new_within_days",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 0,
      "unit": "d",
      "label": "Only show products added within",
      "info": "Set to 0 to show the newest products regardless of date."
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel New In",
      "settings": {
        "title": "New In",
        "subtitle": "Shop the latest additions — newly added pieces sorted by date.",
        "button_label": "View Collection",
        "button_link": "shopify://collections/all",
        "badge_text": "New In",
        "products_to_show": 4,
        "sort_by": "created_at",
        "new_within_days": 0
      }
    }
  ]
}
{% endschema %}
