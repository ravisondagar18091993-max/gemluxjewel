{{ 'section-home.css' | asset_url | stylesheet_tag }}

<section class="home-section home-lifestyle-grid-section">
  <div class="home-lifestyle-grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign size_class = ''
        if block.settings.size == 'large'
          assign size_class = ' home-lifestyle-grid__item--large'
        endif
      -%}
      <div class="home-lifestyle-grid__item{{ size_class }}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="home-lifestyle-grid__link">
        {%- endif -%}
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 1500
            | image_tag:
              widths: '375, 550, 750, 1100, 1500',
              sizes: '(min-width: 750px) 33vw, 50vw',
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'detailed-apparel-' | append: forloop.index | placeholder_svg_tag }}
        {%- endif -%}
        {%- if block.settings.link != blank -%}
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Home Lifestyle Grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "normal", "label": "Normal" },
            { "value": "large", "label": "Large (tall)" }
          ],
          "default": "normal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Lifestyle Grid",
      "blocks": [
        { "type": "image", "settings": { "size": "large" } },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
