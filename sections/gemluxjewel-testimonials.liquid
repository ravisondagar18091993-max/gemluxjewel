{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gemluxjewel-testimonials.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign trustpilot_reviews_url = section.settings.trustpilot_reviews_url | default: 'https://www.trustpilot.com/review/gemluxjewels.com'
  assign trustpilot_write_url = section.settings.trustpilot_write_url | default: 'https://www.trustpilot.com/evaluate/gemluxjewels.com'
  assign avatar_colors = '#2d6a6a,#8b7355,#c4899a,#5a7a52,#4a6fa5,#9b6b8a' | split: ','
-%}

<section class="gemluxjewel gemluxjewel-testimonials">
  <div class="gemluxjewel-container">
    <div class="gemluxjewel-testimonials__header">
      {%- if section.settings.title != blank -%}
        <h2 class="gemluxjewel-testimonials__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="gemluxjewel-testimonials__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="gemluxjewel-testimonials__slider" data-gemluxjewel-testimonials-slider>
      <div class="gemluxjewel-testimonials__viewport">
        <div class="gemluxjewel-testimonials__track" data-gemluxjewel-testimonials-track>
          {%- if section.settings.show_summary -%}
            <article class="gemluxjewel-testimonials__card gemluxjewel-testimonials__card--summary">
              <div class="gemluxjewel-testimonials__summary-logos">
                {% render 'gemluxjewel-review-platform-logo', platform: 'google' %}
                {% render 'gemluxjewel-review-platform-logo', platform: 'trustpilot' %}
              </div>

              <div class="gemluxjewel-testimonials__summary-rating">
                {%- if section.settings.average_rating != blank -%}
                  <span class="gemluxjewel-testimonials__score">{{ section.settings.average_rating | escape }}</span>
                {%- endif -%}
                <div class="gemluxjewel-testimonials__stars gemluxjewel-testimonials__stars--gold" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    <span class="gemluxjewel-testimonials__star">&#9733;</span>
                  {%- endfor -%}
                </div>
              </div>

              {%- if section.settings.review_count != blank -%}
                <p class="gemluxjewel-testimonials__count">{{ section.settings.review_count | escape }}</p>
              {%- endif -%}

              <div class="gemluxjewel-testimonials__summary-actions">
                <a href="{{ trustpilot_write_url }}" class="gemluxjewel-testimonials__action-btn" target="_blank" rel="noopener noreferrer">
                  {{ section.settings.write_review_label | default: 'Write a Review' | escape }}
                </a>
                <a href="{{ trustpilot_reviews_url }}" class="gemluxjewel-testimonials__action-btn" target="_blank" rel="noopener noreferrer">
                  {{ section.settings.read_reviews_label | default: 'Read Our Reviews' | escape }}
                </a>
              </div>
            </article>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              {%- assign color_index = forloop.index0 | modulo: avatar_colors.size -%}
              {% render 'gemluxjewel-testimonial-card',
                platform: block.settings.platform,
                author: block.settings.author,
                rating: block.settings.rating,
                time_ago: block.settings.time_ago,
                text: block.settings.text,
                review_url: block.settings.review_url | default: trustpilot_reviews_url,
                avatar_color: avatar_colors[color_index],
                shopify_attributes: block.shopify_attributes
              %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <button
        type="button"
        class="gemluxjewel-testimonials__nav gemluxjewel-testimonials__nav--prev"
        data-gemluxjewel-testimonials-prev
        aria-label="Previous reviews"
        disabled
      >
        <span class="gemluxjewel-testimonials__nav-icon" aria-hidden="true">&lsaquo;</span>
      </button>

      <button
        type="button"
        class="gemluxjewel-testimonials__nav gemluxjewel-testimonials__nav--next"
        data-gemluxjewel-testimonials-next
        aria-label="Next reviews"
      >
        <span class="gemluxjewel-testimonials__nav-icon" aria-hidden="true">&rsaquo;</span>
      </button>
  </div>
</section>

{% schema %}
{
  "name": "gemluxjewel Testimonials",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What Our Clients Say"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Here's what our clients have to say about their Gemlux experience."
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show rating summary card",
      "default": true
    },
    {
      "type": "text",
      "id": "average_rating",
      "label": "Average rating",
      "default": "5.0"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Total reviews",
      "default": "250+ reviews"
    },
    {
      "type": "text",
      "id": "write_review_label",
      "label": "Write review button label",
      "default": "Write a Review"
    },
    {
      "type": "text",
      "id": "read_reviews_label",
      "label": "Read reviews button label",
      "default": "Read Our Reviews"
    },
    {
      "type": "url",
      "id": "trustpilot_reviews_url",
      "label": "Trustpilot reviews page"
    },
    {
      "type": "url",
      "id": "trustpilot_write_url",
      "label": "Trustpilot write review page"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Review source",
          "default": "trustpilot",
          "options": [
            { "value": "trustpilot", "label": "Trustpilot" },
            { "value": "google", "label": "Google" }
          ]
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Stars"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Reviewer name",
          "default": "Abigail Green"
        },
        {
          "type": "text",
          "id": "time_ago",
          "label": "Time posted",
          "default": "an hour ago"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review",
          "default": "Excellent service and beautiful jewellery. The ring quality exceeded my expectations and delivery was fast."
        },
        {
          "type": "url",
          "id": "review_url",
          "label": "Read more link",
          "info": "Defaults to Trustpilot reviews page"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "platform": "google",
            "author": "Abigail Green",
            "time_ago": "an hour ago",
            "text": "Absolutely stunning ring! The craftsmanship is incredible and it sparkles beautifully. Customer service was helpful throughout."
          }
        },
        {
          "type": "review",
          "settings": {
            "platform": "trustpilot",
            "author": "James Mitchell",
            "time_ago": "2 hours ago",
            "text": "Ordered a lab-grown diamond engagement ring and couldn't be happier. Fast shipping, elegant packaging, and the ring looks even better in person."
          }
        },
        {
          "type": "review",
          "settings": {
            "platform": "google",
            "author": "Sarah Chen",
            "time_ago": "3 hours ago",
            "text": "Great experience from start to finish. The team helped me choose the perfect setting and the quality is outstanding for the price."
          }
        },
        {
          "type": "review",
          "settings": {
            "platform": "trustpilot",
            "author": "Michael Roberts",
            "time_ago": "5 hours ago",
            "text": "My wife loves her new necklace. The diamonds are brilliant and the design is timeless. Will definitely shop here again."
          }
        },
        {
          "type": "review",
          "settings": {
            "platform": "trustpilot",
            "author": "Emma Wilson",
            "time_ago": "a day ago",
            "text": "Beautiful jewellery and transparent pricing. Resizing was quick and the ring fits perfectly now."
          }
        }
      ]
    }
  ]
}
{% endschema %}
