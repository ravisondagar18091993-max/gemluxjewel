{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-testimonials">
  <div class="gemluxjewel-container">
    <div class="gemluxjewel-section-header gemluxjewel-section-header--center">
      <div>
        {%- if section.settings.title != blank -%}
          <h2 class="gemluxjewel-section-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="gemluxjewel-section-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    </div>
    <div class="gemluxjewel-testimonials__grid">
      {%- for block in section.blocks -%}
        <div class="gemluxjewel-testimonials__card" {{ block.shopify_attributes }}>
          <div class="gemluxjewel-testimonials__stars">
            {%- for i in (1..block.settings.rating) -%}
              <img src="{{ 'testimonial-star.svg' | asset_url }}" alt="" width="25" height="25">
            {%- endfor -%}
          </div>
          {%- if block.settings.text != blank -%}
            <p class="gemluxjewel-testimonials__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.author != blank -%}
            <p class="gemluxjewel-testimonials__author">{{ block.settings.author | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "gemluxjewel Testimonials",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Customer Voices" },
    { "type": "textarea", "id": "subtitle", "label": "Subheading", "default": "Real experiences from people who value comfort, quality, and everyday style." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "default": 5, "label": "Stars" },
        { "type": "textarea", "id": "text", "label": "Review", "default": "Really impressed with how lightweight and comfortable the jewellery feels all day." },
        { "type": "text", "id": "author", "label": "Author", "default": "Aarav Mehta – India" }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Testimonials",
      "blocks": [
        { "type": "review", "settings": { "text": "Really impressed with how lightweight and comfortable the jewellery feels all day. No irritation at all.", "author": "Aarav Mehta – India" } },
        { "type": "review", "settings": { "text": "The quality is excellent and it looks even better in person. Been wearing it daily.", "author": "Oliver Smith – United Kingdom" } },
        { "type": "review", "settings": { "text": "Simple, stylish, and perfect for everyday use without any discomfort.", "author": "Ethan Carter – United States" } },
        { "type": "review", "settings": { "text": "Great value for money and the design is exactly what I wanted.", "author": "Sofia Rossi – Italy" } },
        { "type": "review", "settings": { "text": "Fast delivery and beautiful packaging. The jewellery exceeded expectations.", "author": "Yuki Tanaka – Japan" } },
        { "type": "review", "settings": { "text": "My go-to brand for daily wear jewellery. Comfortable and elegant.", "author": "Emma Wilson – Australia" } }
      ]
    }
  ]
}
{% endschema %}
