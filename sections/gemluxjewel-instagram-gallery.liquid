{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-instagram">
  <ul class="gemluxjewel-instagram__grid">
    {%- for block in section.blocks -%}
      <li class="gemluxjewel-instagram__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="gemluxjewel-instagram__link" target="_blank" rel="noopener">
        {%- endif -%}
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', sizes: '(min-width: 750px) 20vw, 50vw', loading: 'lazy' }}
        {%- else -%}
          {% render 'gemluxjewel-theme-image', asset: 'insta-post-img.png', width: 400, widths: '200,300,400', sizes: '(min-width: 768px) 25vw, 50vw' %}
        {%- endif -%}
        {%- if block.settings.link != blank -%}
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Gemlux Instagram",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gemlux Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
