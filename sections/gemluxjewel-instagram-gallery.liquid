{{ 'section-dirona-home.css' | asset_url | stylesheet_tag }}

<section class="dirona dirona-instagram">
  <ul class="dirona-instagram__grid">
    {%- for block in section.blocks -%}
      <li class="dirona-instagram__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="dirona-instagram__link" target="_blank" rel="noopener">
        {%- endif -%}
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', sizes: '(min-width: 750px) 20vw, 50vw', loading: 'lazy' }}
        {%- else -%}
          <img src="{{ 'insta-post-img.png' | asset_url }}" alt="" width="400" height="320" loading="lazy">
        {%- endif -%}
        {%- if block.settings.link != blank -%}
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Dirona Instagram Gallery",
  "tag": "section",
  "class": "section dirona-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dirona Instagram Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
