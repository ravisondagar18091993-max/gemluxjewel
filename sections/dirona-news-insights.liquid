{{ 'section-dirona-home.css' | asset_url | stylesheet_tag }}

{%- assign blog = blogs[section.settings.blog] -%}

<section class="dirona dirona-news">
  <div class="dirona-container">
    <div class="dirona-section-header">
      <div>
        {%- if section.settings.title != blank -%}
          <h2 class="dirona-section-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="dirona-section-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
      {% render 'dirona-btn', label: section.settings.button_label, url: section.settings.button_link | default: blog.url, style: 'green' %}
    </div>
    <div class="dirona-news__grid">
      {%- if blog != blank and blog.articles.size > 0 -%}
        {%- for article in blog.articles limit: section.settings.posts_to_show -%}
          <article class="dirona-news__card">
            <div class="dirona-news__img">
              <a href="{{ article.url }}">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 600 | image_tag: widths: '300, 400, 600', sizes: '(min-width: 1200px) 22vw, 45vw', loading: 'lazy', alt: article.title }}
                {%- else -%}
                  {{ 'hero-apparel-1' | placeholder_svg_tag }}
                {%- endif -%}
              </a>
              {%- if article.tags.size > 0 -%}
                <div class="dirona-card__top">
                  <span class="dirona-badge">{{ article.tags.first }}</span>
                </div>
              {%- endif -%}
            </div>
            <h3 class="dirona-news__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p class="dirona-news__excerpt">{{ article.excerpt | default: article.content | strip_html | truncate: 120 }}</p>
            <a href="{{ article.url }}" class="dirona-news__readmore">
              Read More
              <span class="dirona-btn__arrow">
                <img src="{{ 'green-right-arrow.svg' | asset_url }}" alt="" width="24" height="24">
              </span>
            </a>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <article class="dirona-news__card" {{ block.shopify_attributes }}>
            <div class="dirona-news__img">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
              {%- else -%}
                {{ 'hero-apparel-' | append: forloop.index | placeholder_svg_tag }}
              {%- endif -%}
              {%- if block.settings.tag != blank -%}
                <div class="dirona-card__top"><span class="dirona-badge">{{ block.settings.tag }}</span></div>
              {%- endif -%}
            </div>
            <h3 class="dirona-news__title">{{ block.settings.title | escape }}</h3>
            <p class="dirona-news__excerpt">{{ block.settings.excerpt | escape }}</p>
            <a href="{{ block.settings.link }}" class="dirona-news__readmore">
              Read More
              <span class="dirona-btn__arrow">
                <img src="{{ 'green-right-arrow.svg' | asset_url }}" alt="" width="24" height="24">
              </span>
            </a>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dirona News & Insights",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "News & Insights" },
    { "type": "textarea", "id": "subtitle", "label": "Subheading", "default": "Stay updated with the latest trends, expert tips, and everything you need to know about modern jewellery." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View All Blogs" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "min": 2, "max": 8, "step": 1, "default": 4, "label": "Posts to show" }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Manual article",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Materials" },
        { "type": "text", "id": "title", "label": "Title", "default": "Why Titanium Jewellery is Trending" },
        { "type": "textarea", "id": "excerpt", "label": "Excerpt", "default": "Discover why titanium is becoming the top choice for modern, skin-friendly jewellery lovers" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dirona News & Insights",
      "blocks": [
        { "type": "article", "settings": { "tag": "Materials", "title": "Why Titanium Jewellery is Trending" } },
        { "type": "article", "settings": { "tag": "Everyday Wear", "title": "Why Titanium Jewellery is Trending" } },
        { "type": "article", "settings": { "tag": "Skin Problems", "title": "Why Titanium Jewellery is Trending" } },
        { "type": "article", "settings": { "tag": "Jewellery Care", "title": "Why Titanium Jewellery is Trending" } }
      ]
    }
  ]
}
{% endschema %}
