{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gemluxjewel-collection-slider.js' | asset_url }}" defer="defer"></script>

{%- assign card_image_sizes = '(min-width: 1200px) 320px, (min-width: 750px) 280px, 85vw' -%}

<section class="gemluxjewel gemluxjewel-collection-slider">
  <div class="gemluxjewel-container">
    <div class="gemluxjewel-section-header gemluxjewel-section-header--center">
      <div>
        {%- if section.settings.title != blank -%}
          <h2 class="gemluxjewel-section-title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="gemluxjewel-section-desc">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="gemluxjewel-collection-slider__slider" data-gemluxjewel-collection-slider>
        <div class="gemluxjewel-collection-slider__viewport">
          <div class="gemluxjewel-collection-slider__track" data-gemluxjewel-collection-slider-track>
            {%- for block in section.blocks -%}
              {%- liquid
                assign card_title = block.settings.title
                assign card_collection = block.settings.collection
                assign card_image = block.settings.image
                assign card_url = block.settings.link

                if card_title == blank and card_collection != blank
                  assign card_title = card_collection.title
                endif

                if card_image == blank and card_collection != blank and card_collection.featured_image != blank
                  assign card_image = card_collection.featured_image
                endif

                if card_url == blank and card_collection != blank
                  assign card_url = card_collection.url
                endif
              -%}

              {%- if card_url != blank -%}
                <a href="{{ card_url }}" class="gemluxjewel-collection-slider__item" {{ block.shopify_attributes }}>
              {%- else -%}
                <div class="gemluxjewel-collection-slider__item gemluxjewel-collection-slider__item--static" {{ block.shopify_attributes }}>
              {%- endif -%}
                <div class="gemluxjewel-collection-slider__img">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 900
                      | image_tag:
                        widths: '300, 400, 600, 900',
                        sizes: card_image_sizes,
                        loading: 'lazy',
                        alt: card_title
                    }}
                  {%- else -%}
                    {% render 'gemluxjewel-theme-image',
                      use_store_media: true,
                      seed: forloop.index,
                      width: 600,
                      widths: '300,400,600,900',
                      sizes: card_image_sizes,
                      alt: card_title,
                      class: 'gemluxjewel-collection-slider__fallback'
                    %}
                  {%- endif -%}
                </div>
                {%- if card_title != blank -%}
                  <span class="gemluxjewel-collection-slider__label">
                    {{ card_title | escape }}
                    <span class="gemluxjewel-collection-slider__arrow" aria-hidden="true">&rarr;</span>
                  </span>
                {%- endif -%}
              {%- if card_url != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <button
            type="button"
            class="gemluxjewel-collection-slider__nav gemluxjewel-collection-slider__nav--prev"
            data-gemluxjewel-collection-slider-prev
            aria-label="Previous collections"
            disabled
          >
            <img src="{{ 'down-arrow.svg' | asset_url }}" alt="" width="20" height="20" class="gemluxjewel-collection-slider__nav-icon gemluxjewel-collection-slider__nav-icon--prev">
          </button>

          <button
            type="button"
            class="gemluxjewel-collection-slider__nav gemluxjewel-collection-slider__nav--next"
            data-gemluxjewel-collection-slider-next
            aria-label="Next collections"
          >
            <img src="{{ 'down-arrow.svg' | asset_url }}" alt="" width="20" height="20" class="gemluxjewel-collection-slider__nav-icon">
          </button>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "gemluxjewel Shop Style",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop Lab Diamond Engagement Rings by Style"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Discover our signature setting styles, including solitaire, three stone, halo, toi et moi and bezel."
    }
  ],
  "blocks": [
    {
      "type": "style",
      "name": "Collection card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Solitaire"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Optional. Overrides collection link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Shop Style",
      "blocks": [
        { "type": "style", "settings": { "title": "Solitaire" } },
        { "type": "style", "settings": { "title": "Bezel" } },
        { "type": "style", "settings": { "title": "Toi et Moi" } },
        { "type": "style", "settings": { "title": "Three Stone" } },
        { "type": "style", "settings": { "title": "Halo" } }
      ]
    }
  ]
}
{% endschema %}
