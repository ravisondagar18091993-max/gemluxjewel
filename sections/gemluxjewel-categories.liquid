{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-categories">
  <div class="gemluxjewel-container">
    <div class="gemluxjewel-categories__grid">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        {%- if collection == blank -%}
          {%- continue -%}
        {%- endif -%}

        {%- liquid
          assign card_title = block.settings.title | default: collection.title
          assign collection_image = collection.featured_image
          if collection_image == blank and collection.products_count > 0
            assign collection_image = collection.products.first.featured_image
          endif
        -%}

        <a href="{{ collection.url }}" class="gemluxjewel-categories__item" {{ block.shopify_attributes }}>
          <div class="gemluxjewel-categories__img">
            {%- if collection_image != blank -%}
              {{
                collection_image
                | image_url: width: 600
                | image_tag:
                  widths: '155, 200, 300, 400, 600',
                  sizes: '(min-width: 1200px) 11vw, (min-width: 768px) 30vw, 45vw',
                  loading: 'lazy',
                  alt: card_title
              }}
            {%- else -%}
              {% render 'gemluxjewel-theme-image',
                asset: 'category-img.png',
                width: 400,
                widths: '200,300,400',
                sizes: '(min-width: 1200px) 11vw, (min-width: 768px) 30vw, 45vw',
                alt: card_title
              %}
            {%- endif -%}
          </div>
          <div class="gemluxjewel-categories__title">{{ card_title | escape }}</div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "gemluxjewel Categories",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Pick collections for each card. Title, link, and image come from the collection. Update the collection image in Shopify Admin → Products → Collections."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title (optional)",
          "info": "Leave blank to use the collection title."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
