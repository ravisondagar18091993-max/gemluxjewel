{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-categories">
  <div class="gemluxjewel-container">
    <div class="gemluxjewel-categories__scroll">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="gemluxjewel-categories__item" {{ block.shopify_attributes }}>
          <div class="gemluxjewel-categories__img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: widths: '155, 200, 400', sizes: '200px', loading: 'lazy' }}
            {%- else -%}
              {% render 'gemluxjewel-theme-image', asset: 'category-img.png', width: 400, widths: '200,300,400', sizes: '200px', alt: block.settings.title %}
            {%- endif -%}
          </div>
          <div class="gemluxjewel-categories__title">{{ block.settings.title | escape }}</div>
          <span class="gemluxjewel-categories__link">Explore</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "gemluxjewel Categories",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Earrings" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Earrings" } },
        { "type": "category", "settings": { "title": "Cartilage Hoops" } },
        { "type": "category", "settings": { "title": "Flat Back Studs" } },
        { "type": "category", "settings": { "title": "Huggies" } },
        { "type": "category", "settings": { "title": "Stud Earrings" } },
        { "type": "category", "settings": { "title": "Hoops" } }
      ]
    }
  ]
}
{% endschema %}
