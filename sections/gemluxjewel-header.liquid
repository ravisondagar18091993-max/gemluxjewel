{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gemluxjewel-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign top_links = section.blocks | where: 'type', 'top_link'
  assign highlight_title = section.settings.highlight_link | downcase | strip
  assign logo_label = section.settings.logo_text | default: shop.name
-%}

<header class="gemluxjewel gemluxjewel-header" data-gemluxjewel-header>
  <div class="gemluxjewel-header__top">
    {%- if top_links.size > 0 -%}
      <div
        class="gemluxjewel-header__top-slider{% if top_links.size == 1 %} gemluxjewel-header__top-slider--static{% endif %}"
        data-gemluxjewel-header-slider
        data-interval="{{ section.settings.slider_speed | default: 4 | times: 1000 }}"
      >
        {%- for block in top_links -%}
          <div
            class="gemluxjewel-header__top-slide{% if forloop.first %} is-active{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.url != blank -%}
              <a href="{{ block.settings.url }}" class="gemluxjewel-header__top-link">
                {%- if section.settings.show_announcement_icon -%}
                  <img src="{{ 'header-leaf.svg' | asset_url }}" alt="" class="gemluxjewel-header__top-icon" width="14" height="14">
                {%- endif -%}
                <span>{{ block.settings.label | escape }}</span>
              </a>
            {%- else -%}
              <span class="gemluxjewel-header__top-link">
                {%- if section.settings.show_announcement_icon -%}
                  <img src="{{ 'header-leaf.svg' | asset_url }}" alt="" class="gemluxjewel-header__top-icon" width="14" height="14">
                {%- endif -%}
                <span>{{ block.settings.label | escape }}</span>
              </span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- elsif section.settings.announcement_text != blank -%}
      <div class="gemluxjewel-header__top-slider gemluxjewel-header__top-slider--static">
        <div class="gemluxjewel-header__top-slide is-active">
          {%- if section.settings.announcement_url != blank -%}
            <a href="{{ section.settings.announcement_url }}" class="gemluxjewel-header__top-link">
              {%- if section.settings.show_announcement_icon -%}
                <img src="{{ 'header-leaf.svg' | asset_url }}" alt="" class="gemluxjewel-header__top-icon" width="14" height="14">
              {%- endif -%}
              <span>{{ section.settings.announcement_text | escape }}</span>
            </a>
          {%- else -%}
            <span class="gemluxjewel-header__top-link">
              {%- if section.settings.show_announcement_icon -%}
                <img src="{{ 'header-leaf.svg' | asset_url }}" alt="" class="gemluxjewel-header__top-icon" width="14" height="14">
              {%- endif -%}
              <span>{{ section.settings.announcement_text | escape }}</span>
            </span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="gemluxjewel-header__wrap">
    <div class="gemluxjewel-header__main" data-gemluxjewel-header-main>
      <div class="gemluxjewel-header__inner">
        <div class="gemluxjewel-header__left">
          <nav class="gemluxjewel-header__nav-wrap" aria-label="Main">
            <ul class="gemluxjewel-header__nav gemluxjewel-header__nav--left">
              {%- if section.settings.menu != blank -%}
                {%- for link in section.settings.menu.links -%}
                  <li class="gemluxjewel-header__nav-item{% if link.links.size > 0 %} has-mega{% endif %}">
                    <a href="{{ link.url }}" class="gemluxjewel-header__nav-link{% if link.links.size > 0 %} gemluxjewel-header__nav-link--has-dropdown{% endif %}">
                      <span>{{ link.title | escape }}</span>
                      {%- if link.links.size > 0 -%}
                        <span class="gemluxjewel-header__nav-caret" aria-hidden="true">
                          <svg width="8" height="5" viewBox="0 0 8 5" fill="none">
                            <path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                      {%- endif -%}
                    </a>
                    {%- if link.links.size > 0 -%}
                      {% render 'gemluxjewel-mega-menu', link: link, section: section %}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              {%- else -%}
                <li class="gemluxjewel-header__nav-item"><a href="{{ routes.collections_url }}/all" class="gemluxjewel-header__nav-link">Ready-to-ship</a></li>
                <li class="gemluxjewel-header__nav-item"><a href="{{ routes.collections_url }}/all" class="gemluxjewel-header__nav-link">Engagement</a></li>
                <li class="gemluxjewel-header__nav-item"><a href="{{ routes.collections_url }}/all" class="gemluxjewel-header__nav-link">Wedding</a></li>
                <li class="gemluxjewel-header__nav-item"><a href="{{ routes.collections_url }}/all" class="gemluxjewel-header__nav-link">Fine Jewelry</a></li>
              {%- endif -%}
            </ul>
          </nav>
        </div>

        <a href="{{ routes.root_url }}" class="gemluxjewel-header__logo">{{ logo_label | escape }}</a>

        <div class="gemluxjewel-header__actions">
          <div class="gemluxjewel-header__burger">
            <button type="button" class="gemluxjewel-header__burger-btn" data-gemluxjewel-burger aria-label="Open menu">
              <span class="gemluxjewel-header__burger-line"></span>
              <span class="gemluxjewel-header__burger-line"></span>
              <span class="gemluxjewel-header__burger-line"></span>
            </button>
          </div>

          <div class="gemluxjewel-header__right">
            <nav class="gemluxjewel-header__nav-wrap" aria-label="Secondary">
              <ul class="gemluxjewel-header__nav gemluxjewel-header__nav--right">
                {%- if section.settings.menu_right != blank -%}
                  {%- for link in section.settings.menu_right.links -%}
                    {%- assign link_title_down = link.title | downcase | strip -%}
                    <li class="gemluxjewel-header__nav-item">
                      <a
                        href="{{ link.url }}"
                        class="gemluxjewel-header__nav-link{% if link_title_down == highlight_title %} is-highlight{% endif %}"
                      >
                        {{ link.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                {%- else -%}
                  <li class="gemluxjewel-header__nav-item"><a href="{{ routes.root_url }}" class="gemluxjewel-header__nav-link">Education</a></li>
                  <li class="gemluxjewel-header__nav-item"><a href="{{ routes.root_url }}" class="gemluxjewel-header__nav-link">Contact</a></li>
                  <li class="gemluxjewel-header__nav-item"><a href="{{ routes.root_url }}" class="gemluxjewel-header__nav-link is-highlight">Visit</a></li>
                {%- endif -%}
              </ul>
            </nav>

            {%- if section.settings.locale_text != blank -%}
              <span class="gemluxjewel-header__locale">{{ section.settings.locale_text | escape }}</span>
            {%- endif -%}

            <div class="gemluxjewel-header__icons">
              {%- if section.settings.enable_search -%}
                <a href="{{ routes.search_url }}" class="gemluxjewel-header__icon" aria-label="Search">
                  <img src="{{ 'header-search-thin.svg' | asset_url }}" alt="" width="18" height="18">
                </a>
              {%- endif -%}
              {%- if section.settings.show_account_icon -%}
                <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="gemluxjewel-header__icon" aria-label="Account">
                  <img src="{{ 'header-icon2.svg' | asset_url }}" alt="" width="18" height="18">
                </a>
              {%- endif -%}
              {%- if section.settings.show_wishlist_icon and section.settings.wishlist_url != blank -%}
                <a href="{{ section.settings.wishlist_url }}" class="gemluxjewel-header__icon" aria-label="Wishlist">
                  <img src="{{ 'header-icon3.svg' | asset_url }}" alt="" width="18" height="18">
                </a>
              {%- endif -%}
              <a href="{{ routes.cart_url }}" class="gemluxjewel-header__icon" id="gemluxjewel-cart-icon" aria-label="Cart">
                <img src="{{ 'header-bag-thin.svg' | asset_url }}" alt="" width="18" height="18">
                {%- if cart.item_count > 0 -%}
                  <span class="gemluxjewel-header__cart-count">{{ cart.item_count }}</span>
                {%- endif -%}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<div class="gemluxjewel gemluxjewel-mobile-menu" data-gemluxjewel-mobile-menu id="gemluxjewelMobileMenu">
  <div class="gemluxjewel-mobile-menu__head">
    <a href="{{ routes.root_url }}" class="gemluxjewel-header__logo">{{ logo_label | escape }}</a>
    <button type="button" class="gemluxjewel-mobile-menu__close" data-gemluxjewel-menu-close aria-label="Close menu">
      <img src="{{ 'close-btn.svg' | asset_url }}" alt="" width="32" height="32">
    </button>
  </div>
  <nav class="gemluxjewel-mobile-menu__nav" aria-label="Mobile">
    {%- if section.settings.menu != blank -%}
      {%- for link in section.settings.menu.links -%}
        {%- if link.links.size > 0 -%}
          <div class="gemluxjewel-mobile-menu__group">
            <a href="{{ link.url }}" class="gemluxjewel-mobile-menu__link gemluxjewel-mobile-menu__link--parent" data-gemluxjewel-menu-close-on-click>{{ link.title | escape }}</a>
            {%- for child in link.links -%}
              {%- if child.links.size > 0 -%}
                <p class="gemluxjewel-mobile-menu__subhead">{{ child.title | escape }}</p>
                {%- for grandchild in child.links -%}
                  <a href="{{ grandchild.url }}" class="gemluxjewel-mobile-menu__sublink" data-gemluxjewel-menu-close-on-click>{{ grandchild.title | escape }}</a>
                {%- endfor -%}
              {%- else -%}
                <a href="{{ child.url }}" class="gemluxjewel-mobile-menu__sublink" data-gemluxjewel-menu-close-on-click>{{ child.title | escape }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <a href="{{ link.url }}" class="gemluxjewel-mobile-menu__link" data-gemluxjewel-menu-close-on-click>{{ link.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if section.settings.menu_right != blank -%}
      {%- for link in section.settings.menu_right.links -%}
        <a href="{{ link.url }}" class="gemluxjewel-mobile-menu__link" data-gemluxjewel-menu-close-on-click>{{ link.title | escape }}</a>
      {%- endfor -%}
    {%- endif -%}
    {%- if section.settings.mobile_menu != blank -%}
      {%- for link in section.settings.mobile_menu.links -%}
        <a href="{{ link.url }}" class="gemluxjewel-mobile-menu__link" data-gemluxjewel-menu-close-on-click>{{ link.title | escape }}</a>
      {%- endfor -%}
    {%- endif -%}
  </nav>
</div>

{% schema %}
{
  "name": "gemluxjewel Header",
  "class": "gemluxjewel-section",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "gemluxjewel"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Left menu",
      "default": "main-menu",
      "info": "Mega menu: add child links as column headings, and grandchild links as items inside each column."
    },
    {
      "type": "link_list",
      "id": "menu_right",
      "label": "Right menu"
    },
    {
      "type": "text",
      "id": "highlight_link",
      "label": "Highlighted right link",
      "default": "Visit",
      "info": "Matches link title (case-insensitive) and styles it in brand green."
    },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "Extra mobile links"
    },
    {
      "type": "header",
      "content": "Mega menu"
    },
    {
      "type": "checkbox",
      "id": "show_shop_all",
      "label": "Show Shop All link on columns",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop All label",
      "default": "Shop All"
    },
    {
      "type": "text",
      "id": "view_column_label",
      "label": "Single-link column label",
      "default": "View all"
    },
    {
      "type": "text",
      "id": "mega_info_columns",
      "label": "Columns with info icon",
      "info": "Comma-separated column titles, e.g. Lab Grown Diamonds, Moissanite"
    },
    {
      "type": "text",
      "id": "mega_highlight_links",
      "label": "Highlighted link titles",
      "info": "Comma-separated link titles to highlight in green."
    },
    {
      "type": "text",
      "id": "mega_new_badge_links",
      "label": "NEW badge link titles",
      "info": "Comma-separated link titles to show a NEW badge."
    },
    {
      "type": "image_picker",
      "id": "mega_featured_image",
      "label": "Featured image (optional)",
      "info": "Shown at the end of every mega menu dropdown."
    },
    {
      "type": "text",
      "id": "mega_featured_caption",
      "label": "Featured image caption"
    },
    {
      "type": "url",
      "id": "mega_featured_link",
      "label": "Featured image link"
    },
    {
      "type": "header",
      "content": "Announcement bar"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text (if no offer blocks)",
      "default": "127,778 TREES PLANTED"
    },
    {
      "type": "url",
      "id": "announcement_url",
      "label": "Announcement link"
    },
    {
      "type": "checkbox",
      "id": "show_announcement_icon",
      "label": "Show announcement icon",
      "default": true
    },
    {
      "type": "range",
      "id": "slider_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Announcement slider speed",
      "default": 4,
      "info": "Add 2 or more Offer blocks below to enable the rotating announcement bar."
    },
    {
      "type": "header",
      "content": "Utilities"
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account_icon",
      "label": "Show account icon",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_wishlist_icon",
      "label": "Show wishlist icon",
      "default": false
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist link"
    },
    {
      "type": "text",
      "id": "locale_text",
      "label": "Locale / region text",
      "default": "IN"
    }
  ],
  "blocks": [
    {
      "type": "top_link",
      "name": "Offer",
      "settings": [
        { "type": "text", "id": "label", "label": "Offer text", "default": "127,778 TREES PLANTED" },
        { "type": "url", "id": "url", "label": "Offer link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Header",
      "blocks": [
        { "type": "top_link", "settings": { "label": "127,778 TREES PLANTED", "url": "" } },
        { "type": "top_link", "settings": { "label": "Free shipping on orders over $100", "url": "shopify://collections/all" } },
        { "type": "top_link", "settings": { "label": "10% off your first order — Shop now", "url": "shopify://collections/all" } }
      ]
    }
  ]
}
{% endschema %}
