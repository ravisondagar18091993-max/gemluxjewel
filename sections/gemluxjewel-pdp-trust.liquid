{% render 'gemluxjewel-fonts' %}
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet">
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-product.css' | asset_url | stylesheet_tag }}
{%- if section.settings.accent_style == 'brand' -%}
  {{ 'section-gemluxjewel-custom-jewellery.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<section class="gemluxjewel gemluxjewel-pdp-trust{% if section.settings.accent_style == 'brand' %} gemluxjewel-pdp-trust--brand{% endif %}">
  <div class="gemluxjewel-container">
    {%- if section.settings.prefix != blank -%}
      <p class="gemluxjewel-pdp-trust__prefix">{{ section.settings.prefix | escape }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="gemluxjewel-pdp-trust__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <ul class="gemluxjewel-pdp-trust__list">
      {%- for i in (1..6) -%}
        {%- liquid
          assign label_key = 'label_' | append: i
          assign icon_key = 'icon_' | append: i
          assign image_key = 'icon_image_' | append: i
          assign item_label = section.settings[label_key]
          assign item_icon = section.settings[icon_key]
          assign item_icon_image = section.settings[image_key]
        -%}
        {%- if item_label != blank -%}
          <li class="gemluxjewel-pdp-trust__item">
            <span class="gemluxjewel-pdp-trust__icon">
              {%- if item_icon_image != blank -%}
                {{
                  item_icon_image
                  | image_url: width: 96
                  | image_tag: widths: '48, 96', sizes: '48px', loading: 'lazy', alt: '', class: 'gemluxjewel-pdp-trust__icon-img'
                }}
              {%- else -%}
                {% render 'gemluxjewel-pdp-trust-icon', icon: item_icon %}
              {%- endif -%}
            </span>
            <span class="gemluxjewel-pdp-trust__label">{{ item_label | escape }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_button and section.settings.button_label != blank -%}
      <div class="gemluxjewel-pdp-trust__cta">
        <a
          href="{{ section.settings.button_link | default: routes.root_url }}"
          class="gemluxjewel-pdp-trust__btn"
        >
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

