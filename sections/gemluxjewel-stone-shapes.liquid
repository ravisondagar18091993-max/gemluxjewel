{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gemluxjewel-stone-shapes.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign products_collection = section.settings.products_collection
  if products_collection == blank
    assign products_collection = collections.all
  endif

  assign filter_label_setting = section.settings.filter_label | default: 'Stone shape' | downcase
  assign stone_shape_filter = blank

  if section.settings.auto_fetch_shapes and products_collection != blank
    for filter in products_collection.filters
      assign filter_label = filter.label | downcase
      assign filter_param = filter.param_name | downcase

      if filter_param contains 'stone-shape' or filter_param contains 'stone_shape' or filter_label == filter_label_setting
        assign stone_shape_filter = filter
        break
      endif
    endfor
  endif

  assign use_filter_shapes = false
  if stone_shape_filter != blank and stone_shape_filter.values.size > 0
    assign use_filter_shapes = true
  endif
-%}

<section class="gemluxjewel gemluxjewel-stone-shapes">
  <div class="gemluxjewel-container">
    <div class="gemluxjewel-section-header gemluxjewel-section-header--center">
      <div>
        {%- if section.settings.title != blank -%}
          <h2 class="gemluxjewel-section-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="gemluxjewel-section-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if use_filter_shapes or section.blocks.size > 0 -%}
      <div class="gemluxjewel-stone-shapes__slider" data-gemluxjewel-stone-shapes-slider>
        <button
          type="button"
          class="gemluxjewel-stone-shapes__nav gemluxjewel-stone-shapes__nav--prev"
          data-gemluxjewel-stone-shapes-prev
          aria-label="Previous shapes"
          disabled
        >
          <img src="{{ 'green-right-arrow.svg' | asset_url }}" alt="" width="16" height="16" class="gemluxjewel-stone-shapes__nav-icon gemluxjewel-stone-shapes__nav-icon--prev">
        </button>

        <div class="gemluxjewel-stone-shapes__viewport">
          <div class="gemluxjewel-stone-shapes__track" data-gemluxjewel-stone-shapes-track>
            {%- if use_filter_shapes -%}
              {%- for value in stone_shape_filter.values -%}
                {%- liquid
                  assign shape_title = value.label
                  assign shape_label_key = shape_title | downcase | strip
                  assign shape_image = blank
                  assign shape_url = products_collection.url | append: '?' | append: value.param_name | append: '=' | append: value.value | url_param_escape
                  assign block_attributes = blank

                  for block in section.blocks
                    assign block_title_key = block.settings.title | downcase | strip
                    if block_title_key == shape_label_key
                      if block.settings.image != blank
                        assign shape_image = block.settings.image
                      endif
                      assign block_attributes = block.shopify_attributes
                      break
                    endif
                  endfor
                -%}

                <a href="{{ shape_url }}" class="gemluxjewel-stone-shapes__item" {{ block_attributes }}>
                  <div class="gemluxjewel-stone-shapes__img">
                    {%- if shape_image != blank -%}
                      {{
                        shape_image
                        | image_url: width: 400
                        | image_tag:
                          widths: '120, 160, 200, 300, 400',
                          sizes: '120px',
                          loading: 'lazy',
                          alt: shape_title
                      }}
                    {%- else -%}
                      {% render 'gemluxjewel-theme-image',
                        use_store_media: true,
                        seed: forloop.index,
                        width: 200,
                        widths: '120,160,200',
                        sizes: '120px',
                        alt: shape_title,
                        class: 'gemluxjewel-stone-shapes__fallback'
                      %}
                    {%- endif -%}
                  </div>
                  <span class="gemluxjewel-stone-shapes__label">{{ shape_title | escape }}</span>
                </a>
              {%- endfor -%}
            {%- else -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign shape_title = block.settings.title
                  assign shape_collection = block.settings.collection
                  assign shape_image = block.settings.image

                  if shape_title == blank and shape_collection != blank
                    assign shape_title = shape_collection.title
                  endif

                  if shape_image == blank and shape_collection != blank
                    assign shape_image = shape_collection.featured_image
                  endif

                  assign shape_url = block.settings.link
                  if shape_url == blank and shape_collection != blank
                    assign shape_url = shape_collection.url
                  endif

                  if shape_url == blank and shape_title != blank and products_collection != blank
                    for filter in products_collection.filters
                      assign filter_label = filter.label | downcase
                      assign filter_param = filter.param_name | downcase
                      if filter_param contains 'stone-shape' or filter_param contains 'stone_shape' or filter_label == filter_label_setting
                        for value in filter.values
                          assign value_label_key = value.label | downcase | strip
                          assign shape_title_key = shape_title | downcase | strip
                          if value_label_key == shape_title_key
                            assign shape_url = products_collection.url | append: '?' | append: value.param_name | append: '=' | append: value.value | url_param_escape
                            break
                          endif
                        endfor
                        break
                      endif
                    endfor
                  endif
                -%}

                {%- if shape_url != blank -%}
                  <a href="{{ shape_url }}" class="gemluxjewel-stone-shapes__item" {{ block.shopify_attributes }}>
                {%- else -%}
                  <div class="gemluxjewel-stone-shapes__item gemluxjewel-stone-shapes__item--static" {{ block.shopify_attributes }}>
                {%- endif -%}
                  <div class="gemluxjewel-stone-shapes__img">
                    {%- if shape_image != blank -%}
                      {{
                        shape_image
                        | image_url: width: 400
                        | image_tag:
                          widths: '120, 160, 200, 300, 400',
                          sizes: '120px',
                          loading: 'lazy',
                          alt: shape_title
                      }}
                    {%- else -%}
                      {% render 'gemluxjewel-theme-image',
                        use_store_media: true,
                        seed: forloop.index,
                        width: 200,
                        widths: '120,160,200',
                        sizes: '120px',
                        alt: shape_title,
                        class: 'gemluxjewel-stone-shapes__fallback'
                      %}
                    {%- endif -%}
                  </div>
                  {%- if shape_title != blank -%}
                    <span class="gemluxjewel-stone-shapes__label">{{ shape_title | escape }}</span>
                  {%- endif -%}
                {%- if shape_url != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

        <button
          type="button"
          class="gemluxjewel-stone-shapes__nav gemluxjewel-stone-shapes__nav--next"
          data-gemluxjewel-stone-shapes-next
          aria-label="Next shapes"
        >
          <img src="{{ 'green-right-arrow.svg' | asset_url }}" alt="" width="16" height="16" class="gemluxjewel-stone-shapes__nav-icon">
        </button>
      </div>

      {%- if section.settings.auto_fetch_shapes and stone_shape_filter == blank -%}
        <p class="gemluxjewel-stone-shapes__notice">
          Enable the <strong>Stone shape</strong> category metafield filter in
          <strong>Search &amp; Discovery</strong> to load shapes automatically, or assign collections to each block.
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "gemluxjewel Stone Shapes",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Stone Shape"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Explore our collection by diamond and gemstone cut — find the shape that speaks to you."
    },
    {
      "type": "header",
      "content": "Stone shape filtering"
    },
    {
      "type": "paragraph",
      "content": "Shapes are loaded from your Shopify category metafield filter (Stone shape). Enable it in Search & Discovery → Filters, then assign stone shapes on products."
    },
    {
      "type": "collection",
      "id": "products_collection",
      "label": "Products collection",
      "info": "Collection page opened when a shape is clicked. Usually All products."
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter label",
      "default": "Stone shape",
      "info": "Must match the filter name in Search & Discovery."
    },
    {
      "type": "checkbox",
      "id": "auto_fetch_shapes",
      "label": "Auto-fetch all stone shapes from filter",
      "default": true,
      "info": "When enabled, all values from the Stone shape filter are shown. Blocks only override images."
    }
  ],
  "blocks": [
    {
      "type": "shape",
      "name": "Shape image",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Shape name",
          "default": "Round",
          "info": "Must match the category metafield value, e.g. Marquise, Round, Oval."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Shape image",
          "info": "Upload a PNG or JPG for this shape."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (fallback)",
          "info": "Only used when auto-fetch is off."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (fallback)",
          "info": "Optional. Overrides metafield filter link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Stone Shapes",
      "blocks": [
        { "type": "shape", "settings": { "title": "Round" } },
        { "type": "shape", "settings": { "title": "Princess" } },
        { "type": "shape", "settings": { "title": "Cushion" } },
        { "type": "shape", "settings": { "title": "Oval" } },
        { "type": "shape", "settings": { "title": "Emerald" } },
        { "type": "shape", "settings": { "title": "Pear" } },
        { "type": "shape", "settings": { "title": "Marquise" } },
        { "type": "shape", "settings": { "title": "Asscher" } },
        { "type": "shape", "settings": { "title": "Radiant" } },
        { "type": "shape", "settings": { "title": "Heart" } }
      ]
    }
  ]
}
{% endschema %}
