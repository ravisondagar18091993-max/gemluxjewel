{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gemluxjewel-stone-shapes.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign products_collection = section.settings.products_collection
  if products_collection == blank
    assign products_collection = collections.all
  endif

  assign filter_label_setting = section.settings.filter_label | default: 'Stone shape' | downcase
  assign stone_shape_filter = blank

  if section.settings.auto_fetch_shapes and products_collection != blank
    for filter in products_collection.filters
      assign filter_label = filter.label | downcase
      assign filter_param = filter.param_name | downcase

      if filter_param contains 'stone-shape' or filter_param contains 'stone_shape' or filter_label == filter_label_setting
        assign stone_shape_filter = filter
        break
      endif
    endfor
  endif

  assign use_filter_shapes = false
  if stone_shape_filter != blank and stone_shape_filter.values.size > 0
    assign use_filter_shapes = true
  endif

  assign metaobject_type = section.settings.metaobject_type | default: 'stone_shape'
  assign use_metaobjects = section.settings.use_metaobjects

  assign shape_image_sizes = '(min-width: 1200px) 180px, (min-width: 750px) 160px, 110px'
-%}

<section class="gemluxjewel gemluxjewel-stone-shapes">
  <div class="gemluxjewel-container">
    <div class="gemluxjewel-section-header gemluxjewel-section-header--center">
      <div>
        {%- if section.settings.title != blank -%}
          <h2 class="gemluxjewel-section-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="gemluxjewel-section-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if use_metaobjects or use_filter_shapes or section.blocks.size > 0 -%}
      <div class="gemluxjewel-stone-shapes__slider" data-gemluxjewel-stone-shapes-slider>
        <button
          type="button"
          class="gemluxjewel-stone-shapes__nav gemluxjewel-stone-shapes__nav--prev"
          data-gemluxjewel-stone-shapes-prev
          aria-label="Previous shapes"
          disabled
        >
          <img src="{{ 'green-right-arrow.svg' | asset_url }}" alt="" width="16" height="16" class="gemluxjewel-stone-shapes__nav-icon gemluxjewel-stone-shapes__nav-icon--prev">
        </button>

        <div class="gemluxjewel-stone-shapes__viewport">
          <div class="gemluxjewel-stone-shapes__track" data-gemluxjewel-stone-shapes-track>
            {% render 'gemluxjewel-stone-shapes-items',
              section: section,
              target_collection: products_collection,
              stone_shape_filter: stone_shape_filter,
              use_metaobjects: use_metaobjects,
              metaobject_type: metaobject_type,
              use_filter_shapes: use_filter_shapes,
              item_modifier: '',
              shape_image_sizes: shape_image_sizes
            %}
          </div>
        </div>

        <button
          type="button"
          class="gemluxjewel-stone-shapes__nav gemluxjewel-stone-shapes__nav--next"
          data-gemluxjewel-stone-shapes-next
          aria-label="Next shapes"
        >
          <img src="{{ 'green-right-arrow.svg' | asset_url }}" alt="" width="16" height="16" class="gemluxjewel-stone-shapes__nav-icon">
        </button>
      </div>

      {%- if section.settings.auto_fetch_shapes and use_metaobjects == false and stone_shape_filter == blank -%}
        <p class="gemluxjewel-stone-shapes__notice">
          Enable the <strong>Stone shape</strong> category metafield filter in
          <strong>Search &amp; Discovery</strong> to load shapes automatically, or assign collections to each block.
        </p>
      {%- elsif section.settings.use_metaobjects and shop.metaobjects[metaobject_type] == blank -%}
        <p class="gemluxjewel-stone-shapes__notice">
          No metaobject type <strong>{{ metaobject_type }}</strong> found. Check the type handle under
          <strong>Settings → Custom data → Metaobjects</strong>, or turn off “Load from metaobjects”.
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "gemluxjewel Stone Shapes",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Stone Shape"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Explore our collection by diamond and gemstone cut — find the shape that speaks to you."
    },
    {
      "type": "header",
      "content": "Stone shape filtering"
    },
    {
      "type": "paragraph",
      "content": "By default, shapes load from your Stone shape metaobjects (Settings → Custom data). Fallback: Shopify category filter from Search & Discovery."
    },
    {
      "type": "checkbox",
      "id": "use_metaobjects",
      "label": "Load shapes from metaobjects",
      "default": true,
      "info": "Shows each metaobject entry (Cushion Cut, Princess Cut, etc.). Turn off to use the Shopify Stone shape filter instead."
    },
    {
      "type": "text",
      "id": "metaobject_type",
      "label": "Metaobject type handle",
      "default": "stone_shape",
      "info": "The type handle from Settings → Custom data → Metaobjects (e.g. stone_shape)."
    },
    {
      "type": "collection",
      "id": "products_collection",
      "label": "Products collection",
      "info": "Collection page opened when a shape is clicked. Usually All products."
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter label",
      "default": "Stone shape",
      "info": "Must match the filter name in Search & Discovery."
    },
    {
      "type": "checkbox",
      "id": "auto_fetch_shapes",
      "label": "Auto-fetch all stone shapes from filter",
      "default": true,
      "info": "When enabled, all values from the Stone shape filter are shown. Blocks only override images."
    }
  ],
  "blocks": [
    {
      "type": "shape",
      "name": "Shape image",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Shape name",
          "default": "Round",
          "info": "Must match the category metafield value or metaobject display name, e.g. Marquise Cut, Round, Cushion Cut."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Shape image",
          "info": "Upload a PNG or JPG for this shape."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (fallback)",
          "info": "Only used when auto-fetch is off."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (fallback)",
          "info": "Optional. Overrides metafield filter link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Stone Shapes",
      "blocks": [
        { "type": "shape", "settings": { "title": "Round" } },
        { "type": "shape", "settings": { "title": "Princess" } },
        { "type": "shape", "settings": { "title": "Cushion" } },
        { "type": "shape", "settings": { "title": "Oval" } },
        { "type": "shape", "settings": { "title": "Emerald" } },
        { "type": "shape", "settings": { "title": "Pear" } },
        { "type": "shape", "settings": { "title": "Marquise" } },
        { "type": "shape", "settings": { "title": "Asscher" } },
        { "type": "shape", "settings": { "title": "Radiant" } },
        { "type": "shape", "settings": { "title": "Heart" } }
      ]
    }
  ]
}
{% endschema %}
