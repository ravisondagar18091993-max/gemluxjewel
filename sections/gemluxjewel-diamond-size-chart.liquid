{% render 'gemluxjewel-fonts' %}

<section class="gemluxjewel gemluxjewel-diamond-chart">
  <div class="gemluxjewel-container gemluxjewel-diamond-chart__container">
    <div class="gemluxjewel-diamond-chart__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="gemluxjewel-diamond-chart__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="gemluxjewel-diamond-chart__title">{{ section.settings.title | escape }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="gemluxjewel-diamond-chart__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="gemluxjewel-diamond-chart__selector">
      <label for="DiamondShapeSelect">Select your diamond shape:</label>
      <select id="DiamondShapeSelect" data-diamond-shape-select>
        <option value="round">Round</option>
        <option value="princess">Princess</option>
        <option value="cushion">Cushion</option>
        <option value="oval">Oval</option>
        <option value="emerald">Emerald</option>
        <option value="pear">Pear</option>
        <option value="marquise">Marquise</option>
        <option value="asscher">Asscher</option>
        <option value="radiant">Radiant</option>
        <option value="heart">Heart</option>
      </select>
    </div>

    <div class="gemluxjewel-diamond-chart__body">
      <div class="gemluxjewel-diamond-chart__table-wrap">
        <table class="gemluxjewel-diamond-chart__table">
          <thead>
            <tr>
              <th>MM Size</th>
              <th>Carat Weight</th>
            </tr>
          </thead>
          <tbody data-diamond-shape-table></tbody>
        </table>
      </div>

      <div class="gemluxjewel-diamond-chart__image-wrap">
        {%- assign diamond_shapes = "round,princess,cushion,oval,emerald,pear,marquise,asscher,radiant,heart" | split: "," -%}
        {%- for shape in diamond_shapes -%}
          {%- assign setting_key = 'image_' | append: shape -%}
          {%- assign shape_image = section.settings[setting_key] -%}
          <img
            src="{% if shape_image != blank %}{{ shape_image | image_url: width: 900 }}{% endif %}"
            alt="{{ shape | capitalize }} diamond size on hand"
            class="gemluxjewel-diamond-chart__image{% unless shape == 'round' %} hidden{% endunless %}"
            data-diamond-shape-image="{{ shape }}"
            width="900"
            height="900"
            loading="lazy"
          >
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

