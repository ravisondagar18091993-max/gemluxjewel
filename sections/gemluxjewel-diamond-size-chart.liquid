{% schema %}
{
  "name": "Diamond Size Chart",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Diamond Size Chart" },
    { "type": "text", "id": "title", "label": "Title", "default": "Diamond Size Chart" },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Want to know the actual size of a 1 carat diamond on a hand? Use our diamond size chart to understand the millimeter (mm) size of each diamond shape.</p>"
    },
    { "type": "header", "content": "Hand comparison images" },
    { "type": "image_picker", "id": "image_round", "label": "Round" },
    { "type": "image_picker", "id": "image_princess", "label": "Princess" },
    { "type": "image_picker", "id": "image_cushion", "label": "Cushion" },
    { "type": "image_picker", "id": "image_oval", "label": "Oval" },
    { "type": "image_picker", "id": "image_emerald", "label": "Emerald" },
    { "type": "image_picker", "id": "image_pear", "label": "Pear" },
    { "type": "image_picker", "id": "image_marquise", "label": "Marquise" },
    { "type": "image_picker", "id": "image_asscher", "label": "Asscher" },
    { "type": "image_picker", "id": "image_radiant", "label": "Radiant" },
    { "type": "image_picker", "id": "image_heart", "label": "Heart" }
  ],
  "presets": [{ "name": "Diamond Size Chart" }]
}
{% endschema %}