<script>
  (function () {
    var dataEl = document.getElementById('gemluxjewel-diamond-chart-data');
    if (!dataEl) return;
    var chartData = JSON.parse(dataEl.textContent);

    var select = document.querySelector('[data-diamond-shape-select]');
    var tableBody = document.querySelector('[data-diamond-shape-table]');
    var images = document.querySelectorAll('[data-diamond-shape-image]');

    function renderTable(shape) {
      var rows = chartData[shape] || [];
      tableBody.innerHTML = rows
        .map(function (row) {
          return '<tr><td>' + row[0] + '</td><td>' + row[1] + '</td></tr>';
        })
        .join('');
    }

    function renderImage(shape) {
      images.forEach(function (img) {
        img.classList.toggle('hidden', img.getAttribute('data-diamond-shape-image') !== shape);
      });
    }

    select.addEventListener('change', function () {
      renderTable(this.value);
      renderImage(this.value);
    });

    renderTable(select.value);
  })();
</script>

