{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
{{ 'section-gemluxjewel-custom-jewellery.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-custom-expert">
  <div class="gemluxjewel-container">
    <div class="gemluxjewel-custom-expert__grid">
      <div class="gemluxjewel-custom-expert__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              widths: '450, 700, 900',
              sizes: '(min-width: 990px) 42vw, 100vw',
              loading: 'lazy',
              alt: section.settings.title | default: 'Expert consultation'
          }}
        {%- else -%}
          <img
            src="{{ 'gemluxjewel-custom-expert-banner.png' | asset_url }}"
            alt="{{ section.settings.title | escape }}"
            loading="lazy"
            width="900"
            height="600"
          >
        {%- endif -%}
      </div>

      <div class="gemluxjewel-custom-expert__content">
        {%- if section.settings.title != blank -%}
          <h2 class="gemluxjewel-custom-expert__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="gemluxjewel-custom-expert__text">{{ section.settings.text | escape | newline_to_br }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: routes.root_url }}"
            class="gemluxjewel-custom-expert__btn"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GL Custom Expert",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Left image" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Need Expert Advice?" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "No idea where to start? Let us help you find the perfect ring to celebrate your story. Book a consultation with a gemologist today for free expert advice."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact Design Experts" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "GL Custom Expert" }]
}
{% endschema %}
