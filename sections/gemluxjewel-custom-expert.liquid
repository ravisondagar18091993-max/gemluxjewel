{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-custom-jewellery.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-custom-expert">
  <div class="gemluxjewel-custom-expert__inner">
    <div class="gemluxjewel-custom-expert__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            widths: '600, 900, 1200, 1400',
            sizes: '(min-width: 990px) 50vw, 100vw',
            loading: 'lazy',
            alt: section.settings.title
        }}
      {%- else -%}
        <img
          src="{{ 'gemluxjewel-custom-expert-banner.png' | asset_url }}"
          alt="{{ section.settings.title | escape }}"
          loading="lazy"
          width="1400"
          height="933"
        >
      {%- endif -%}
    </div>
    <div class="gemluxjewel-custom-expert__content">
      {%- if section.settings.title != blank -%}
        <h2 class="gemluxjewel-custom-expert__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="gemluxjewel-custom-expert__text">{{ section.settings.text | escape | newline_to_br }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: routes.root_url }}"
          class="gemluxjewel-custom-expert__btn"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GL Custom Expert",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Need Expert Advice?" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Looking for Professional Guidance?\nIf you require assistance with custom orders or designing your perfect piece, don't hesitate to schedule a consultation with our experts."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Book an Appointment" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "GL Custom Expert" }]
}
{% endschema %}
