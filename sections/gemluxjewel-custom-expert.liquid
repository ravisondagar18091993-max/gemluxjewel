{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-custom-jewellery.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-custom-expert">
  <div class="gemluxjewel-container">
    <div class="gemluxjewel-custom-expert__grid">
      <div class="gemluxjewel-custom-expert__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              widths: '600, 900, 1200',
              sizes: '(min-width: 990px) 50vw, 100vw',
              loading: 'lazy',
              alt: section.settings.title
          }}
        {%- else -%}
          {% render 'gemluxjewel-theme-image',
            use_store_media: true,
            seed: 5,
            width: 1200,
            widths: '600,900,1200',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: section.settings.title
          %}
        {%- endif -%}
      </div>
      <div class="gemluxjewel-custom-expert__content">
        {%- if section.settings.title != blank -%}
          <h2 class="gemluxjewel-custom-expert__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="gemluxjewel-custom-expert__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.root_url }}" class="gemluxjewel-custom-form__btn gemluxjewel-custom-form__btn--inline">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GL Custom Expert",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Need Expert Advice?" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Our gemologists are available for virtual consultations to help you design the perfect ring."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Book a Consultation" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "GL Custom Expert" }]
}
{% endschema %}
