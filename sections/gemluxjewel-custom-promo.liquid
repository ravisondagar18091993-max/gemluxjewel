{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-custom-jewellery.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_promo_content = false
  if section.settings.title != blank or section.settings.text != blank or section.settings.button_label != blank
    assign has_promo_content = true
  endif
-%}

<section class="gemluxjewel gemluxjewel-custom-promo gemluxjewel-custom-promo--full{% unless has_promo_content %} gemluxjewel-custom-promo--image-only{% endunless %}">
  <div class="gemluxjewel-custom-promo__banner">
      <div class="gemluxjewel-custom-promo__bg" aria-hidden="true">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '600, 900, 1200, 1600',
              sizes: '100vw',
              loading: 'lazy',
              alt: ''
          }}
        {%- else -%}
          {% render 'gemluxjewel-theme-image',
            use_store_media: true,
            seed: 3,
            width: 1600,
            widths: '600,900,1600',
            sizes: '100vw',
            alt: section.settings.title
          %}
        {%- endif -%}
        {%- if has_promo_content -%}
          <div class="gemluxjewel-custom-promo__overlay"></div>
        {%- endif -%}
      </div>

      {%- if has_promo_content -%}
      <div class="gemluxjewel-custom-promo__content">
        {%- if section.settings.title != blank -%}
          <h2 class="gemluxjewel-custom-promo__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="gemluxjewel-custom-promo__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.root_url }}" class="gemluxjewel-custom-form__btn gemluxjewel-custom-form__btn--inline">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
      {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GL Custom Promo",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Timeless Ring Styles" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Explore our curated collection of ready-to-wear rings while your custom piece is being crafted."
    },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "gemluxjewel Custom Promo" }]
}
{% endschema %}
