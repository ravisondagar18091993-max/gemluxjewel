{{ 'section-home.css' | asset_url | stylesheet_tag }}

<section class="home-section home-brand-story">
  <div class="home-brand-story__text">
    {%- if section.settings.title != blank -%}
      <h2 class="home-brand-story__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="home-brand-story__body">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link }}" class="home-brand-story__link">
        {{ section.settings.link_label | escape }}
      </a>
    {%- endif -%}
  </div>
  <div class="home-brand-story__image">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1500
        | image_tag:
          widths: '550, 750, 1100, 1500',
          sizes: '(min-width: 750px) 50vw, 100vw',
          loading: 'lazy'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home Brand Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "About our jewellery & aesthetics"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>At Gem Lux Jewels, we craft timeless pieces that celebrate life's most precious moments. Each design is thoughtfully created using ethically sourced materials and masterful artistry, blending classic elegance with contemporary style.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Discover Our Story"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Home Brand Story"
    }
  ]
}
{% endschema %}
