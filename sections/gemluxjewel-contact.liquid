{% render 'gemluxjewel-fonts' %}
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-contact.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-contact-page">
  <div class="gemluxjewel-contact-page__hero">
    {%- if section.settings.hero_image != blank -%}
      {{
        section.settings.hero_image
        | image_url: width: 2400
        | image_tag:
          widths: '800, 1200, 1600, 2400',
          sizes: '100vw',
          loading: 'eager',
          class: 'gemluxjewel-contact-page__hero-image',
          alt: section.settings.hero_heading
      }}
    {%- else -%}
      {% render 'gemluxjewel-theme-image',
        use_store_media: true,
        seed: 8,
        width: 2400,
        widths: '800,1200,2400',
        sizes: '100vw',
        alt: section.settings.hero_heading,
        class: 'gemluxjewel-contact-page__hero-image'
      %}
    {%- endif -%}
    <div class="gemluxjewel-contact-page__hero-overlay"></div>
    <div class="gemluxjewel-contact-page__hero-content">
      {%- if section.settings.hero_heading != blank -%}
        <h1 class="gemluxjewel-contact-page__hero-title">{{ section.settings.hero_heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.hero_subheading != blank -%}
        <p class="gemluxjewel-contact-page__hero-text">{{ section.settings.hero_subheading | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="gemluxjewel-contact-page__body">
    <div class="gemluxjewel-container gemluxjewel-contact-page__container">
      {%- form 'contact', id: 'GemluxContactForm', class: 'gemluxjewel-contact-page__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="gemluxjewel-contact-page__status gemluxjewel-contact-page__status--success" tabindex="-1" autofocus>
            {{ section.settings.success_message | default: "Thanks for contacting us. We'll get back to you as soon as possible." | escape }}
          </p>
        {%- elsif form.errors -%}
          <div class="gemluxjewel-contact-page__status gemluxjewel-contact-page__status--error" tabindex="-1" autofocus>
            <p>{{ 'templates.contact.form.error_heading' | t }}</p>
            <ul class="gemluxjewel-contact-page__errors" role="list">
              {%- for field in form.errors -%}
                <li>
                  {{ form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="gemluxjewel-contact-page__fields">
          <div class="gemluxjewel-contact-page__field">
            <label class="gemluxjewel-contact-page__label" for="GemluxContactForm-first-name">
              {{ section.settings.first_name_label | default: 'Your first name' | escape }} *
            </label>
            <input
              class="gemluxjewel-contact-page__input"
              type="text"
              id="GemluxContactForm-first-name"
              name="contact[First name]"
              placeholder="{{ section.settings.first_name_placeholder | default: 'Your first name' | escape }}"
              autocomplete="given-name"
              required
            >
          </div>

          <div class="gemluxjewel-contact-page__field">
            <label class="gemluxjewel-contact-page__label" for="GemluxContactForm-last-name">
              {{ section.settings.last_name_label | default: 'Your last name' | escape }} *
            </label>
            <input
              class="gemluxjewel-contact-page__input"
              type="text"
              id="GemluxContactForm-last-name"
              name="contact[Last name]"
              placeholder="{{ section.settings.last_name_placeholder | default: 'Your last name' | escape }}"
              autocomplete="family-name"
              required
            >
          </div>

          <div class="gemluxjewel-contact-page__field">
            <label class="gemluxjewel-contact-page__label" for="GemluxContactForm-email">
              {{ section.settings.email_label | default: 'Your email' | escape }} *
            </label>
            <input
              class="gemluxjewel-contact-page__input"
              type="email"
              id="GemluxContactForm-email"
              name="contact[email]"
              placeholder="{{ section.settings.email_placeholder | default: 'Enter your email' | escape }}"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              required
              {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
            >
          </div>

          <div class="gemluxjewel-contact-page__field">
            <label class="gemluxjewel-contact-page__label" for="GemluxContactForm-phone">
              {{ section.settings.phone_label | default: 'Your phone number (optional)' | escape }}
            </label>
            <input
              class="gemluxjewel-contact-page__input"
              type="tel"
              id="GemluxContactForm-phone"
              name="contact[Phone]"
              placeholder="{{ section.settings.phone_placeholder | default: 'Enter your phone number' | escape }}"
              autocomplete="tel"
            >
          </div>

          <div class="gemluxjewel-contact-page__field gemluxjewel-contact-page__field--full">
            <label class="gemluxjewel-contact-page__label" for="GemluxContactForm-body">
              {{ section.settings.message_label | default: 'Message' | escape }} *
            </label>
            <textarea
              class="gemluxjewel-contact-page__textarea"
              id="GemluxContactForm-body"
              name="contact[body]"
              rows="8"
              placeholder="{{ section.settings.message_placeholder | default: 'How can we help you?' | escape }}"
              required
            >{{ form.body }}</textarea>
          </div>
        </div>

        {%- if section.settings.show_mailing_list -%}
          <label class="gemluxjewel-contact-page__checkbox">
            <input
              type="checkbox"
              name="contact[Subscribe to mailing list]"
              value="Yes"
              {% if section.settings.mailing_list_checked %}checked{% endif %}
            >
            <span>{{ section.settings.mailing_list_label | default: 'Subscribe to our mailing list' | escape }}</span>
          </label>
        {%- endif -%}

        {%- if section.settings.show_stone_type -%}
          <fieldset class="gemluxjewel-contact-page__stone-type">
            <legend class="gemluxjewel-contact-page__stone-type-title">{{ section.settings.stone_type_heading | default: 'What stone type are you interested in?' | escape }}</legend>
            <div class="gemluxjewel-contact-page__stone-type-options">
              <label class="gemluxjewel-contact-page__checkbox">
                <input type="checkbox" name="contact[Stone type][]" value="Lab-Grown Diamonds">
                <span>{{ section.settings.stone_type_1 | default: 'Lab-Grown Diamonds' | escape }}</span>
              </label>
              <label class="gemluxjewel-contact-page__checkbox">
                <input type="checkbox" name="contact[Stone type][]" value="Moissanite">
                <span>{{ section.settings.stone_type_2 | default: 'Moissanite' | escape }}</span>
              </label>
            </div>
          </fieldset>
        {%- endif -%}

        <div class="gemluxjewel-contact-page__submit-wrap">
          <button type="submit" class="gemluxjewel-contact-page__submit">
            {{ section.settings.button_label | default: 'Submit' | escape }}
          </button>
        </div>

        {%- if section.settings.legal_text != blank -%}
          <div class="gemluxjewel-contact-page__legal rte">{{ section.settings.legal_text }}</div>
        {%- endif -%}
      {%- endform -%}

      {%- if section.blocks.size > 0 -%}
        <div class="gemluxjewel-contact-page__quick-links">
          {%- for block in section.blocks -%}
            {%- if block.type == 'quick_link' and block.settings.label != blank -%}
              <div class="gemluxjewel-contact-page__quick-link" {{ block.shopify_attributes }}>
                <span class="gemluxjewel-contact-page__quick-link-icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'appointment' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 21s7-4.5 7-11a7 7 0 10-14 0c0 6.5 7 11 7 11z" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>
                    {%- when 'clock' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    {%- when 'faq' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M9.5 9a2.5 2.5 0 015 1c0 1.5-2.5 1.5-2.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="16.5" r=".75" fill="currentColor"/></svg>
                    {%- when 'phone' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6.5 4h3l1.5 4-2 1.5a11 11 0 005 5L17 12.5 21 14v3a2 2 0 01-2.2 2 18 18 0 01-8.3-2.9A18 18 0 014 6.2 2 2 0 016 4h.5z" stroke="currentColor" stroke-width="1.5"/></svg>
                    {%- when 'chat' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 5h16v11H7l-3 3V5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                    {%- else -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 7l9 6 9-6" stroke="currentColor" stroke-width="1.5"/></svg>
                  {%- endcase -%}
                </span>
                {%- if block.settings.url != blank -%}
                  <a href="{{ block.settings.url }}" class="gemluxjewel-contact-page__quick-link-text">{{ block.settings.label | escape }}</a>
                {%- else -%}
                  <span class="gemluxjewel-contact-page__quick-link-text">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gemlux Contact",
  "tag": "section",
  "class": "gemluxjewel-section",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Need assistance?"
    },
    {
      "type": "textarea",
      "id": "hero_subheading",
      "label": "Hero subheading",
      "default": "Send us your questions and we will get straight back to you."
    },
    {
      "type": "header",
      "content": "Form labels"
    },
    {
      "type": "text",
      "id": "first_name_label",
      "label": "First name label",
      "default": "Your first name"
    },
    {
      "type": "text",
      "id": "last_name_label",
      "label": "Last name label",
      "default": "Your last name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Your phone number (optional)"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "Message"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button label",
      "default": "Submit"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for contacting us. We'll get back to you as soon as possible."
    },
    {
      "type": "checkbox",
      "id": "show_mailing_list",
      "label": "Show mailing list checkbox",
      "default": true
    },
    {
      "type": "text",
      "id": "mailing_list_label",
      "label": "Mailing list label",
      "default": "Subscribe to our mailing list"
    },
    {
      "type": "checkbox",
      "id": "mailing_list_checked",
      "label": "Mailing list checked by default",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stone_type",
      "label": "Show stone type options",
      "default": true
    },
    {
      "type": "text",
      "id": "stone_type_heading",
      "label": "Stone type heading",
      "default": "What stone type are you interested in?"
    },
    {
      "type": "text",
      "id": "stone_type_1",
      "label": "Stone type option 1",
      "default": "Lab-Grown Diamonds"
    },
    {
      "type": "text",
      "id": "stone_type_2",
      "label": "Stone type option 2",
      "default": "Moissanite"
    },
    {
      "type": "richtext",
      "id": "legal_text",
      "label": "Legal / privacy text below submit",
      "default": "<p>This site is protected by reCAPTCHA and the Google Privacy Policy and Terms of Service apply.</p>"
    }
  ],
  "blocks": [
    {
      "type": "quick_link",
      "name": "Quick link",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "appointment",
          "options": [
            { "value": "appointment", "label": "Location / appointment" },
            { "value": "clock", "label": "Clock / hours" },
            { "value": "faq", "label": "FAQ" },
            { "value": "phone", "label": "Phone" },
            { "value": "chat", "label": "Live chat" },
            { "value": "email", "label": "Email" }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Book an appointment"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gemlux Contact",
      "blocks": [
        { "type": "quick_link", "settings": { "icon": "appointment", "label": "Book an appointment" } },
        { "type": "quick_link", "settings": { "icon": "clock", "label": "Client care hours: Weekdays 9am - 5pm · Saturday 8am - 4pm" } },
        { "type": "quick_link", "settings": { "icon": "faq", "label": "View frequently asked questions" } },
        { "type": "quick_link", "settings": { "icon": "phone", "label": "+1 000 000 0000" } },
        { "type": "quick_link", "settings": { "icon": "chat", "label": "Live chat" } },
        { "type": "quick_link", "settings": { "icon": "email", "label": "info@gemluxjewels.com" } }
      ]
    }
  ]
}
{% endschema %}
