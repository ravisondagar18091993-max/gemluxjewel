{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-shop.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'gemluxjewel-plp-filters.js' | asset_url }}" defer="defer"></script>

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <section class="gemluxjewel gemluxjewel-shop{% if section.settings.filter_layout == 'horizontal' %} gemluxjewel-shop--horizontal-filters{% endif %}">
    <div class="gemluxjewel-container">
      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- if section.settings.filter_layout == 'horizontal' -%}
          {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
            {% render 'gemluxjewel-plp-filter-bar',
              results: collection,
              section: section,
              paginate: paginate,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: section.settings.enable_sorting
            %}
          {%- endif -%}

          <div id="ProductGridContainer">
            {%- if section.settings.enable_stone_shapes -%}
              {% render 'gemluxjewel-plp-stone-shapes', collection: collection, section: section %}
            {%- endif -%}
            {% render 'gemluxjewel-collection-grid', paginate: paginate %}
          </div>
        {%- else -%}
          <script src="{{ 'gemluxjewel-collection.js' | asset_url }}" defer="defer"></script>
          <div class="gemluxjewel-shop__toolbar">
            {%- if section.settings.enable_filtering -%}
              <button
                type="button"
                class="gemluxjewel-shop__filter-toggle"
                data-gemluxjewel-filter-toggle
                data-show-label="{{ section.settings.filter_label | default: 'Show Filter' | escape }}"
                data-hide-label="{{ section.settings.filter_hide_label | default: 'Hide Filter' | escape }}"
              >
                <span>{{ section.settings.filter_label | default: 'Show Filter' }}</span>
                <span class="gemluxjewel-shop__filter-switch">
                  <input
                    type="checkbox"
                    data-gemluxjewel-filter-checkbox
                    {% if section.settings.filters_open_by_default %}checked{% endif %}
                    aria-label="{{ section.settings.filter_label | default: 'Show Filter' }}"
                  >
                  <span class="gemluxjewel-shop__filter-track"></span>
                </span>
              </button>
            {%- endif -%}

            {%- if section.settings.enable_sorting -%}
              <facet-filters-form class="gemluxjewel-shop__sort-wrap">
                <form class="gemluxjewel-shop__sort-form" id="FacetSortForm">
                  {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                  <select
                    name="sort_by"
                    id="SortBy"
                    class="gemluxjewel-shop__sort"
                    aria-describedby="a11y-refresh-page-message"
                  >
                    {%- for option in collection.sort_options -%}
                      <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                </form>
              </facet-filters-form>
            {%- endif -%}
          </div>

          <div
            class="gemluxjewel-shop__layout{% if section.settings.filters_open_by_default and section.settings.enable_filtering %} is-filters-open{% endif %}"
            data-gemluxjewel-shop-layout
          >
            {%- if section.settings.enable_filtering -%}
              <aside class="gemluxjewel-shop__filters" id="main-collection-filters" data-id="{{ section.id }}">
                {% render 'gemluxjewel-facets',
                  results: collection,
                  enable_filtering: true,
                  enable_sorting: false,
                  filter_type: 'vertical',
                  paginate: paginate
                %}
              </aside>
            {%- endif -%}

            <div id="ProductGridContainer">
              {% render 'gemluxjewel-plp-stone-shapes', collection: collection, section: section %}
              {% render 'gemluxjewel-collection-grid', paginate: paginate %}
            </div>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </section>
</collection-component>

{% schema %}
{
  "name": "gemluxjewel Shop Grid",
  "tag": "section",
  "class": "gemluxjewel-section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 1,
      "default": 15,
      "label": "Products per page"
    },
    {
      "type": "select",
      "id": "filter_layout",
      "label": "Filter layout",
      "default": "horizontal",
      "options": [
        { "value": "horizontal", "label": "Horizontal bar (Cullen style)" },
        { "value": "sidebar", "label": "Sidebar toggle" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "filters_open_by_default",
      "label": "Show sidebar filters by default",
      "default": false,
      "info": "Sidebar layout only."
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter toggle label",
      "default": "Show Filter"
    },
    {
      "type": "text",
      "id": "filter_hide_label",
      "label": "Filter hide label",
      "default": "Hide Filter"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "header",
      "content": "Horizontal filter bar"
    },
    {
      "type": "paragraph",
      "content": "Configure filters in Shopify Search & Discovery. Match filter labels below, then add icon blocks for dropdown images."
    },
    {
      "type": "text",
      "id": "filters_button_label",
      "label": "Filters button label",
      "default": "Filters"
    },
    {
      "type": "text",
      "id": "filters_apply_label",
      "label": "Drawer apply button",
      "default": "Apply"
    },
    {
      "type": "text",
      "id": "filters_empty_message",
      "label": "Empty filters message",
      "default": "Add filters in Shopify Search & Discovery to enable product filtering."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search by style, shape or metal"
    },
    {
      "type": "header",
      "content": "Filter label matching"
    },
    {
      "type": "paragraph",
      "content": "Must match filter names in Search & Discovery exactly."
    },
    {
      "type": "text",
      "id": "metal_filter_label",
      "label": "Metal filter label match",
      "default": "Metal",
      "info": "Must match the filter label in Search & Discovery."
    },
    {
      "type": "text",
      "id": "shape_filter_label",
      "label": "Shape filter label match",
      "default": "Stone shape"
    },
    {
      "type": "text",
      "id": "setting_filter_label",
      "label": "Setting style filter label match",
      "default": "Setting style"
    },
    {
      "type": "text",
      "id": "gemstone_filter_label",
      "label": "Gemstone type filter label match",
      "default": "Gemstone type"
    },
    {
      "type": "text",
      "id": "ring_design_filter_label",
      "label": "Ring design filter label match",
      "default": "Ring design"
    },
    {
      "type": "text",
      "id": "color_filter_label",
      "label": "Color filter label match",
      "default": "Color"
    },
    {
      "type": "header",
      "content": "Dropdown button labels"
    },
    {
      "type": "paragraph",
      "content": "Short labels shown on the filter bar buttons. Leave blank to use the Search & Discovery filter name."
    },
    {
      "type": "text",
      "id": "metal_dropdown_label",
      "label": "Metal button label",
      "default": "Metal"
    },
    {
      "type": "text",
      "id": "shape_dropdown_label",
      "label": "Shape button label",
      "default": "Stone shape"
    },
    {
      "type": "text",
      "id": "setting_dropdown_label",
      "label": "Setting style button label",
      "default": "Setting style"
    },
    {
      "type": "text",
      "id": "gemstone_dropdown_label",
      "label": "Gemstone type button label",
      "default": "Gemstone type"
    },
    {
      "type": "text",
      "id": "ring_design_dropdown_label",
      "label": "Ring design button label",
      "default": "Ring design"
    },
    {
      "type": "text",
      "id": "color_dropdown_label",
      "label": "Color button label",
      "default": "Color"
    },
    {
      "type": "header",
      "content": "Stone shapes bar"
    },
    {
      "type": "paragraph",
      "content": "Optional image grid above products. With horizontal filters, shapes appear in the Shape dropdown instead."
    },
    {
      "type": "checkbox",
      "id": "enable_stone_shapes",
      "label": "Show stone shapes image grid above products",
      "default": false
    },
    {
      "type": "text",
      "id": "stone_shapes_heading",
      "label": "Heading",
      "default": "Diamond Shapes"
    },
    {
      "type": "text",
      "id": "stone_shape_filter_label",
      "label": "Filter label",
      "default": "Stone shape"
    }
  ],
  "blocks": [
    {
      "type": "shape",
      "name": "Shape icon",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Shape name",
          "default": "Round",
          "info": "Must match the shape filter value."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Shape icon"
        }
      ]
    },
    {
      "type": "setting",
      "name": "Setting style icon",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Setting name",
          "default": "Solitaire",
          "info": "Must match the setting style filter value."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Setting icon"
        }
      ]
    },
    {
      "type": "gemstone",
      "name": "Gemstone type icon",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Gemstone name",
          "default": "Diamond",
          "info": "Must match the gemstone type filter value."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Gemstone icon"
        }
      ]
    },
    {
      "type": "ring_design",
      "name": "Ring design icon",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Ring design name",
          "default": "Solitaire",
          "info": "Must match the ring design filter value."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ring design icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Shop Grid",
      "blocks": [
        { "type": "shape", "settings": { "title": "Round" } },
        { "type": "shape", "settings": { "title": "Oval" } },
        { "type": "shape", "settings": { "title": "Emerald" } },
        { "type": "shape", "settings": { "title": "Radiant" } },
        { "type": "shape", "settings": { "title": "Pear" } },
        { "type": "shape", "settings": { "title": "Cushion" } },
        { "type": "setting", "settings": { "title": "Solitaire" } },
        { "type": "setting", "settings": { "title": "Halo" } },
        { "type": "setting", "settings": { "title": "Trilogy" } },
        { "type": "setting", "settings": { "title": "Bezel" } },
        { "type": "setting", "settings": { "title": "East-West" } },
        { "type": "setting", "settings": { "title": "Toi et Moi" } }
      ]
    }
  ]
}
{% endschema %}
