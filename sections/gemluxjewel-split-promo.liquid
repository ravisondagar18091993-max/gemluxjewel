{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-split-promo">
  <div class="gemluxjewel-container">
    {%- if section.blocks.size > 0 -%}
      <div class="gemluxjewel-split-promo__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            {% render 'gemluxjewel-split-promo-card',
              image: block.settings.image,
              title: block.settings.title,
              description: block.settings.description,
              link_label: block.settings.link_label,
              link: block.settings.link,
              seed: forloop.index,
              shopify_attributes: block.shopify_attributes
            %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "gemluxjewel Split Promo",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "card",
      "name": "Promo card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Ready When You Are"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Engagement Rings, resized and dispatched within 48 hours."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop Ready-to-ship Rings"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Split Promo",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "San Diego, We're On Our Way.",
            "description": "Our newest showroom is coming soon. Be the first to know when we open.",
            "link_label": "Get Notified When We Open",
            "link": "shopify://pages/contact"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Ready When You Are",
            "description": "Engagement Rings, resized and dispatched within 48 hours.",
            "link_label": "Shop Ready-to-ship Rings",
            "link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
