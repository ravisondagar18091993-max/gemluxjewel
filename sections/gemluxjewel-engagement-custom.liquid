{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-engagement-ring.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-engagement gemluxjewel-engagement-custom">
  <div class="gemluxjewel-container gemluxjewel-container--flush">
    <div class="gemluxjewel-engagement-custom__grid">
      <div class="gemluxjewel-engagement-custom__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              widths: '600, 900, 1200',
              sizes: '(min-width: 990px) 50vw, 100vw',
              loading: 'lazy',
              alt: section.settings.title
          }}
        {%- else -%}
          {% render 'gemluxjewel-theme-image',
            use_store_media: true,
            seed: 3,
            width: 1200,
            widths: '600,900,1200',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: section.settings.title
          %}
        {%- endif -%}
      </div>
      <div class="gemluxjewel-engagement-custom__content">
        {%- if section.settings.title != blank -%}
          <h2 class="gemluxjewel-engagement-custom__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="gemluxjewel-engagement-custom__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.root_url }}" class="gemluxjewel-engagement-btn--outline">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GL Engagement Custom",
  "tag": "section",
  "class": "gemluxjewel-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Custom Engagement Ring"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Can't find the right engagement ring in our collection? Don't worry — we can custom-make an engagement ring just for you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book Consultation"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [{ "name": "GL Engagement Custom" }]
}
{% endschema %}
