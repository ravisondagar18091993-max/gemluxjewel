{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-engagement-ring.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout_class = 'geluxjewel-engagement-showcase__grid--featurem-left'
  if section.settings.featured_position == 'right'
    assign layout_class = 'gemluxjewel-engagement-showcase__grid--feature-right'
  endif

  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections.all
  endif

  assign products_limit = 5
  assign featured_index = 0
  if section.settings.featured_position == 'left'
    assign featured_index = 4
  endif

  assign has_collection_products = false
  if collection != blank and collection.all_products_count > 0
    assign has_collection_products = true
  endif

  assign has_block_products = false
  for block in section.blocks
    if block.settings.product != blank
      assign has_block_products = true
      break
    endif
  endfor
-%}

<section class="gemluxjewel gemluxjewel-engagement gemluxjewel-engagement-showcase">
  <div class="gemluxjewel-container">
    {%- if section.settings.title != blank -%}
      <h2 class="gemluxjewel-engagement-showcase__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    {%- if has_collection_products or has_block_products or section.blocks.size > 0 -%}
      <ul class="gemluxjewel-engagement-showcase__grid {{ layout_class }}">
        {%- if has_collection_products -%}
          {%- for product in collection.products limit: products_limit -%}
            {%- liquid
              assign is_featured = false
              assign item_index = forloop.index0
              if item_index == featured_index
                assign is_featured = true
              endif

              assign item_badge = section.settings.badge_text
              if item_badge == blank
                if product.tags contains 'new' or product.tags contains 'New In' or product.tags contains 'NEW IN'
                  assign item_badge = 'NEW IN'
                endif
              endif
            -%}
            <li class="gemluxjewel-engagement-showcase__item{% if is_featured %} gemluxjewel-engagement-showcase__item--featured{% endif %}">
              {% render 'gemluxjewel-product-card',
                product: product,
                badge_text: item_badge,
                show_discount: section.settings.show_discount
              %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            <li
              class="gemluxjewel-engagement-showcase__item{% if block.settings.featured %} gemluxjewel-engagement-showcase__item--featured{% endif %}"
              {{ block.shopify_attributes }}
            >
              {% render 'gemluxjewel-product-card',
                product: block.settings.product,
                badge_text: section.settings.badge_text,
                show_discount: section.settings.show_discount
              %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="gemluxjewel-engagement-showcase__footer">
        {% render 'gemluxjewel-btn',
          label: section.settings.button_label,
          url: section.settings.button_link | default: collection.url,
          style: 'green'
        %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GL Engagement Showcase",
  "tag": "section",
  "class": "gemluxjewel-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Popular Lab Grown Diamond Rings"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Shows 5 products from this collection. Falls back to All Products when empty."
    },
    {
      "type": "select",
      "id": "featured_position",
      "label": "Large featured card position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Product badge",
      "default": "New In"
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "label": "Show discount badge",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "View all button label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "View all button link"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Large featured card",
          "default": false,
          "info": "Used only when no collection is selected."
        }
      ]
    }
  ],
  "presets": [{ "name": "GL Engagement Showcase" }]
}
{% endschema %}
