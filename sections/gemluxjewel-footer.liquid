{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-footer.css' | asset_url | stylesheet_tag }}

<footer class="gemluxjewel gemluxjewel-footer">
  {%- if section.settings.show_trust_bar and section.blocks.size > 0 -%}
    <div class="gemluxjewel-footer__trust">
      <div class="gemluxjewel-container">
        <ul class="gemluxjewel-footer__trust-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_item' -%}
              <li class="gemluxjewel-footer__trust-item" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="gemluxjewel-footer__trust-link">
                {%- else -%}
                  <div class="gemluxjewel-footer__trust-link">
                {%- endif -%}
                  <span class="gemluxjewel-footer__trust-icon">
                    {%- if block.settings.custom_icon != blank -%}
                      {{
                        block.settings.custom_icon
                        | image_url: width: 96
                        | image_tag: widths: '48, 96', sizes: '48px', loading: 'lazy', alt: ''
                      }}
                    {%- else -%}
                      {% render 'gemluxjewel-footer-trust-icon', icon: block.settings.icon %}
                    {%- endif -%}
                  </span>
                  {%- if block.settings.line_1 != blank or block.settings.line_2 != blank -%}
                    <span class="gemluxjewel-footer__trust-label">
                      {%- if block.settings.line_1 != blank -%}
                        <span>{{ block.settings.line_1 | escape }}</span>
                      {%- endif -%}
                      {%- if block.settings.line_2 != blank -%}
                        <span>{{ block.settings.line_2 | escape }}</span>
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}

  <div class="gemluxjewel-footer__body">
  <div class="gemluxjewel-footer__pattern" aria-hidden="true"></div>

  <div class="gemluxjewel-container">
    <div class="gemluxjewel-footer__subscribe">
      <div class="gemluxjewel-footer__subscribe-form">
        {%- if section.settings.subscribe_label != blank -%}
          <span class="gemluxjewel-footer__subscribe-label">{{ section.settings.subscribe_label | escape }}</span>
        {%- endif -%}
        {%- form 'customer', id: 'gemluxjewelFooterNewsletter', class: 'gemluxjewel-footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="gemluxjewel-footer__newsletter-field">
            <input
              type="email"
              name="contact[email]"
              class="gemluxjewel-footer__newsletter-input"
              placeholder="{{ section.settings.newsletter_placeholder | default: 'Sign Me Up' }}"
              autocomplete="email"
              required
              {% if form.posted_successfully? %}aria-describedby="gemluxjewelFooterNewsletter-success"{% endif %}
            >
            <button type="submit" class="gemluxjewel-footer__newsletter-submit" aria-label="{{ 'newsletter.button_label' | t }}">
              <img src="{{ 'right-arrow.svg' | asset_url }}" alt="" width="20" height="20">
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p id="gemluxjewelFooterNewsletter-success" class="gemluxjewel-footer__newsletter-message">
              {{ 'newsletter.success' | t }}
            </p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="gemluxjewel-footer__newsletter-message">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>

      <div class="gemluxjewel-footer__promo">
        {%- if section.settings.promo_heading != blank -%}
          <p class="gemluxjewel-footer__promo-heading">{{ section.settings.promo_heading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.promo_text != blank -%}
          <p class="gemluxjewel-footer__promo-text">{{ section.settings.promo_text | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="gemluxjewel-footer__main">
      <div class="gemluxjewel-footer__columns">
        <div class="gemluxjewel-footer__column gemluxjewel-footer__column--brand">
          <div class="gemluxjewel-footer__brand">
            <a href="{{ routes.root_url }}" class="gemluxjewel-footer__brand-logo">
              {%- if section.settings.brand_logo != blank -%}
                {{
                  section.settings.brand_logo
                  | image_url: width: 280
                  | image_tag:
                    widths: '140, 280',
                    sizes: '160px',
                    loading: 'lazy',
                    alt: section.settings.brand_logo_text | default: shop.name
                }}
              {%- else -%}
                <span class="gemluxjewel-footer__brand-logo-text">
                  {{ section.settings.brand_logo_text | default: shop.name | escape }}
                </span>
              {%- endif -%}
            </a>
            {%- if section.settings.brand_description != blank -%}
              <p class="gemluxjewel-footer__brand-description">{{ section.settings.brand_description | escape }}</p>
            {%- endif -%}
          </div>
        </div>

        {% comment %} {%- for i in (1..5) -%}
          {%- liquid
            assign title_key = 'menu_' | append: i | append: '_title'
            assign menu_key = 'menu_' | append: i
            assign column_title = section.settings[title_key]
            assign column_menu = section.settings[menu_key]
          -%}
          {%- if column_title != blank or column_menu != blank or i == 2 or i == 1 or i == 4 -%}
            <div class="gemluxjewel-footer__column">
              {%- if column_title != blank -%}
                <p class="gemluxjewel-footer__column-title">{{ column_title | escape }}</p>
              {%- endif -%}

              {%- if i == 2 -%}
                {%- if column_menu != blank -%}
                  <ul class="gemluxjewel-footer__links">
                    {%- for link in column_menu.links -%}
                      <li><a href="{{ link.url }}" class="gemluxjewel-footer__link">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  {% render 'gemluxjewel-footer-dummy-links', column: 2 %}
                {%- endif -%}
              {%- elsif column_menu != blank -%}
                <ul class="gemluxjewel-footer__links">
                  {%- for link in column_menu.links -%}
                    <li><a href="{{ link.url }}" class="gemluxjewel-footer__link">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- elsif i == 1 or i == 4 -%}
                {% render 'gemluxjewel-footer-dummy-links', column: i %}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%} {% endcomment %}

        {%- for i in (1..5) -%}
  {%- liquid
    assign title_key = 'menu_' | append: i | append: '_title'
    assign menu_key = 'menu_' | append: i
    assign column_title = section.settings[title_key]
    assign column_menu = section.settings[menu_key]
  -%}
  {%- if column_title != blank or column_menu != blank or i == 2 or i == 1 or i == 4 -%}
    <div class="gemluxjewel-footer__column">
      <details class="gemluxjewel-footer__accordion" close>
        {%- if column_title != blank -%}
          <summary class="gemluxjewel-footer__column-title">{{ column_title | escape }}</summary>
        {%- endif -%}
        <div class="gemluxjewel-footer__accordion-content">
          {%- if i == 2 -%}
            {%- if column_menu != blank -%}
              <ul class="gemluxjewel-footer__links">
                {%- for link in column_menu.links -%}
                  <li><a href="{{ link.url }}" class="gemluxjewel-footer__link">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              {% render 'gemluxjewel-footer-dummy-links', column: 2 %}
            {%- endif -%}
          {%- elsif column_menu != blank -%}
            <ul class="gemluxjewel-footer__links">
              {%- for link in column_menu.links -%}
                <li><a href="{{ link.url }}" class="gemluxjewel-footer__link">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- elsif i == 1 or i == 4 -%}
            {% render 'gemluxjewel-footer-dummy-links', column: i %}
          {%- endif -%}
        </div>
      </details>
    </div>
  {%- endif -%}
{%- endfor -%}
      </div>
    </div>



    <div class="gemluxjewel-footer__social">
      {%- if settings.social_facebook_link != blank -%}
        <a href="{{ settings.social_facebook_link }}" class="gemluxjewel-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <img src="{{ 'white-facebook.svg' | asset_url }}" alt="" width="22" height="22">
        </a>
      {%- else -%}
        <a href="#" class="gemluxjewel-footer__social-link" aria-label="Facebook">
          <img src="{{ 'white-facebook.svg' | asset_url }}" alt="" width="22" height="22">
        </a>
      {%- endif -%}
      {%- if settings.social_instagram_link != blank -%}
        <a href="{{ settings.social_instagram_link }}" class="gemluxjewel-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <img src="{{ 'white-instagram.svg' | asset_url }}" alt="" width="22" height="22">
        </a>
      {%- else -%}
        <a href="#" class="gemluxjewel-footer__social-link" aria-label="Instagram">
          <img src="{{ 'white-instagram.svg' | asset_url }}" alt="" width="22" height="22">
        </a>
      {%- endif -%}
      {%- if section.settings.youtube_url != blank -%}
        <a href="{{ section.settings.youtube_url }}" class="gemluxjewel-footer__social-link gemluxjewel-footer__social-link--text" target="_blank" rel="noopener noreferrer" aria-label="YouTube">Y</a>
      {%- else -%}
        <a href="#" class="gemluxjewel-footer__social-link gemluxjewel-footer__social-link--text" aria-label="YouTube">Y</a>
      {%- endif -%}
      {%- if settings.social_twitter_link != blank -%}
        <a href="{{ settings.social_twitter_link }}" class="gemluxjewel-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="X">
          <img src="{{ 'white-twitter.svg' | asset_url }}" alt="" width="22" height="22">
        </a>
      {%- else -%}
        <a href="#" class="gemluxjewel-footer__social-link" aria-label="X">
          <img src="{{ 'white-twitter.svg' | asset_url }}" alt="" width="22" height="22">
        </a>
      {%- endif -%}
      {%- if section.settings.pinterest_url != blank -%}
        <a href="{{ section.settings.pinterest_url }}" class="gemluxjewel-footer__social-link gemluxjewel-footer__social-link--text" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
          P
        </a>
      {%- else -%}
        <a href="#" class="gemluxjewel-footer__social-link gemluxjewel-footer__social-link--text" aria-label="Pinterest">P</a>
      {%- endif -%}
      {%- if section.settings.linkedin_url != blank -%}
        <a href="{{ section.settings.linkedin_url }}" class="gemluxjewel-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <img src="{{ 'white-linkedin.svg' | asset_url }}" alt="" width="22" height="22">
        </a>
      {%- endif -%}
    </div>

    <div class="gemluxjewel-footer__bar">
      <p class="gemluxjewel-footer__copyright">
        {%- if section.settings.copyright_text != blank -%}
          {{ section.settings.copyright_text | escape }}
        {%- else -%}
          © {{ shop.name | escape }} {{ 'now' | date: '%Y' }}
        {%- endif -%}
      </p>
      {%- if section.settings.legal_menu != blank -%}
        <nav class="gemluxjewel-footer__legal" aria-label="Legal">
          {%- for link in section.settings.legal_menu.links -%}
            <a href="{{ link.url }}" class="gemluxjewel-footer__legal-link">{{ link.title | escape }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>
  </div>
  </div>
</footer>

{% schema %}
{
  "name": "gemluxjewel Footer",
  "tag": "section",
  "class": "gemluxjewel-section",
  "settings": [
    {
      "type": "header",
      "content": "Trust bar"
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Show trust bar above footer",
      "default": true
    },
    {
      "type": "header",
      "content": "Subscribe bar"
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Subscribe label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Sign Me Up"
    },
    {
      "type": "text",
      "id": "promo_heading",
      "label": "Promo heading",
      "default": "Join our guest list and receive exclusive access to new collections, offers, and events."
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promo offer text",
      "default": "Enjoy $100 off your first order*"
    },
    {
      "type": "header",
      "content": "Contact column"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+1 000 000 0000"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hello@gemluxjewel.com"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours",
      "default": "Mon–Fri: 9am–6pm EST"
    },
    {
      "type": "url",
      "id": "directions_url",
      "label": "Directions link"
    },
    {
      "type": "text",
      "id": "directions_label",
      "label": "Directions label",
      "default": "Get Directions"
    },
    {
      "type": "header",
      "content": "Brand column"
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "brand_logo_text",
      "label": "Logo text",
      "default": "GEMLUXJEWEL",
      "info": "Shown when no logo image is uploaded"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "Timeless lab-grown diamond and moissanite jewellery, crafted with exceptional quality and personalized service."
    },
    {
      "type": "header",
      "content": "Link columns"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Column 1 title",
      "default": "Brand Info"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Column 1 menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Column 2 title",
      "default": "Contact Info"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Column 2 menu (optional — uses example links when empty)"
    },
    {
      "type": "text",
      "id": "menu_3_title",
      "label": "Column 3 title",
      "default": "Support"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Column 3 menu"
    },
    {
      "type": "text",
      "id": "menu_4_title",
      "label": "Column 4 title",
      "default": "Education"
    },
    {
      "type": "link_list",
      "id": "menu_4",
      "label": "Column 4 menu"
    },
    {
      "type": "text",
      "id": "menu_5_title",
      "label": "Column 5 title",
      "default": "Jewelry Guide"
    },
    {
      "type": "link_list",
      "id": "menu_5",
      "label": "Column 5 menu"
    },
    {
      "type": "header",
      "content": "Social & legal"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal links menu"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright prefix",
      "default": "© gemluxjewel"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shipping",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "resizing", "label": "Resizing" },
            { "value": "warranty", "label": "Warranty" },
            { "value": "customization", "label": "Customization" }
          ]
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Optional — replaces the default icon"
        },
        {
          "type": "text",
          "id": "line_1",
          "label": "Label line 1",
          "default": "Worldwide"
        },
        {
          "type": "text",
          "id": "line_2",
          "label": "Label line 2",
          "default": "Express Shipping"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Footer",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "shipping",
            "line_1": "Worldwide",
            "line_2": "Express Shipping"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "resizing",
            "line_1": "Free",
            "line_2": "Resizing"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "warranty",
            "line_1": "Lifetime Ring",
            "line_2": "Warranty"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "customization",
            "line_1": "Free Ring",
            "line_2": "Customisation"
          }
        }
      ]
    }
  ]
}
{% endschema %}
