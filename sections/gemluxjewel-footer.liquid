      "default": "Enjoy $100 off your first order*"
    },
    {
      "type": "header",
      "content": "Contact column"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+1 000 000 0000"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hello@gemluxjewel.com"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours",
      "default": "Mon–Fri: 9am–6pm EST"
    },
    {
      "type": "url",
      "id": "directions_url",
      "label": "Directions link"
    },
    {
      "type": "text",
      "id": "directions_label",
