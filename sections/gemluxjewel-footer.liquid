{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-footer.css' | asset_url | stylesheet_tag }}

<footer class="gemluxjewel gemluxjewel-footer">
  <div class="gemluxjewel-footer__pattern" aria-hidden="true"></div>

  <div class="gemluxjewel-container">
    <div class="gemluxjewel-footer__subscribe">
      <div class="gemluxjewel-footer__subscribe-form">
        {%- if section.settings.subscribe_label != blank -%}
          <span class="gemluxjewel-footer__subscribe-label">{{ section.settings.subscribe_label | escape }}</span>
        {%- endif -%}
        {%- form 'customer', id: 'gemluxjewelFooterNewsletter', class: 'gemluxjewel-footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="gemluxjewel-footer__newsletter-field">
            <input
              type="email"
              name="contact[email]"
              class="gemluxjewel-footer__newsletter-input"
              placeholder="{{ section.settings.newsletter_placeholder | default: 'Sign Me Up' }}"
              autocomplete="email"
              required
              {% if form.posted_successfully? %}aria-describedby="gemluxjewelFooterNewsletter-success"{% endif %}
            >
            <button type="submit" class="gemluxjewel-footer__newsletter-submit" aria-label="{{ 'newsletter.button_label' | t }}">
              <img src="{{ 'right-arrow.svg' | asset_url }}" alt="" width="20" height="20">
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p id="gemluxjewelFooterNewsletter-success" class="gemluxjewel-footer__newsletter-message">
              {{ 'newsletter.success' | t }}
            </p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="gemluxjewel-footer__newsletter-message">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>

      <div class="gemluxjewel-footer__promo">
        {%- if section.settings.promo_heading != blank -%}
          <p class="gemluxjewel-footer__promo-heading">{{ section.settings.promo_heading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.promo_text != blank -%}
          <p class="gemluxjewel-footer__promo-text">{{ section.settings.promo_text | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="gemluxjewel-footer__main">
      <div class="gemluxjewel-footer__columns">
        {%- for i in (1..5) -%}
          {%- liquid
            assign title_key = 'menu_' | append: i | append: '_title'
            assign menu_key = 'menu_' | append: i
            assign column_title = section.settings[title_key]
            assign column_menu = section.settings[menu_key]
          -%}
          {%- if column_title != blank or column_menu != blank or i == 2 -%}
            <div class="gemluxjewel-footer__column">
              {%- if column_title != blank -%}
                <p class="gemluxjewel-footer__column-title">{{ column_title | escape }}</p>
              {%- endif -%}

              {%- if i == 2 -%}
                <ul class="gemluxjewel-footer__links">
                  {%- if section.settings.phone != blank -%}
                    <li>
                      <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}" class="gemluxjewel-footer__link">
                        {{ section.settings.phone | escape }}
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if section.settings.email != blank -%}
                    <li>
                      <a href="mailto:{{ section.settings.email }}" class="gemluxjewel-footer__link">
                        {{ section.settings.email | escape }}
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if section.settings.address != blank -%}
                    <li><span class="gemluxjewel-footer__link gemluxjewel-footer__link--text">{{ section.settings.address }}</span></li>
                  {%- endif -%}
                  {%- if section.settings.hours != blank -%}
                    <li><span class="gemluxjewel-footer__link gemluxjewel-footer__link--text">{{ section.settings.hours }}</span></li>
                  {%- endif -%}
                  {%- if section.settings.directions_url != blank -%}
                    <li>
                      <a href="{{ section.settings.directions_url }}" class="gemluxjewel-footer__link" target="_blank" rel="noopener noreferrer">
                        {{ section.settings.directions_label | default: 'Get Directions' | escape }}
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
              {%- elsif column_menu != blank -%}
                <ul class="gemluxjewel-footer__links">
                  {%- for link in column_menu.links -%}
                    <li><a href="{{ link.url }}" class="gemluxjewel-footer__link">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="gemluxjewel-footer__social">
      {%- if settings.social_facebook_link != blank -%}
        <a href="{{ settings.social_facebook_link }}" class="gemluxjewel-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <img src="{{ 'white-facebook.svg' | asset_url }}" alt="" width="22" height="22">
        </a>
      {%- endif -%}
      {%- if settings.social_instagram_link != blank -%}
        <a href="{{ settings.social_instagram_link }}" class="gemluxjewel-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <img src="{{ 'white-instagram.svg' | asset_url }}" alt="" width="22" height="22">
        </a>
      {%- endif -%}
      {%- if section.settings.pinterest_url != blank -%}
        <a href="{{ section.settings.pinterest_url }}" class="gemluxjewel-footer__social-link gemluxjewel-footer__social-link--text" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
          P
        </a>
      {%- endif -%}
      {%- if settings.social_twitter_link != blank -%}
        <a href="{{ settings.social_twitter_link }}" class="gemluxjewel-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="X">
          <img src="{{ 'white-twitter.svg' | asset_url }}" alt="" width="22" height="22">
        </a>
      {%- endif -%}
      {%- if section.settings.linkedin_url != blank -%}
        <a href="{{ section.settings.linkedin_url }}" class="gemluxjewel-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <img src="{{ 'white-linkedin.svg' | asset_url }}" alt="" width="22" height="22">
        </a>
      {%- endif -%}
    </div>

    <div class="gemluxjewel-footer__bar">
      <p class="gemluxjewel-footer__copyright">
        {%- if section.settings.copyright_text != blank -%}
          {{ section.settings.copyright_text | escape }}
        {%- else -%}
          © {{ shop.name | escape }} {{ 'now' | date: '%Y' }}
        {%- endif -%}
      </p>
      {%- if section.settings.legal_menu != blank -%}
        <nav class="gemluxjewel-footer__legal" aria-label="Legal">
          {%- for link in section.settings.legal_menu.links -%}
            <a href="{{ link.url }}" class="gemluxjewel-footer__legal-link">{{ link.title | escape }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>
  </div>
</footer>

