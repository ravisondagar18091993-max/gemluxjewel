      "default": "Get Directions"
    },
    {
      "type": "header",
      "content": "Link columns"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Column 1 title",
      "default": "About Us"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Column 1 menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Column 2 title",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "menu_3_title",
      "label": "Column 3 title",
      "default": "Support"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Column 3 menu"
    },
    {
      "type": "text",
      "id": "menu_4_title",
      "label": "Column 4 title",
      "default": "Education"
    },
    {
      "type": "link_list",
      "id": "menu_4",
      "label": "Column 4 menu"
    },
    {
      "type": "text",
      "id": "menu_5_title",
      "label": "Column 5 title",
      "default": "Jewelry Guide"
    },
    {
      "type": "link_list",
      "id": "menu_5",
      "label": "Column 5 menu"
    },
    {
      "type": "header",
      "content": "Social & legal"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
