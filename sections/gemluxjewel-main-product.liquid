{% render 'gemluxjewel-fonts' %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
{{ 'section-gemluxjewel-product.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-pdp-ref.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'gemluxjewel-pdp.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'gemluxjewel-collection-slider.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign badge_text = ''
  if product.tags contains 'new' or product.tags contains 'New In' or product.tags contains 'NEW IN'
    assign badge_text = 'NEW IN'
  endif

  assign back_url = collection.url
  if back_url == blank and product.collections.first
    assign back_url = product.collections.first.url
  endif
  if back_url == blank
    assign back_url = routes.all_products_collection_url
  endif

  assign breadcrumb_collection = collection.title
  if breadcrumb_collection == blank and product.collections.first
    assign breadcrumb_collection = product.collections.first.title
  endif
-%}

<product-info
  id="MainProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
>
  <section class="gemluxjewel gemluxjewel-pdp gemluxjewel-pdp--ref">
    <div class="gemluxjewel-container gemluxjewel-pdp__container">
      <div class="gemluxjewel-pdp__layout">
        <div class="gemluxjewel-pdp__gallery-col">
          <nav class="gemluxjewel-pdp__breadcrumb" aria-label="Breadcrumb">
            <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home | default: 'Home' | escape }}</a>
            <span class="gemluxjewel-pdp__breadcrumb-sep">/</span>
            <span class="gemluxjewel-pdp__breadcrumb-current">{{ product.title | escape }}</span>
          </nav>
          {% render 'gemluxjewel-pdp-gallery' %}
        </div>

        <div class="gemluxjewel-pdp__info">
          <div class="gemluxjewel-pdp__title-row">
            <h1 class="gemluxjewel-pdp__title">{{ product.title | escape }}</h1>
            <button
              type="button"
              class="gemluxjewel-pdp__heart"
              data-gemluxjewel-wishlist-heart
              data-product-id="{{ product.id }}"
              aria-label="Add to wishlist"
              aria-pressed="false"
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" stroke="currentColor" stroke-width="1.5" fill="none"/>
              </svg>
            </button>
          </div>

          {%- if section.settings.show_sku and current_variant.sku != blank -%}
            <p class="gemluxjewel-pdp__sku">SKU: {{ current_variant.sku | escape }}</p>
          {%- endif -%}

          {%- if section.settings.show_specs_row -%}
            <p class="gemluxjewel-pdp__specs">
              {%- if product.metafields.custom.specs != blank -%}
                {{ product.metafields.custom.specs }}
              {%- else -%}
                {{ section.settings.default_specs | escape }}
              {%- endif -%}
            </p>
          {%- endif -%}

          <div id="price-{{ section.id }}" role="status">
            {% render 'gemluxjewel-pdp-price' %}
          </div>

          <div class="gemluxjewel-pdp__variants-block">
            {% render 'gemluxjewel-pdp-variant-picker' %}
          </div>

          <product-form class="product-form" data-section-id="{{ section.id }}">
            {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input
                type="hidden"
                name="id"
                value="{{ current_variant.id }}"
                {% if current_variant.available == false %}disabled{% endif %}
                class="product-variant-id"
              >

              <div class="gemluxjewel-pdp__actions">
                <button
                  type="submit"
                  name="add"
                  id="ProductSubmitButton-{{ section.id }}"
                  class="gemluxjewel-pdp__submit gemluxjewel-pdp__submit--full"
                  {% if current_variant.available == false %}disabled{% endif %}
                >
                  <span class="gemluxjewel-pdp__submit-label">
                    {%- if current_variant.available -%}
                      {{ section.settings.add_to_cart_label | default: 'Add to Cart' | escape }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                  {%- render 'loading-spinner' -%}
                </button>

                {%- if section.settings.show_wishlist_button -%}
                  <button
                    type="button"
                    class="gemluxjewel-pdp__wishlist-btn"
                    data-gemluxjewel-wishlist-btn
                    data-product-id="{{ product.id }}"
                    data-product-handle="{{ product.handle | escape }}"
                    data-variant-id="{{ current_variant.id }}"
                    data-label-add="{{ section.settings.wishlist_label | default: 'Add to Wishlist' | escape }}"
                    data-label-added="{{ section.settings.wishlist_added_label | default: 'In Wishlist' | escape }}"
                    {% if section.settings.wishlist_url != blank %}data-wishlist-url="{{ section.settings.wishlist_url | escape }}"{% endif %}
                    aria-pressed="false"
                    aria-label="{{ section.settings.wishlist_label | default: 'Add to Wishlist' | escape }}"
                  >
                    <svg class="gemluxjewel-pdp__wishlist-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" stroke="currentColor" stroke-width="1.5" fill="none"/>
                    </svg>
                    <span class="gemluxjewel-pdp__wishlist-label" data-gemluxjewel-wishlist-label>
                      {{ section.settings.wishlist_label | default: 'Add to Wishlist' | escape }}
                    </span>
                  </button>
                {%- endif -%}
              </div>
            {%- endform -%}
          </product-form>

          {%- if section.settings.show_consultation or section.settings.show_inline_trust -%}
            <div class="gemluxjewel-pdp__support-zone">
              {%- if section.settings.show_consultation -%}
                <div class="gemluxjewel-pdp__consultation">
                  <p class="gemluxjewel-pdp__consultation-line">
                    {%- if section.settings.consultation_intro != blank -%}
                      <span class="gemluxjewel-pdp__consultation-intro">{{ section.settings.consultation_intro | escape }}</span>
                    {%- endif -%}
                    {%- if section.settings.consultation_url != blank -%}
                      <a
                        href="{{ section.settings.consultation_url }}"
                        class="gemluxjewel-pdp__consultation-link"
                        {% if section.settings.consultation_open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                      >
                        {{ section.settings.consultation_label | default: 'Book a Virtual Consultation' | escape }}
                      </a>
                    {%- elsif section.settings.consultation_label != blank -%}
                      <span class="gemluxjewel-pdp__consultation-link gemluxjewel-pdp__consultation-link--static">
                        {{ section.settings.consultation_label | escape }}
                      </span>
                    {%- endif -%}
                  </p>
                </div>
              {%- endif -%}

              {%- if section.settings.show_inline_trust -%}
                {% render 'gemluxjewel-pdp-trust-inline' %}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- liquid
            assign show_description = false
            if section.settings.show_description and product.description != blank
              assign show_description = true
            endif

            assign show_info_accordion = false
            if show_description or section.settings.ring_size_content != blank or section.settings.ring_details_content != blank
              assign show_info_accordion = true
            endif
          -%}

          {%- if show_info_accordion -%}
            <div class="gemluxjewel-pdp__accordian-block gemluxjewel-pdp__info-accordion">
              <div class="gemluxjewel-pdp__product-accordian">
                <div class="closet-accordion" data-gemluxjewel-accordion>
                  {%- liquid
                    assign default_open = section.settings.accordion_default_open | default: 'none'
                  -%}
                  {%- if show_description -%}
                    {% render 'gemluxjewel-pdp-accordion-item',
                      title: section.settings.description_title,
                      content: product.description,
                      open_by_default: default_open == 'overview'
                    %}
                  {%- endif -%}

                  {% render 'gemluxjewel-pdp-accordion-item',
                    title: section.settings.ring_size_title,
                    content: section.settings.ring_size_content,
                    open_by_default: default_open == 'ring_size'
                  %}

                  {% render 'gemluxjewel-pdp-accordion-item',
                    title: section.settings.ring_details_title,
                    content: section.settings.ring_details_content,
                    open_by_default: default_open == 'ring_details'
                  %}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.show_complete_set -%}
            {% render 'gemluxjewel-pdp-complete-set', product: product, section: section %}
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
</product-info>

{% schema %}
{
  "name": "gemluxjewel Main Product",
  "tag": "section",
  "class": "gemluxjewel-section",
  "settings": [
    {
      "type": "text",
      "id": "breadcrumb_home",
      "label": "Breadcrumb home",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "breadcrumb_collections",
      "label": "Breadcrumb collections",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back link label",
      "default": "Return to Store"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to Cart"
    },
    {
      "type": "header",
      "content": "Wishlist button"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist_button",
      "label": "Show wishlist button next to add to cart",
      "default": true
    },
    {
      "type": "text",
      "id": "wishlist_label",
      "label": "Wishlist button label",
      "default": "Add to Wishlist"
    },
    {
      "type": "text",
      "id": "wishlist_added_label",
      "label": "Wishlist button label when added",
      "default": "In Wishlist"
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist page URL (optional)",
      "info": "Optional. Used by some wishlist apps. Leave blank to save items in the browser."
    },
    {
      "type": "text",
      "id": "size_guide_label",
      "label": "Ring size guide label",
      "default": "FIND RING SIZE"
    },
    {
      "type": "url",
      "id": "size_guide_url",
      "label": "Ring size guide link"
    },
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "checkbox",
      "id": "show_specs_row",
      "label": "Show specs line",
      "default": true
    },
    {
      "type": "text",
      "id": "default_specs",
      "label": "Default specs (when product metafield empty)",
      "default": "Lab Grown Diamond • Dutch Marquise Cut • F Color • 1.00 To 4.00 CT • VS Clarity"
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": true
    },
    {
      "type": "header",
      "content": "Virtual consultation button"
    },
    {
      "type": "checkbox",
      "id": "show_consultation",
      "label": "Show consultation button",
      "default": true
    },
    {
      "type": "text",
      "id": "consultation_intro",
      "label": "Text above button",
      "default": "Have Questions?"
    },
    {
      "type": "text",
      "id": "consultation_label",
      "label": "Button label",
      "default": "Book a Virtual Consultation"
    },
    {
      "type": "url",
      "id": "consultation_url",
      "label": "Button link",
      "info": "Add your booking page, contact page, or Calendly URL."
    },
    {
      "type": "checkbox",
      "id": "consultation_open_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Inline trust badges"
    },
    {
      "type": "checkbox",
      "id": "show_inline_trust",
      "label": "Show trust badges below add to cart",
      "default": true
    },
    { "type": "text", "id": "trust_label_1", "label": "Trust 1", "default": "Worldwide Shipping" },
    { "type": "image_picker", "id": "trust_icon_1", "label": "Trust icon 1" },
    { "type": "text", "id": "trust_label_2", "label": "Trust 2", "default": "Free and Secure Shipping" },
    { "type": "image_picker", "id": "trust_icon_2", "label": "Trust icon 2" },
    { "type": "text", "id": "trust_label_3", "label": "Trust 3", "default": "100% Diamond Value Guarantee" },
    { "type": "image_picker", "id": "trust_icon_3", "label": "Trust icon 3" },
    { "type": "text", "id": "trust_label_4", "label": "Trust 4", "default": "30 Day Return or Exchange" },
    { "type": "image_picker", "id": "trust_icon_4", "label": "Trust icon 4" },
    {
      "type": "header",
      "content": "Accordions"
    },
    {
      "type": "select",
      "id": "accordion_default_open",
      "label": "Open accordion by default",
      "options": [
        { "value": "none", "label": "None (all collapsed)" },
        { "value": "overview", "label": "Overview" },
        { "value": "ring_size", "label": "Ring Size" },
        { "value": "ring_details", "label": "Ring Details" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show overview accordion",
      "default": true
    },
    {
      "type": "text",
      "id": "description_title",
      "label": "Overview title",
      "default": "Overview"
    },
    {
      "type": "text",
      "id": "ring_size_title",
      "label": "Ring size title",
      "default": "Ring Size"
    },
    {
      "type": "richtext",
      "id": "ring_size_content",
      "label": "Ring size content",
      "default": "<p>We offer complimentary resizing within 30 days of delivery. Refer to our ring size guide to find your perfect fit.</p>"
    },
    {
      "type": "text",
      "id": "ring_details_title",
      "label": "Ring details title",
      "default": "Ring Details"
    },
    {
      "type": "richtext",
      "id": "ring_details_content",
      "label": "Ring details content",
      "default": "<p>Metal options include sterling silver, solid gold (10K, 14K, 18K), and platinum. Center stone is lab grown diamond. All rings are handcrafted to order.</p>"
    },
    {
      "type": "header",
      "content": "Complete the set"
    },
    {
      "type": "paragraph",
      "content": "On each product in Admin, open Metafields and add products to Complete The Set (custom.complete_the_set). Selected products appear in the slider. If empty, Shopify complementary recommendations are used when fallback is enabled."
    },
    {
      "type": "checkbox",
      "id": "show_complete_set",
      "label": "Show Complete The Set carousel",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "complete_set_use_recommendations_fallback",
      "label": "Use Shopify recommendations when metafield is empty",
      "default": true
    },
    {
      "type": "text",
      "id": "complete_set_heading",
      "label": "Heading",
      "default": "Complete The Set"
    },
    {
      "type": "range",
      "id": "complete_set_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Main Product"
    }
  ]
}
{% endschema %}
