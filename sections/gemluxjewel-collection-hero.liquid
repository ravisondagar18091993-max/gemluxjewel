{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-shop.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = collection.image
  if hero_image == blank and section.settings.image != blank
    assign hero_image = section.settings.image
  endif
  assign has_bg_image = true
  if section.settings.hide_image
    assign has_bg_image = false
  endif
-%}

<section class="gemluxjewel gemluxjewel-collection-hero{% unless has_bg_image %} gemluxjewel-collection-hero--solid{% endunless %}">
  {%- if has_bg_image -%}
    <div class="gemluxjewel-collection-hero__bg" aria-hidden="true">
      {%- if hero_image != blank -%}
        {{
          hero_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: ''
        }}
      {%- else -%}
        {% render 'gemluxjewel-theme-image',
          asset: 'sub-hero-img.png',
          width: 2400,
          widths: '750,1100,1500,2000,2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
        %}
      {%- endif -%}
      <div class="gemluxjewel-collection-hero__overlay"></div>
    </div>
  {%- endif -%}

  <div class="gemluxjewel-container">
    <div class="gemluxjewel-collection-hero__content">
      <p class="gemluxjewel-collection-hero__breadcrumb">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home | default: 'Home' | escape }}</a>
        |
        {%- if section.settings.breadcrumb_collections_link != blank -%}
          <a href="{{ section.settings.breadcrumb_collections_link }}">{{ section.settings.breadcrumb_collections | default: 'Collections' | escape }}</a>
        {%- else -%}
          {{ section.settings.breadcrumb_collections | default: 'Collections' | escape }}
        {%- endif -%}
        |
        <span>{{ collection.title | escape }}</span>
      </p>
      <h1 class="gemluxjewel-collection-hero__title">{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}
        <div class="gemluxjewel-collection-hero__desc">{{ collection.description }}</div>
      {%- elsif section.settings.fallback_description != blank -%}
        <p class="gemluxjewel-collection-hero__desc">{{ section.settings.fallback_description | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "gemluxjewel Coll Hero",
  "tag": "section",
  "class": "gemluxjewel-section",
  "settings": [
    {
      "type": "text",
      "id": "breadcrumb_home",
      "label": "Breadcrumb home label",
      "default": "HOME"
    },
    {
      "type": "text",
      "id": "breadcrumb_collections",
      "label": "Breadcrumb collections label",
      "default": "COLLECTIONS"
    },
    {
      "type": "url",
      "id": "breadcrumb_collections_link",
      "label": "Collections link"
    },
    {
      "type": "textarea",
      "id": "fallback_description",
      "label": "Fallback description",
      "default": "Elegant, timeless jewellery crafted for lasting beauty and everyday luxury."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Full-width background. Uses collection image first, then this setting, then the default shop image."
    },
    {
      "type": "checkbox",
      "id": "hide_image",
      "label": "Use solid green background only",
      "default": false
    }
  ]
}
{% endschema %}
