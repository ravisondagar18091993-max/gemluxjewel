{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-custom-jewellery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gemluxjewel-custom-jewellery.js' | asset_url }}" defer="defer"></script>

{%- assign portfolio_image_sizes = '(min-width: 1200px) 320px, (min-width: 990px) 280px, (min-width: 750px) 45vw, 85vw' -%}

<section class="gemluxjewel gemluxjewel-custom-portfolio">
  <div class="gemluxjewel-container">
    <div class="gemluxjewel-section-header gemluxjewel-section-header--center">
      <div>
        {%- if section.settings.prefix != blank -%}
          <p class="gemluxjewel-prefix">{{ section.settings.prefix | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="gemluxjewel-section-title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="gemluxjewel-section-desc">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="gemluxjewel-custom-portfolio__slider" data-gemluxjewel-custom-portfolio>
        <button
          type="button"
          class="gemluxjewel-custom-portfolio__nav gemluxjewel-custom-portfolio__nav--prev"
          data-gemluxjewel-custom-portfolio-prev
          aria-label="Previous"
          disabled
        >
          <img src="{{ 'green-right-arrow.svg' | asset_url }}" alt="" width="16" height="16" class="gemluxjewel-custom-portfolio__nav-icon gemluxjewel-custom-portfolio__nav-icon--prev">
        </button>

        <div class="gemluxjewel-custom-portfolio__viewport">
          <div class="gemluxjewel-custom-portfolio__track" data-gemluxjewel-custom-portfolio-track>
            {%- for block in section.blocks -%}
              {%- liquid
                assign item_title = block.settings.title
                assign item_url = block.settings.link
                assign item_image = block.settings.image
              -%}

              {%- if item_url != blank -%}
                <a href="{{ item_url }}" class="gemluxjewel-custom-portfolio__item" {{ block.shopify_attributes }}>
              {%- else -%}
                <div class="gemluxjewel-custom-portfolio__item" {{ block.shopify_attributes }}>
              {%- endif -%}
                <div class="gemluxjewel-custom-portfolio__img">
                  {%- if item_image != blank -%}
                    {{
                      item_image
                      | image_url: width: 800
                      | image_tag:
                        widths: '300, 400, 600, 800',
                        sizes: portfolio_image_sizes,
                        loading: 'lazy',
                        alt: item_title
                    }}
                  {%- else -%}
                    {% render 'gemluxjewel-theme-image',
                      use_store_media: true,
                      seed: forloop.index,
                      width: 600,
                      widths: '300,400,600,800',
                      sizes: portfolio_image_sizes,
                      alt: item_title
                    %}
                  {%- endif -%}
                </div>
                {%- if item_title != blank -%}
                  <span class="gemluxjewel-custom-portfolio__label">{{ item_title | escape }}</span>
                {%- endif -%}
              {%- if item_url != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <button
          type="button"
          class="gemluxjewel-custom-portfolio__nav gemluxjewel-custom-portfolio__nav--next"
          data-gemluxjewel-custom-portfolio-next
          aria-label="Next"
        >
          <img src="{{ 'green-right-arrow.svg' | asset_url }}" alt="" width="16" height="16" class="gemluxjewel-custom-portfolio__nav-icon">
        </button>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "gemluxjewel Custom Portfolio",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "settings": [
    { "type": "text", "id": "prefix", "label": "Prefix", "default": "Our Work" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Our Recent Custom Work" },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Browse bespoke pieces crafted for our clients."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Portfolio item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "View" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Custom Portfolio",
      "blocks": [
        { "type": "item", "settings": { "title": "View" } },
        { "type": "item", "settings": { "title": "View" } },
        { "type": "item", "settings": { "title": "View" } },
        { "type": "item", "settings": { "title": "View" } },
        { "type": "item", "settings": { "title": "View" } },
        { "type": "item", "settings": { "title": "View" } }
      ]
    }
  ]
}
{% endschema %}
