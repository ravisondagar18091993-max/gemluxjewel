{% render 'gemluxjewel-fonts' %}
{{ 'section-gemluxjewel-initiatives.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gemluxjewel-initiatives.js' | asset_url }}" defer="defer"></script>

<section class="gemluxjewel gemluxjewel-initiatives" data-gemluxjewel-initiatives>
  <div class="gemluxjewel-initiatives__grid">
    <div class="gemluxjewel-initiatives__media" aria-hidden="true">
      {%- for block in section.blocks -%}
        <div
          class="gemluxjewel-initiatives__media-item{% if forloop.first %} is-active{% endif %}"
          data-initiative-media="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1600
              | image_tag:
                widths: '750, 990, 1200, 1600',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'lazy',
                class: 'gemluxjewel-initiatives__img'
            }}
          {%- else -%}
            {% render 'gemluxjewel-theme-image',
              use_store_media: true,
              seed: forloop.index,
              width: 1200,
              widths: '750,990,1200,1600',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'gemluxjewel-initiatives__img'
            %}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="gemluxjewel-initiatives__content">
      {%- if section.settings.prefix != blank -%}
        <p class="gemluxjewel-initiatives__prefix">{{ section.settings.prefix | escape }}</p>
      {%- endif -%}

      <div class="gemluxjewel-initiatives__accordion" data-gemluxjewel-initiatives-accordion>
        <div class="closet-accordion" data-gemluxjewel-accordion>
          {%- for block in section.blocks -%}
            <div
              class="gemluxjewel-initiatives__item"
              data-initiative-item="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <div
                class="closet-header{% if forloop.first %} active{% endif %}"
                role="button"
                tabindex="0"
                aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                <h3 class="closet-header-title">{{ block.settings.title | escape }}</h3>
                <span class="gemluxjewel-initiatives__toggle" aria-hidden="true"></span>
              </div>
              <div class="closet-content"{% unless forloop.first %} style="display: none;"{% endunless %}>
                {%- if block.settings.text != blank -%}
                  <div class="gemluxjewel-initiatives__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}
                  <a
                    href="{{ block.settings.link | default: section.settings.default_link }}"
                    class="gemluxjewel-initiatives__link"
                  >
                    <span>{{ block.settings.link_label | escape }}</span>
                    <span class="gemluxjewel-initiatives__link-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "gemluxjewel Initiatives",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "prefix",
      "label": "Prefix",
      "default": "Initiatives"
    },
    {
      "type": "url",
      "id": "default_link",
      "label": "Default learn more link"
    }
  ],
  "blocks": [
    {
      "type": "initiative",
      "name": "Initiative",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Carbon Neutral"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>We offset our carbon footprint through verified programs and invest in renewable energy across our supply chain.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "gemluxjewel Initiatives",
      "blocks": [
        {
          "type": "initiative",
          "settings": {
            "title": "Carbon Neutral",
            "text": "<p>We offset our carbon footprint through verified programs and invest in renewable energy across our supply chain.</p>",
            "link_label": "Learn More"
          }
        },
        {
          "type": "initiative",
          "settings": {
            "title": "Trees for the Future",
            "text": "<p>Every purchase supports reforestation efforts that restore natural habitats and reduce environmental impact.</p>",
            "link_label": "Learn More"
          }
        },
        {
          "type": "initiative",
          "settings": {
            "title": "Gold Recycling",
            "text": "<p>We prioritize recycled precious metals to reduce mining impact while maintaining exceptional quality and brilliance.</p>",
            "link_label": "Learn More"
          }
        }
      ]
    }
  ]
}
{% endschema %}
