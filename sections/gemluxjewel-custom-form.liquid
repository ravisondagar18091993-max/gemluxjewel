{% render 'gemluxjewel-fonts' %}
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-custom-jewellery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gemluxjewel-custom-jewellery.js' | asset_url }}" defer="defer"></script>

<section class="gemluxjewel gemluxjewel-custom-form">
  <div class="gemluxjewel-container">
    {%- liquid
      assign hulk_form_id = section.settings.hulk_form_id | strip
      assign hulk_app_blocks = section.blocks | where: 'type', '@app'
      assign use_hulk = false
      if hulk_form_id != blank or hulk_app_blocks.size > 0
        assign use_hulk = true
      endif
    -%}

    <div class="gemluxjewel-custom-form__panel{% if use_hulk %} gemluxjewel-custom-form__panel--hulk{% endif %}">
      {%- if use_hulk -%}
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="gemluxjewel-custom-form__hulk-app" {{ block.shopify_attributes }}>
              {% render block %}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if hulk_app_blocks.size > 0 -%}
          {%- comment -%} Form rendered via Hulk app block {%- endcomment -%}
        {%- elsif hulk_form_id != blank -%}
          <div class="gemluxjewel-custom-form__hulk">
            <div id="{{ hulk_form_id | escape }}" class="pxFormGenerator"></div>
          </div>
        {%- elsif request.design_mode -%}
          <div class="gemluxjewel-custom-form__hulk-placeholder">
            <p>Add your Hulk Form ID in section settings, or add a <strong>Form Builder App</strong> block above.</p>
            <p>Also enable <strong>App embeds → Hulk Form Builder</strong> in Theme settings.</p>
          </div>
        {%- endif -%}
      {%- else -%}
      <div data-gemluxjewel-custom-form>
      {%- form 'contact', id: 'GemluxCustomJewelleryForm', class: 'gemluxjewel-custom-form__form' -%}
        <input type="hidden" name="contact[subject]" value="{{ section.settings.email_subject | default: 'Custom Engagement Ring Request' | escape }}">

        {%- if form.posted_successfully? -%}
          <p class="gemluxjewel-custom-form__status gemluxjewel-custom-form__status--success" tabindex="-1" autofocus>
            {{ section.settings.success_message | default: 'Thank you! Our design team will be in touch within 24 hours.' | escape }}
          </p>
        {%- elsif form.errors -%}
          <div class="gemluxjewel-custom-form__status gemluxjewel-custom-form__status--error" tabindex="-1" autofocus>
            <p>{{ 'templates.contact.form.error_heading' | t }}</p>
          </div>
        {%- endif -%}

        {%- if section.settings.intro_text != blank -%}
          <p class="gemluxjewel-custom-form__intro">{{ section.settings.intro_text | escape }}</p>
        {%- endif -%}

        <div class="gemluxjewel-custom-form__fields">
          {%- for block in section.blocks -%}
            {%- unless block.type == 'utility_card' or block.type == 'textarea_field' -%}
              {% render 'gemluxjewel-custom-form-field', block: block, form: form %}
            {%- endunless -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.show_file_upload -%}
          <div class="gemluxjewel-custom-form__field gemluxjewel-custom-form__field--full gemluxjewel-custom-form__field--upload" data-gemluxjewel-custom-upload>
            <span class="gemluxjewel-custom-form__label">{{ section.settings.file_upload_label | default: 'Upload Image here' | escape }}</span>
            <p class="gemluxjewel-custom-form__upload-help">{{ section.settings.file_upload_help | default: 'Max file size: 5MB' | escape }}</p>
            <input type="hidden" name="contact[uploaded_files]" value="" data-gemluxjewel-custom-upload-value>
            <div class="gemluxjewel-custom-form__upload-row">
              <label class="gemluxjewel-custom-form__upload-btn" for="GemluxCustomForm-files">
                {{ section.settings.file_upload_button | default: 'Browse File' | escape }}
              </label>
              <input
                class="gemluxjewel-custom-form__upload-input"
                type="file"
                id="GemluxCustomForm-files"
                data-gemluxjewel-custom-upload-input
                accept="image/*,.pdf"
                multiple
              >
              <span class="gemluxjewel-custom-form__upload-names" data-gemluxjewel-custom-upload-names>No file chosen</span>
            </div>
            <p class="gemluxjewel-custom-form__upload-error" data-gemluxjewel-custom-upload-error hidden></p>
          </div>
        {%- endif -%}

        {%- assign vision_blocks = section.blocks | where: 'type', 'textarea_field' -%}
        {%- if vision_blocks.size > 0 -%}
          {%- for block in vision_blocks -%}
            {% render 'gemluxjewel-custom-form-field', block: block, form: form %}
          {%- endfor -%}
        {%- else -%}
          <div class="gemluxjewel-custom-form__field gemluxjewel-custom-form__field--full">
            <label class="gemluxjewel-custom-form__label" for="GemluxCustomForm-vision">Tell us about your vision</label>
            <textarea
              class="gemluxjewel-custom-form__textarea"
              id="GemluxCustomForm-vision"
              name="contact[body]"
              rows="5"
              placeholder="Share your ideas, inspiration, and any details about your dream piece..."
            >{{ form.body }}</textarea>
          </div>
        {%- endif -%}

        {%- if section.settings.show_ring_sizer -%}
          <label class="gemluxjewel-custom-form__sizer">
            <input type="checkbox" name="contact[ring_sizer_kit]" value="Yes">
            <span class="gemluxjewel-custom-form__sizer-box" aria-hidden="true"></span>
            <span class="gemluxjewel-custom-form__sizer-text">
              {{ section.settings.ring_sizer_label | default: 'Get a free ring sizer kit. Usually $15 Value.' | escape }}
            </span>
            {%- if section.settings.ring_sizer_image != blank -%}
              <span class="gemluxjewel-custom-form__sizer-image">
                {{ section.settings.ring_sizer_image | image_url: width: 120 | image_tag: widths: '60, 120', sizes: '60px', loading: 'lazy', alt: '' }}
              </span>
            {%- endif -%}
          </label>
        {%- endif -%}

        <div class="gemluxjewel-custom-form__submit">
          <button type="submit" class="gemluxjewel-custom-form__btn">
            {{ section.settings.button_label | default: 'Next Step' | escape }}
          </button>
        </div>
      {%- endform -%}
      </div>
      {%- endif -%}
    </div>

    {%- assign utility_blocks = section.blocks | where: 'type', 'utility_card' -%}
    {%- if utility_blocks.size > 0 -%}
      <div class="gemluxjewel-custom-form__utilities">
        {%- for block in utility_blocks -%}
          <div class="gemluxjewel-custom-form__utility" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="gemluxjewel-custom-form__utility-media">
                {{ block.settings.image | image_url: width: 800 | image_tag: widths: '400, 800', sizes: '(min-width: 750px) 320px, 100vw', loading: 'lazy', alt: block.settings.title }}
              </div>
            {%- endif -%}
            <div class="gemluxjewel-custom-form__utility-body">
              {%- if block.settings.title != blank -%}
                <h3 class="gemluxjewel-custom-form__utility-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="gemluxjewel-custom-form__utility-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a href="{{ block.settings.button_link | default: routes.root_url }}" class="gemluxjewel-custom-form__utility-btn">
                  {{ block.settings.button_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GL Custom Form",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "settings": [
    {
      "type": "header",
      "content": "Hulk Form Builder"
    },
    {
      "type": "text",
      "id": "hulk_form_id",
      "label": "Hulk Form ID",
      "default": "978R1lbxhx17O5o1yMDqYsA",
      "info": "From Hulk → Forms → Custom Engagement Ring → Form ID. When set, submissions go to Hulk (not Shopify email)."
    },
    {
      "type": "paragraph",
      "content": "Required: Theme Customize → App embeds → Hulk Form Builder ON. You can also add a Form Builder App block in this section."
    },
    {
      "type": "header",
      "content": "Theme form (fallback if Hulk ID is empty)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Page heading",
      "default": "Custom Lab Grown Diamond Engagement Rings"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro text above form",
      "default": "Design your unique jewelry with Gemlux. Tailor every detail to your taste for a truly personal touch. Create the one-of-a-kind piece you've always dreamed of."
    },
    {
      "type": "text",
      "id": "email_subject",
      "label": "Email subject line",
      "default": "Custom Engagement Ring Request"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button",
      "default": "Submit"
    },
    {
      "type": "header",
      "content": "File upload"
    },
    {
      "type": "checkbox",
      "id": "show_file_upload",
      "label": "Show browse file field",
      "default": true
    },
    {
      "type": "text",
      "id": "file_upload_label",
      "label": "Upload label",
      "default": "Upload Image here"
    },
    {
      "type": "text",
      "id": "file_upload_help",
      "label": "Upload help text",
      "default": "Max file size: 5MB"
    },
    {
      "type": "text",
      "id": "file_upload_button",
      "label": "Browse button label",
      "default": "Browse File"
    },
    {
      "type": "header",
      "content": "Ring sizer offer"
    },
    {
      "type": "checkbox",
      "id": "show_ring_sizer",
      "label": "Show free ring sizer checkbox",
      "default": true
    },
    {
      "type": "text",
      "id": "ring_sizer_label",
      "label": "Ring sizer label",
      "default": "Get a free ring sizer kit. Usually $15 Value."
    },
    {
      "type": "image_picker",
      "id": "ring_sizer_image",
      "label": "Ring sizer image"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you! Our design team will be in touch within 24 hours."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text_field",
      "name": "Text field",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "First Name" },
        { "type": "text", "id": "field_name", "label": "Field name (for email)", "default": "first_name" },
        { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "First Name" },
        { "type": "checkbox", "id": "required", "label": "Required", "default": true },
        { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false }
      ]
    },
    {
      "type": "email_field",
      "name": "Email field",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Email" },
        { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "you@email.com" },
        { "type": "checkbox", "id": "required", "label": "Required", "default": true },
        { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true }
      ]
    },
    {
      "type": "tel_field",
      "name": "Phone field",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Phone" },
        { "type": "text", "id": "field_name", "label": "Field name", "default": "phone" },
        { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "+1 000 000 0000" },
        { "type": "checkbox", "id": "required", "label": "Required", "default": false },
        { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true }
      ]
    },
    {
      "type": "select_field",
      "name": "Dropdown field",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Choose an option" },
        { "type": "text", "id": "field_name", "label": "Field name (for email)", "default": "option" },
        { "type": "text", "id": "placeholder", "label": "Placeholder option", "default": "Choose an option" },
        {
          "type": "textarea",
          "id": "options",
          "label": "Options (comma-separated)",
          "default": "Option 1, Option 2, Option 3",
          "info": "Edit anytime in the theme editor — no code changes needed."
        },
        { "type": "checkbox", "id": "required", "label": "Required", "default": false },
        { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true }
      ]
    },
    {
      "type": "textarea_field",
      "name": "Message field",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Tell us about your vision" },
        { "type": "text", "id": "field_name", "label": "Field name", "default": "body" },
        { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Share your ideas, inspiration, and any details about your dream piece..." },
        { "type": "range", "id": "rows", "min": 3, "max": 10, "step": 1, "label": "Rows", "default": 5 },
        { "type": "checkbox", "id": "required", "label": "Required", "default": false },
        { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true }
      ]
    },
    {
      "type": "utility_card",
      "name": "Utility card",
      "limit": 2,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Heading", "default": "Find Your Ring Size" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Link label", "default": "Ring Size Guide" },
        { "type": "url", "id": "button_link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GL Custom Form",
      "blocks": [
        { "type": "text_field", "settings": { "label": "First Name", "field_name": "first_name", "placeholder": "First Name", "required": true } },
        { "type": "text_field", "settings": { "label": "Last Name", "field_name": "last_name", "placeholder": "Last Name", "required": true } },
        {
          "type": "select_field",
          "settings": {
            "label": "What metal color do you prefer?",
            "field_name": "metal_color",
            "placeholder": "e.g. 14K White Gold",
            "options": "14K White Gold, 14K Yellow Gold, 14K Rose Gold, 18K White Gold, 18K Yellow Gold, Platinum",
            "full_width": true
          }
        },
        {
          "type": "select_field",
          "settings": {
            "label": "Choose Your Diamond Shape",
            "field_name": "diamond_shape",
            "placeholder": "Select a shape",
            "options": "Round, Oval, Cushion, Princess, Pear, Marquise, Emerald, Radiant, Asscher, Heart",
            "full_width": true
          }
        },
        {
          "type": "select_field",
          "settings": {
            "label": "What is the carat weight you're looking for?",
            "field_name": "carat_weight",
            "placeholder": "1.00 - 1.25 ct",
            "options": "Under 1.00 ct, 1.00 - 1.25 ct, 1.25 - 1.50 ct, 1.50 - 2.00 ct, 2.00 - 3.00 ct, Over 3.00 ct",
            "full_width": true
          }
        },
        {
          "type": "select_field",
          "settings": {
            "label": "What is your budget for your ring and center stone?",
            "field_name": "budget",
            "placeholder": "Choose an option",
            "options": "Under $1,000, $1,000 - $2,500, $2,500 - $5,000, $5,000 - $10,000, Over $10,000",
            "full_width": true
          }
        },
        {
          "type": "select_field",
          "settings": {
            "label": "What ring setting style do you like?",
            "field_name": "setting_style",
            "placeholder": "Solitaire",
            "options": "Solitaire, Halo, Three Stone, Pavé, Vintage, Hidden Halo, Bezel",
            "full_width": true
          }
        },
        {
          "type": "select_field",
          "settings": {
            "label": "What is your preferred ring size?",
            "field_name": "ring_size",
            "placeholder": "Choose an option",
            "options": "I don't know yet, 4, 4.5, 5, 5.5, 6, 6.5, 7, 7.5, 8, 8.5, 9, 9.5, 10",
            "full_width": true
          }
        },
        {
          "type": "utility_card",
          "settings": {
            "title": "Find Your Ring Size",
            "text": "Use our ring size guide to find your perfect fit before you order.",
            "button_label": "Ring Size Guide"
          }
        },
        {
          "type": "utility_card",
          "settings": {
            "title": "Talk with a Gemologist",
            "text": "Book a virtual consultation with our experts for personalized guidance.",
            "button_label": "Book Consultation"
          }
        }
      ]
    }
  ]
}
{% endschema %}
