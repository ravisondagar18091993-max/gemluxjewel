{{ 'section-gemlux.css' | asset_url | stylesheet_tag }}

<section class="gemlux gemlux-testimonials">
  <div class="gemlux-testimonials__inner">
    <div class="gemlux__section-header gemlux__section-header--center">
      <div>
        {%- if section.settings.title != blank -%}
          <h2 class="gemlux__heading">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="gemlux__subheading">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    </div>
    <ul class="gemlux-testimonials__grid">
      {%- for block in section.blocks -%}
        <li class="gemlux-testimonials__card" {{ block.shopify_attributes }}>
          <div class="gemlux-testimonials__stars" aria-label="{{ block.settings.rating }} stars">
            {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
          </div>
          {%- if block.settings.text != blank -%}
            <p class="gemlux-testimonials__text">"{{ block.settings.text | escape }}"</p>
          {%- endif -%}
          {%- if block.settings.author != blank -%}
            <p class="gemlux-testimonials__author">{{ block.settings.author | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Gemlux Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Customer Voices" },
    { "type": "text", "id": "subtitle", "label": "Subheading", "default": "Real stories from our happy customers." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "default": 5, "label": "Stars" },
        { "type": "textarea", "id": "text", "label": "Review", "default": "Beautiful quality and so comfortable to wear every day. I receive compliments constantly!" },
        { "type": "text", "id": "author", "label": "Author", "default": "Sarah M." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gemlux Testimonials",
      "blocks": [
        { "type": "review", "settings": { "text": "Beautiful quality and so comfortable to wear every day.", "author": "Sarah M." } },
        { "type": "review", "settings": { "text": "The perfect gift! Elegant packaging and stunning craftsmanship.", "author": "James T." } },
        { "type": "review", "settings": { "text": "Lightweight and gentle on my sensitive skin. Absolutely love it.", "author": "Emma L." } },
        { "type": "review", "settings": { "text": "Exceeded my expectations. Will definitely be ordering again.", "author": "David R." } },
        { "type": "review", "settings": { "text": "Timeless design that goes with everything. Highly recommend.", "author": "Priya K." } },
        { "type": "review", "settings": { "text": "Outstanding customer service and gorgeous jewellery.", "author": "Lisa W." } }
      ]
    }
  ]
}
{% endschema %}
