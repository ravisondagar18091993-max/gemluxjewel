{{ 'dirona-marquee.css' | asset_url | stylesheet_tag }}
{{ 'section-dirona-home.css' | asset_url | stylesheet_tag }}

<section class="dirona dirona-usp-marquee">
  {%- capture usp_marquee_content -%}
    {%- for block in section.blocks -%}
      <div class="dirona-usp-marquee__item" {{ block.shopify_attributes }}>
        <img src="{{ 'diamond.svg' | asset_url }}" alt="" class="dirona-usp-marquee__icon" width="18" height="18">
        <span>{{ block.settings.label | escape }}</span>
      </div>
    {%- endfor -%}
  {%- endcapture -%}
  {% render 'dirona-marquee', class: 'dirona-usp-marquee__inner', duration: section.settings.speed, gap: 48, content: usp_marquee_content %}
</section>

{% schema %}
{
  "name": "Dirona USP Marquee",
  "tag": "section",
  "class": "section dirona-section",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 15,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "USP item",
      "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Free Shipping in UK" }]
    }
  ],
  "presets": [
    {
      "name": "Dirona USP Marquee",
      "blocks": [
        { "type": "item", "settings": { "label": "Free Shipping in UK" } },
        { "type": "item", "settings": { "label": "Premium Materials" } },
        { "type": "item", "settings": { "label": "24/7 Expert Guidance" } }
      ]
    }
  ]
}
{% endschema %}
