{{ 'section-gemluxjewel-policy.css' | asset_url | stylesheet_tag }}
{% render 'gemluxjewel-fonts' %}

<section class="gemluxjewel gemluxjewel-policy gemluxjewel-policy--legal">
  <div class="gemluxjewel-container">
    <article class="gemluxjewel-policy__box gemluxjewel-policy__box--single">
      <h1 class="gemluxjewel-policy__heading">{{ policy.title | escape }}</h1>
      <div class="gemluxjewel-policy__content rte">
        {{ policy.body }}
      </div>
    </article>

    {%- if section.settings.policies_page != blank -%}
      <p class="gemluxjewel-policy__back">
        <a href="{{ section.settings.policies_page }}">{{ section.settings.back_label | escape }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gemlux Policy Legal",
  "tag": "section",
  "class": "gemluxjewel-section",
  "settings": [
    {
      "type": "url",
      "id": "policies_page",
      "label": "All policies page link",
      "info": "Link back to your combined policies page."
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back link label",
      "default": "View all policies"
    }
  ]
}
{% endschema %}
