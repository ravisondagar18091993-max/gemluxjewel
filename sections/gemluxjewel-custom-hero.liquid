{% render 'gemluxjewel-fonts' %}
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
{{ 'section-gemluxjewel-home.css' | asset_url | stylesheet_tag }}
{{ 'section-gemluxjewel-custom-jewellery.css' | asset_url | stylesheet_tag }}

<section class="gemluxjewel gemluxjewel-custom-hero gemluxjewel-custom-hero--intro">
  <div class="gemluxjewel-container">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="gemluxjewel-custom-hero__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home | default: 'Home' | escape }}</a>
        {%- if section.settings.breadcrumb_parent != blank -%}
          <span class="gemluxjewel-custom-hero__breadcrumb-sep">/</span>
          {%- if section.settings.breadcrumb_parent_link != blank -%}
            <a href="{{ section.settings.breadcrumb_parent_link }}">{{ section.settings.breadcrumb_parent | escape }}</a>
          {%- else -%}
            <span>{{ section.settings.breadcrumb_parent | escape }}</span>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.breadcrumb_current != blank -%}
          <span class="gemluxjewel-custom-hero__breadcrumb-sep">/</span>
          <span class="gemluxjewel-custom-hero__breadcrumb-current">{{ section.settings.breadcrumb_current | escape }}</span>
        {%- endif -%}
      </nav>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="gemluxjewel-custom-hero__title">{{ section.settings.title | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="gemluxjewel-custom-hero__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GL Custom Hero",
  "tag": "section",
  "class": "section gemluxjewel-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    { "type": "text", "id": "breadcrumb_home", "label": "Breadcrumb home", "default": "Home" },
    { "type": "text", "id": "breadcrumb_parent", "label": "Breadcrumb parent", "default": "Rings" },
    { "type": "url", "id": "breadcrumb_parent_link", "label": "Breadcrumb parent link" },
    { "type": "text", "id": "breadcrumb_current", "label": "Breadcrumb current", "default": "Engagement Ring" },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Custom Lab Grown Diamond Engagement Rings"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subheading",
      "info": "Optional — leave blank to hide."
    }
  ],
  "presets": [{ "name": "gemluxjewel Custom Hero" }]
}
{% endschema %}
