{% comment %}
  Educational 4Cs diagram illustrations.

  @param type {String} cut | carat | color | clarity
{% endcomment %}

{%- case type -%}
  {%- when 'cut' -%}
    <svg class="gemluxjewel-4cs-diagram gemluxjewel-4cs-diagram--cut" viewBox="0 0 520 320" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <line x1="40" y1="280" x2="480" y2="280" stroke="#b8c4b0" stroke-width="1"/>
      <polygon points="260,40 380,120 260,280 140,120" fill="none" stroke="#73976a" stroke-width="2"/>
      <line x1="140" y1="120" x2="380" y2="120" stroke="#818181" stroke-width="1" stroke-dasharray="4 3"/>
      <line x1="260" y1="40" x2="260" y2="280" stroke="#818181" stroke-width="1" stroke-dasharray="4 3"/>
      <text x="268" y="72" font-family="Arial,sans-serif" font-size="12" fill="#141414">Table</text>
      <text x="390" y="128" font-family="Arial,sans-serif" font-size="12" fill="#141414">Crown</text>
      <text x="390" y="210" font-family="Arial,sans-serif" font-size="12" fill="#141414">Pavilion</text>
      <text x="90" y="128" font-family="Arial,sans-serif" font-size="12" fill="#141414">Girdle</text>
      <text x="248" y="296" font-family="Arial,sans-serif" font-size="12" fill="#141414">Culet</text>
    </svg>

  {%- when 'carat' -%}
    <svg class="gemluxjewel-4cs-diagram gemluxjewel-4cs-diagram--carat" viewBox="0 0 640 180" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="70" cy="70" r="18" fill="none" stroke="#73976a" stroke-width="2"/>
      <text x="70" y="145" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#141414">0.50 ct.</text>
      <circle cx="190" cy="70" r="22" fill="none" stroke="#73976a" stroke-width="2"/>
      <text x="190" y="145" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#141414">0.75 ct.</text>
      <circle cx="310" cy="70" r="26" fill="none" stroke="#73976a" stroke-width="2"/>
      <text x="310" y="145" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#141414">1.00 ct.</text>
      <circle cx="430" cy="70" r="34" fill="none" stroke="#73976a" stroke-width="2"/>
      <text x="430" y="145" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#141414">2.00 ct.</text>
      <circle cx="550" cy="70" r="42" fill="none" stroke="#73976a" stroke-width="2"/>
      <text x="550" y="145" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#141414">3.00 ct.</text>
    </svg>

  {%- when 'color' -%}
    <svg class="gemluxjewel-4cs-diagram gemluxjewel-4cs-diagram--color" viewBox="0 0 560 180" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="70" cy="70" r="34" fill="#f5f8f4" stroke="#73976a" stroke-width="2"/>
      <text x="70" y="130" text-anchor="middle" font-family="Arial,sans-serif" font-size="16" fill="#141414">D</text>
      <text x="70" y="150" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#818181">Colorless</text>
      <circle cx="200" cy="70" r="34" fill="#eef2ea" stroke="#73976a" stroke-width="2"/>
      <text x="200" y="130" text-anchor="middle" font-family="Arial,sans-serif" font-size="16" fill="#141414">H</text>
      <text x="200" y="150" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#818181">Near Colorless</text>
      <circle cx="330" cy="70" r="34" fill="#e4dfd0" stroke="#73976a" stroke-width="2"/>
      <text x="330" y="130" text-anchor="middle" font-family="Arial,sans-serif" font-size="16" fill="#141414">N</text>
      <text x="330" y="150" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#818181">Faint</text>
      <circle cx="460" cy="70" r="34" fill="#d8caa8" stroke="#73976a" stroke-width="2"/>
      <text x="460" y="130" text-anchor="middle" font-family="Arial,sans-serif" font-size="16" fill="#141414">Z</text>
      <text x="460" y="150" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#818181">Light</text>
    </svg>

  {%- when 'clarity' -%}
    <svg class="gemluxjewel-4cs-diagram gemluxjewel-4cs-diagram--clarity" viewBox="0 0 560 180" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="70" cy="70" r="34" fill="none" stroke="#73976a" stroke-width="2"/>
      <text x="70" y="130" text-anchor="middle" font-family="Arial,sans-serif" font-size="14" fill="#141414">FL/IF</text>
      <circle cx="200" cy="70" r="34" fill="none" stroke="#73976a" stroke-width="2"/>
      <circle cx="192" cy="64" r="2" fill="#818181"/>
      <circle cx="210" cy="78" r="1.5" fill="#818181"/>
      <text x="200" y="130" text-anchor="middle" font-family="Arial,sans-serif" font-size="14" fill="#141414">VS1</text>
      <circle cx="330" cy="70" r="34" fill="none" stroke="#73976a" stroke-width="2"/>
      <circle cx="324" cy="60" r="3" fill="#818181"/>
      <circle cx="338" cy="72" r="2.5" fill="#818181"/>
      <circle cx="330" cy="82" r="2" fill="#818181"/>
      <text x="330" y="130" text-anchor="middle" font-family="Arial,sans-serif" font-size="14" fill="#141414">SI1</text>
      <circle cx="460" cy="70" r="34" fill="none" stroke="#73976a" stroke-width="2"/>
      <circle cx="450" cy="58" r="4" fill="#818181"/>
      <circle cx="466" cy="68" r="3.5" fill="#818181"/>
      <circle cx="458" cy="80" r="3" fill="#818181"/>
      <circle cx="472" cy="82" r="2.5" fill="#818181"/>
      <text x="460" y="130" text-anchor="middle" font-family="Arial,sans-serif" font-size="14" fill="#141414">I1</text>
    </svg>
{%- endcase -%}
