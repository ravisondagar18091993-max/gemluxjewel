{% comment %}
  Responsive theme asset image via Shopify CDN (asset_img_url).

  @param asset {String} filename in /assets
  @param width {Number} default src width
  @param widths {String} comma-separated srcset widths
  @param sizes {String} sizes attribute
  @param alt {String}
  @param loading {String} lazy | eager
  @param class {String}
  @param fetchpriority {String} high (optional)
  @param height {Number} optional layout height
{% endcomment %}

{%- liquid
  assign img_width = width | default: 800
  assign img_sizes = sizes | default: '100vw'
  assign img_alt = alt | default: ''
  assign img_loading = loading | default: 'lazy'
  assign width_list = widths | default: img_width | split: ','
-%}

<img
  {% if class != blank %}class="{{ class }}"{% endif %}
  src="{{ asset | asset_img_url: width: img_width }}"
  srcset="
    {%- for w in width_list -%}
      {%- assign w_num = w | strip | plus: 0 -%}
      {{ asset | asset_img_url: width: w_num }} {{ w_num }}w{% unless forloop.last %}, {% endunless %}
    {%- endfor -%}
  "
  sizes="{{ img_sizes }}"
  alt="{{ img_alt | escape }}"
  width="{{ img_width }}"
  {% if height != blank %}height="{{ height }}"{% endif %}
  loading="{{ img_loading }}"
  {% if fetchpriority != blank %}fetchpriority="{{ fetchpriority }}"{% endif %}
>
