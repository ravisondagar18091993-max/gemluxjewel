{% comment %}
  Seamless infinite marquee — duplicate groups, no loop gap.
  Accepts: class, duration (seconds), gap (px), content (HTML string, duplicated twice)
{% endcomment %}
{%- liquid
  assign marquee_class = class | default: 'gemluxjewel-marquee'
  assign marquee_duration = duration | default: 30
  assign marquee_gap = gap | default: 60
-%}
<div class="{{ marquee_class }}" style="--gemluxjewel-marquee-duration: {{ marquee_duration }}s; --gemluxjewel-marquee-gap: {{ marquee_gap }}px;">
  <div class="gemluxjewel-marquee__track">
    <div class="gemluxjewel-marquee__group">{{ content }}</div>
    <div class="gemluxjewel-marquee__group" aria-hidden="true">{{ content }}</div>
  </div>
</div>
