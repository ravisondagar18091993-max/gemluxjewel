{% comment %}
  Gem Lux product card — custom card for homepage sections
  Accepts: product, show_badge, badge_text, section_id
{% endcomment %}

{%- if product and product != empty -%}
  <div class="gemlux-card">
    <div class="gemlux-card__media-wrap">
      {%- if show_badge and badge_text != blank -%}
        <span class="gemlux-card__badge">{{ badge_text }}</span>
      {%- endif -%}
      <div class="gemlux-card__actions">
        <a href="{{ product.url }}" class="gemlux-card__action-btn" aria-label="Quick view">
          <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </a>
        <button type="button" class="gemlux-card__action-btn" aria-label="Add to wishlist">
          <svg viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        </button>
      </div>
      <a href="{{ product.url }}">
        {%- if product.featured_media -%}
          {{
            product.featured_media
            | image_url: width: 600
            | image_tag:
              widths: '200, 300, 400, 600',
              sizes: '(min-width: 990px) 20vw, (min-width: 750px) 25vw, 45vw',
              loading: 'lazy',
              alt: product.title
          }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag }}
        {%- endif -%}
      </a>
    </div>
    <div class="gemlux-card__info">
      <h3 class="gemlux-card__title">
        <a href="{{ product.url }}">{{ product.title | escape }}</a>
      </h3>
      <p class="gemlux-card__price">{{ product.price | money }}</p>
      {%- if product.options.size > 0 and product.options.first == 'Color' or product.options.first == 'Colour' -%}
        <div class="gemlux-card__swatches">
          {%- for value in product.options_by_name['Color'].values limit: 4 -%}
            {%- assign swatch_color = value | downcase -%}
            <span class="gemlux-card__swatch" style="background: {{ swatch_color }};" title="{{ value }}"></span>
          {%- endfor -%}
          {%- for value in product.options_by_name['Colour'].values limit: 4 -%}
            {%- assign swatch_color = value | downcase -%}
            <span class="gemlux-card__swatch" style="background: {{ swatch_color }};" title="{{ value }}"></span>
          {%- endfor -%}
        </div>
      {%- elsif product.variants.size > 1 -%}
        <div class="gemlux-card__swatches">
          {%- for variant in product.variants limit: 4 -%}
            {%- if variant.featured_media -%}
              <span class="gemlux-card__swatch" style="background: #ddd;" title="{{ variant.title }}"></span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- else -%}
  <div class="gemlux-card">
    <div class="gemlux-card__media-wrap">
      {{ 'product-apparel-1' | placeholder_svg_tag }}
    </div>
    <div class="gemlux-card__info">
      <h3 class="gemlux-card__title">Product Title</h3>
      <p class="gemlux-card__price">$0.00</p>
    </div>
  </div>
{%- endif -%}
