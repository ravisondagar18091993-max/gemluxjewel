{% comment %} Dirona font faces — include once per page via hero section {% endcomment %}
{% style %}
  @font-face {
    font-family: 'Instrument Sans';
    src: url('{{ 'instrumentsans-regular.ttf' | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Instrument Sans';
    src: url('{{ 'instrumentsans-medium.ttf' | asset_url }}') format('truetype');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Nunito';
    src: url('{{ 'nunito-light.ttf' | asset_url }}') format('truetype');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Nunito';
    src: url('{{ 'nunito-medium.ttf' | asset_url }}') format('truetype');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Nunito';
    src: url('{{ 'nunito-semibold.ttf' | asset_url }}') format('truetype');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  main:has(.dirona) {
    background-color: #fff8f4;
  }

  /* Remove Dawn inner padding only — keep gaps between sections */
  .shopify-section:has(.dirona) {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  .shopify-section:has(.dirona) + .shopify-section:has(.dirona) {
    margin-top: 50px !important;
  }

  @media screen and (min-width: 750px) {
    .shopify-section:has(.dirona) + .shopify-section:has(.dirona) {
      margin-top: 80px !important;
    }
  }

  @media screen and (min-width: 990px) {
    .shopify-section:has(.dirona) + .shopify-section:has(.dirona) {
      margin-top: 100px !important;
    }
  }

  /* Hero flows directly into USP bar */
  .shopify-section:has(.dirona-hero) + .shopify-section:has(.dirona-usp-marquee) {
    margin-top: 0 !important;
  }
{% endstyle %}
