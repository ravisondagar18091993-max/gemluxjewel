{% comment %}
  Gemluxjewel collection product grid — compatible with Dawn facets.js
  Requires: collection, paginate, section
{% endcomment %}

<div class="collection">
  <div class="loading-overlay gradient"></div>
  {%- if collection.products.size == 0 -%}
    <div class="Gemluxjewel-shop__empty">
      <p>{{ 'sections.collection_template.empty' | t }}</p>
      <p>
        {{ 'sections.collection_template.use_fewer_filters_html' | t: link: collection.url, class: 'Gemluxjewel-shop__empty-link' }}
      </p>
    </div>
  {%- else -%}
    <ul id="product-grid" data-id="{{ section.id }}" class="Gemluxjewel-shop__grid">
      {%- for product in collection.products -%}
        <li>
          {%- liquid
            assign badge_text = ''
            if product.tags contains 'new' or product.tags contains 'New In' or product.tags contains 'NEW IN'
              assign badge_text = 'NEW IN'
            endif
          -%}
          {% render 'Gemluxjewel-product-card', product: product, badge_text: badge_text, show_discount: true %}
        </li>
      {%- endfor -%}
    </ul>
    {% render 'Gemluxjewel-pagination', paginate: paginate %}
  {%- endif -%}
</div>
