{% comment %}
  gemluxjewel typography
  Headings: Figtree
  Body / UI: Outfit
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700&display=swap"
  rel="stylesheet"
>
{% style %}
  .gemluxjewel {
    --gemluxjewel-font-heading: 'Figtree', sans-serif;
    --gemluxjewel-font-body: 'Outfit', var(--font-body-family), sans-serif;
    --gemluxjewel-font-heading-size: 25px;
    --gemluxjewel-font-heading-line-height: 28px;
    --gemluxjewel-font-heading-weight: 600;
    --gemluxjewel-font-heading-weight-medium: 600;
    --gemluxjewel-secondary: #ffffff;
    --gemluxjewel-dark: #101010;
    --gemluxjewel-text-title: #101010;
    --gemluxjewel-text-desc: #101010;
    --gemluxjewel-text-desc-muted: rgba(16, 16, 16, 0.72);
  }

  .gemluxjewel :is(
    .gemluxjewel-section-title,
    h1:not(.gemluxjewel-hero__title):not(.gemluxjewel-pdp__title):not(.gemluxjewel-contact-page__hero-title):not([class*='gemluxjewel-engagement-']):not([class*='gemluxjewel-privacy-']),
    h2:not(.gemluxjewel-blog-card__title):not([class*='gemluxjewel-engagement-']),
    h3:not([class*='gemluxjewel-engagement-']):not(.gemluxjewel-plp-sidebar-group__title),
    h4:not([class*='gemluxjewel-engagement-']),
    h5:not([class*='gemluxjewel-engagement-']),
    h6:not([class*='gemluxjewel-engagement-']),
    [class*='__heading']:not([class*='gemluxjewel-engagement-']),
    [class*='-heading']:not([class*='gemluxjewel-engagement-'])
  ) {
    font-family: var(--gemluxjewel-font-heading);
    font-size: var(--gemluxjewel-font-heading-size);
    line-height: var(--gemluxjewel-font-heading-line-height);
    font-weight: var(--gemluxjewel-font-heading-weight);
    text-transform: uppercase;
  }

  main:has(.gemluxjewel) {
    background-color: #ffffff;
  }

  .shopify-section:has(.gemluxjewel) {
    margin-top: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  .gemluxjewel .gemluxjewel-container {
    width: 88%;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  .gemluxjewel :is(
    .gemluxjewel-section-title,
    .gemluxjewel-pdp__title,
    .gemluxjewel-article__title,
    .gemluxjewel-policy__heading,
    .gemluxjewel-custom-hero__title,
    .gemluxjewel-pdp-how-made__title,
    .gemluxjewel-pdp-how-made__item-title,
    .gemluxjewel-pdp-how-made__item-text,
    .gemluxjewel-about-mission__title,
    .gemluxjewel-about-mission__prefix,
    .gemluxjewel-about-mission__card-label,
    .gemluxjewel-about-founder__prefix,
    .gemluxjewel-about-founder__quote,
    .gemluxjewel-about-history__card-title,
    .gemluxjewel-custom-made-to-order__title,
    .gemluxjewel-custom-expert__title,
    .gemluxjewel-custom-faq__title,
    .gemluxjewel-custom-why__title,
    .gemluxjewel-custom-form__utility-title,
    .gemluxjewel-pdp-trust__title,
    .gemluxjewel-pdp-trust__prefix,
    .gemluxjewel-blog-card__title a,
    .gemluxjewel-pdp-faq__title,
    .gemluxjewel-dual-cards__title,
    .gemluxjewel-split-promo__title,
    .gemluxjewel-testimonials__title,
    .gemluxjewel-news__title
  ) {
    color: var(--gemluxjewel-text-title);
  }

  .gemluxjewel :is(
    .gemluxjewel-section-desc,
    .gemluxjewel-custom-hero__text,
    .gemluxjewel-custom-faq__accordion .closet-content__inner,
    .gemluxjewel-custom-form__utility-text,
    .gemluxjewel-custom-form__intro,
    .gemluxjewel-custom-made-to-order__text,
    .gemluxjewel-custom-expert__text,
    .gemluxjewel-custom-why__content,
    .gemluxjewel-pdp-trust__label,
    .gemluxjewel-pdp-faq__desc,
    .gemluxjewel-dual-cards__desc,
    .gemluxjewel-split-promo__desc
  ) {
    color: var(--gemluxjewel-text-desc);
  }

  .gemluxjewel .gemluxjewel-article__content :is(h2, h3, h4) {
    color: var(--gemluxjewel-text-title);
  }

  .gemluxjewel.gemluxjewel-pdp--ref .gemluxjewel-pdp__title,
  .gemluxjewel.gemluxjewel-pdp--ref .gemluxjewel-pdp__complete-set-title {
    color: var(--gemluxjewel-text-title);
  }

  .gemluxjewel.gemluxjewel-our-story :is(
    .gemluxjewel-our-story-split__heading,
    .gemluxjewel-our-story-cta__title,
    .gemluxjewel-our-story-reviews__title
  ) {
    color: var(--gemluxjewel-text-title);
  }
{% endstyle %}
