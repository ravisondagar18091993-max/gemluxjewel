{% comment %}
  gemluxjewel typography
  Headings: Space Grotesk
  Body / UI: Outfit
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
  rel="stylesheet"
>
{% style %}
  .gemluxjewel {
    --gemluxjewel-font-heading: 'Space Grotesk', var(--font-heading-family), sans-serif;
    --gemluxjewel-font-body: 'Outfit', var(--font-body-family), sans-serif;
    --gemluxjewel-font-heading-weight: 400;
    --gemluxjewel-font-heading-weight-medium: 500;
  }

  .gemluxjewel :where(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--gemluxjewel-font-heading-weight);
  }

  .gemluxjewel :where(
    [class*='__title'],
    [class*='__heading'],
    [class*='-heading'],
    .gemluxjewel-section-title
  ) {
    font-weight: var(--gemluxjewel-font-heading-weight);
  }

  .gemluxjewel :where(
    [class*='__title--medium'],
    [class*='__heading--medium'],
    .gemluxjewel-nunito-medium
  ) {
    font-weight: var(--gemluxjewel-font-heading-weight-medium);
  }

  main:has(.gemluxjewel) {
    background-color: #ffffff;
  }

  .shopify-section:has(.gemluxjewel) {
    margin-top: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }
{% endstyle %}
