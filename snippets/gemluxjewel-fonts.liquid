{% comment %}
  gemluxjewel typography
  Headings: Noto Serif
  Body / UI: Outfit
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700&display=swap"
  rel="stylesheet"
>
{% style %}
  .gemluxjewel {
    --gemluxjewel-font-heading: 'Noto Serif', Georgia, 'Times New Roman', serif;
    --gemluxjewel-font-body: 'Outfit', var(--font-body-family), sans-serif;
  }

  main:has(.gemluxjewel) {
    background-color: #ffffff;
  }

  .shopify-section:has(.gemluxjewel) {
    margin-top: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }
{% endstyle %}
