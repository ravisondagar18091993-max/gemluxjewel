{% comment %}
  Premium mobile navigation drawer.
  Accepts: section, logo_label
{% endcomment %}

{%- liquid
  assign contact_nav_raw = section.settings.contact_mega_nav | default: 'Contact, Contact Us'
  assign highlight_title = section.settings.highlight_link | downcase | strip
-%}

<div class="gemluxjewel gemluxjewel-mobile-menu" data-gemluxjewel-mobile-menu id="gemluxjewelMobileMenu">
  <div class="gemluxjewel-mobile-menu__head">
    <a href="{{ routes.root_url }}" class="gemluxjewel-header__logo">{{ logo_label | escape }}</a>
    <button type="button" class="gemluxjewel-mobile-menu__close" data-gemluxjewel-menu-close aria-label="Close menu">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M1.25 1.25L16.75 16.75M16.75 1.25L1.25 16.75" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="gemluxjewel-mobile-menu__body">
    <div class="gemluxjewel-mobile-menu__panels" data-gemluxjewel-mobile-panels>
      <div class="gemluxjewel-mobile-menu__panel is-active" data-mobile-panel="main">
        <nav class="gemluxjewel-mobile-menu__nav" aria-label="Mobile">
          <ul class="gemluxjewel-mobile-menu__list menu-drawer__menu list-menu" role="list">
            {%- if section.settings.menu != blank -%}
              {%- for link in section.settings.menu.links -%}
                {%- assign panel_id = 'left-' | append: link.handle -%}
                <li class="gemluxjewel-mobile-menu__list-item">
                  {%- if link.links.size > 0 -%}
                    <button
                      type="button"
                      class="gemluxjewel-mobile-menu__item gemluxjewel-mobile-menu__item--expand"
                      data-mobile-open="{{ panel_id }}"
                      aria-controls="gemluxjewelMobilePanel-{{ panel_id }}"
                    >
                      <span class="gemluxjewel-mobile-menu__item-label">{{ link.title | escape }}</span>
                      <span class="gemluxjewel-mobile-menu__item-chevron" aria-hidden="true">
                        <svg width="10" height="16" viewBox="0 0 10 16" fill="none">
                          <path d="M1.5 1.5L8 8L1.5 14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    </button>
                  {%- else -%}
                    <a href="{{ link.url }}" class="gemluxjewel-mobile-menu__item" data-gemluxjewel-menu-close-on-click>
                      <span class="gemluxjewel-mobile-menu__item-label">{{ link.title | escape }}</span>
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            {%- endif -%}

            {%- if section.settings.menu_right != blank -%}
              {%- if section.settings.menu != blank -%}
                <li class="gemluxjewel-mobile-menu__list-item gemluxjewel-mobile-menu__list-item--divider" aria-hidden="true"></li>
              {%- endif -%}
              {%- for link in section.settings.menu_right.links -%}
                {%- assign panel_id = 'right-' | append: link.handle -%}
                {%- assign link_title_down = link.title | downcase | strip -%}
                <li class="gemluxjewel-mobile-menu__list-item">
                  {%- if link.links.size > 0 -%}
                    <button
                      type="button"
                      class="gemluxjewel-mobile-menu__item gemluxjewel-mobile-menu__item--expand{% if link_title_down == highlight_title %} is-highlight{% endif %}"
                      data-mobile-open="{{ panel_id }}"
                      aria-controls="gemluxjewelMobilePanel-{{ panel_id }}"
                    >
                      <span class="gemluxjewel-mobile-menu__item-label">{{ link.title | escape }}</span>
                      <span class="gemluxjewel-mobile-menu__item-chevron" aria-hidden="true">
                        <svg width="10" height="16" viewBox="0 0 10 16" fill="none">
                          <path d="M1.5 1.5L8 8L1.5 14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    </button>
                  {%- else -%}
                    <a
                      href="{{ link.url }}"
                      class="gemluxjewel-mobile-menu__item{% if link_title_down == highlight_title %} is-highlight{% endif %}"
                      data-gemluxjewel-menu-close-on-click
                    >
                      <span class="gemluxjewel-mobile-menu__item-label">{{ link.title | escape }}</span>
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            {%- endif -%}

            {%- if section.settings.mobile_menu != blank -%}
              {%- for link in section.settings.mobile_menu.links -%}
                <li class="gemluxjewel-mobile-menu__list-item">
                  <a href="{{ link.url }}" class="gemluxjewel-mobile-menu__item" data-gemluxjewel-menu-close-on-click>
                    <span class="gemluxjewel-mobile-menu__item-label">{{ link.title | escape }}</span>
                  </a>
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </nav>
      </div>

      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          {%- if link.links.size > 0 -%}
            {%- assign panel_id = 'left-' | append: link.handle -%}
            {% render 'gemluxjewel-mobile-menu-panel',
              link: link,
              panel_id: panel_id,
              section: section,
              contact_nav_raw: contact_nav_raw
            %}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if section.settings.menu_right != blank -%}
        {%- for link in section.settings.menu_right.links -%}
          {%- if link.links.size > 0 -%}
            {%- assign panel_id = 'right-' | append: link.handle -%}
            {% render 'gemluxjewel-mobile-menu-panel',
              link: link,
              panel_id: panel_id,
              section: section,
              contact_nav_raw: contact_nav_raw
            %}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <div class="gemluxjewel-mobile-menu__utilities">
    {%- if section.settings.enable_search -%}
      <a href="{{ routes.search_url }}" class="gemluxjewel-mobile-menu__utility" data-gemluxjewel-menu-close-on-click aria-label="Search">
        <img src="{{ 'header-search-thin.svg' | asset_url }}" alt="" width="20" height="20">
        <span>Search</span>
      </a>
    {%- endif -%}
    {%- if section.settings.show_account_icon -%}
      <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="gemluxjewel-mobile-menu__utility" data-gemluxjewel-menu-close-on-click aria-label="Account">
        <img src="{{ 'header-icon2.svg' | asset_url }}" alt="" width="20" height="20">
        <span>Account</span>
      </a>
    {%- endif -%}
    <a href="{{ routes.cart_url }}" class="gemluxjewel-mobile-menu__utility" data-gemluxjewel-menu-close-on-click aria-label="Cart">
      <img src="{{ 'header-bag-thin.svg' | asset_url }}" alt="" width="20" height="20">
      <span>Cart{%- if cart.item_count > 0 -%} ({{ cart.item_count }}){%- endif -%}</span>
    </a>
  </div>
</div>
