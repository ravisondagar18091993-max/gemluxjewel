{%- comment -%}
  Renders the correct mega menu for a nav item.
  Accepts: link, section
{%- endcomment -%}

{%- liquid
  assign link_key = link.title | downcase | strip
  assign use_contact_mega = false

  if section.settings.contact_mega_nav != blank
    assign contact_nav_items = section.settings.contact_mega_nav | downcase | split: ','
    for nav_item in contact_nav_items
      assign nav_item_trim = nav_item | strip
      if nav_item_trim != blank and link_key == nav_item_trim
        assign use_contact_mega = true
      endif
    endfor
  endif

  if use_contact_mega == false and link_key contains 'contact'
    assign use_contact_mega = true
  endif
-%}

{%- if use_contact_mega -%}
  {% render 'gemluxjewel-mega-menu-contact', link: link, section: section %}
{%- else -%}
  {% render 'gemluxjewel-mega-menu', link: link, section: section %}
{%- endif -%}
