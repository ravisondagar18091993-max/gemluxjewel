{% comment %}
  Dirona PDP variant picker — works with Dawn variant-selects / product-info.js
{% endcomment %}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
-%}

{%- unless product.has_only_default_variant -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-id="{{ product.id }}"
    data-currency-code="{{ cart.currency.iso_code }}"
    data-selected-price-amount="{{ product.selected_or_first_available_variant.price | default: 0 | money_amount | escape }}"
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_downcase = option.name | downcase
        assign is_color = false
        if option_downcase == 'color' or option_downcase == 'colour'
          assign is_color = true
        endif
      -%}
      <fieldset class="js product-form__input dirona-pdp__option{% if is_color %} dirona-pdp__option--color{% else %} dirona-pdp__option--pill{% endif %}">
        <legend class="dirona-pdp__option-label">{{ option.name | upcase }}:</legend>
        <div class="dirona-pdp__option-values{% if is_color %} dirona-pdp__swatches{% endif %}">
          {%- for value in option.values -%}
            {%- liquid
              assign option_disabled = false
              unless value.available
                assign option_disabled = true
              endunless
              capture input_id
                echo section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
              endcapture
              capture input_name
                echo option.name | append: '-' | append: option.position
              endcapture
              assign swatch_mod = 'dirona-swatch'
              assign value_downcase = value | downcase
              if value_downcase contains 'silver' or value_downcase contains 'grey' or value_downcase contains 'gray' or value_downcase contains 'white' or value_downcase contains 'platinum'
                assign swatch_mod = 'dirona-swatch dirona-swatch--gray'
              endif
            -%}
            <input
              type="radio"
              id="{{ input_id }}"
              name="{{ input_name | escape }}"
              value="{{ value | escape }}"
              form="{{ product_form_id }}"
              {% if value.selected %}checked{% endif %}
              {% if option_disabled %}class="disabled"{% endif %}
              data-product-url="{{ value.product_url }}"
              data-option-value-id="{{ value.id }}"
              data-option-name="{{ option.name | escape }}"
            >
            {%- if is_color -%}
              <label for="{{ input_id }}" class="{{ swatch_mod }}" title="{{ value | escape }}">
                <span class="dirona-swatch__inner"></span>
                <span class="visually-hidden">{{ value }}</span>
              </label>
            {%- else -%}
              <label for="{{ input_id }}" class="dirona-pdp__pill">{{ value }}</label>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endfor -%}
    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- endunless -%}
