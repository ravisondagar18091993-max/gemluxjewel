{% comment %}
  PDP info accordion row.
  Accepts: title, content, shopify_attributes (optional)
{% endcomment %}

{%- liquid
  assign open_by_default = open_by_default | default: false
  if open_by_default == true or open_by_default == 'true'
    assign is_accordion_open = true
  else
    assign is_accordion_open = false
  endif
-%}

{%- if title != blank and content != blank -%}
  <div class="closet-item{% if is_accordion_open %} is-open{% endif %}" {{ shopify_attributes }}>
    <div
      class="closet-header{% if is_accordion_open %} active{% endif %}"
      role="button"
      tabindex="0"
      aria-expanded="{% if is_accordion_open %}true{% else %}false{% endif %}"
    >
      <div class="closet-header-title">{{ title | escape }}</div>
      <span class="accordion-close" aria-hidden="true">
        <svg class="gemluxjewel-pdp__accordion-icon" width="12" height="12" viewBox="0 0 12 12" focusable="false">
          <path d="M2 4.5 6 8.5 10 4.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
    <div class="closet-content"{% unless is_accordion_open %} hidden{% endunless %}>
      <div class="closet-content__inner rte">
        {{ content }}
      </div>
    </div>
  </div>
{%- endif -%}
