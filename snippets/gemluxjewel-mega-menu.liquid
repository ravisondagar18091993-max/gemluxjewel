{% comment %}
  Mega menu built from Shopify navigation links.
  Accepts: link (top-level nav item with children), section
  Column 6: hover preview image (collection image, custom upload, or fallback).
{% endcomment %}

{%- if link.links.size > 0 -%}
  {%- liquid
    assign link_key = link.title | downcase | strip
    assign highlight_titles = section.settings.mega_highlight_links | downcase | split: ','
    assign new_badge_titles = section.settings.mega_new_badge_links | downcase | split: ','
    assign link_image_blocks = section.blocks | where: 'type', 'mega_link_image'
    assign nav_fallback_image = blank
    assign nav_default_caption = blank
    assign nav_default_link = blank

    for block in section.blocks
      if block.type == 'mega_banner'
        assign block_parent = block.settings.parent_nav | downcase | strip
        if block_parent == link_key
          if block.settings.fallback_image != blank
            assign nav_fallback_image = block.settings.fallback_image
          elsif block.settings.image != blank
            assign nav_fallback_image = block.settings.image
          endif
          assign nav_default_caption = block.settings.caption
          assign nav_default_link = block.settings.link
        endif
      endif
    endfor

    if nav_fallback_image == blank and section.settings.mega_default_collection_image != blank
      assign nav_fallback_image = section.settings.mega_default_collection_image
    endif

    assign default_preview_image = nav_fallback_image
    assign default_preview_caption = nav_default_caption
    assign mega_menu_cols = link.links.size | plus: 1
  -%}

  <div class="gemluxjewel-header__mega" data-gemluxjewel-mega-panel data-gemluxjewel-mega-standard>
    <div class="gemluxjewel-header__mega-inner">
      <div
        class="gemluxjewel-header__mega-grid gemluxjewel-header__mega-grid--featured"
        style="--mega-menu-cols: {{ mega_menu_cols }};"
        data-mega-cols="{{ mega_menu_cols }}"
      >
        {%- for child in link.links -%}
          {%- liquid
            assign child_key = child.title | downcase | strip
            assign show_info = false
            if section.settings.mega_info_columns != blank
              assign info_columns = section.settings.mega_info_columns | downcase | split: ','
              for info_col in info_columns
                assign info_col_trim = info_col | strip
                if info_col_trim == child_key
                  assign show_info = true
                endif
              endfor
            endif

            assign child_preview_image = blank
            assign child_title_key = child.title | downcase | strip
            for block in link_image_blocks
              assign block_parent = block.settings.parent_nav | downcase | strip
              assign block_link = block.settings.link_title | downcase | strip
              if block_parent == link_key and block_link == child_title_key and block.settings.image != blank
                assign child_preview_image = block.settings.image
              endif
            endfor
            if child_preview_image == blank and child.type == 'collection_link' and child.object.featured_image != blank
              assign child_preview_image = child.object.featured_image
            endif
            if child_preview_image == blank
              assign child_preview_image = nav_fallback_image
            endif
            if default_preview_image == blank and child_preview_image != blank
              assign default_preview_image = child_preview_image
              assign default_preview_caption = child.title
            endif
          -%}
          <div class="gemluxjewel-header__mega-col">
            <div class="gemluxjewel-header__mega-title-row">
              {%- if child.url != blank -%}
                <a
                  href="{{ child.url }}"
                  class="gemluxjewel-header__mega-title gemluxjewel-header__mega-title--link"
                  {% if child_preview_image != blank %}
                    data-mega-preview-src="{{ child_preview_image | image_url: width: 560 }}"
                    data-mega-preview-caption="{{ child.title | escape }}"
                  {% endif %}
                >
                  {{ child.title | escape }}
                </a>
              {%- else -%}
                <span class="gemluxjewel-header__mega-title">{{ child.title | escape }}</span>
              {%- endif -%}
              {%- if show_info and child.url != blank -%}
                <a href="{{ child.url }}" class="gemluxjewel-header__mega-info" aria-label="More information about {{ child.title | escape }}">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1"/>
                    <path d="M7 6.2V9.4M7 4.6h.01" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  </svg>
                </a>
              {%- elsif show_info -%}
                <span class="gemluxjewel-header__mega-info" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1"/>
                    <path d="M7 6.2V9.4M7 4.6h.01" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  </svg>
                </span>
              {%- endif -%}
            </div>

            {%- if child.links.size > 0 -%}
              <ul class="gemluxjewel-header__mega-list">
                {%- for grandchild in child.links -%}
                  {%- liquid
                    assign grandchild_key = grandchild.title | downcase | strip
                    assign is_highlight = false
                    assign is_new = false
                    for highlight in highlight_titles
                      assign highlight_trim = highlight | strip
                      if highlight_trim == grandchild_key
                        assign is_highlight = true
                      endif
                    endfor
                    for new_item in new_badge_titles
                      assign new_trim = new_item | strip
                      if new_trim == grandchild_key
                        assign is_new = true
                      endif
                    endfor

                    assign preview_image = blank
                    for block in link_image_blocks
                      assign block_parent = block.settings.parent_nav | downcase | strip
                      assign block_link = block.settings.link_title | downcase | strip
                      if block_parent == link_key and block_link == grandchild_key and block.settings.image != blank
                        assign preview_image = block.settings.image
                      endif
                    endfor
                    if preview_image == blank and grandchild.type == 'collection_link' and grandchild.object.featured_image != blank
                      assign preview_image = grandchild.object.featured_image
                    endif
                    if preview_image == blank
                      assign preview_image = nav_fallback_image
                    endif
                    if default_preview_image == blank and preview_image != blank
                      assign default_preview_image = preview_image
                      assign default_preview_caption = grandchild.title
                    endif
                  -%}
                  <li>
                    <a
                      href="{{ grandchild.url }}"
                      class="gemluxjewel-header__mega-link{% if is_highlight %} is-highlight{% endif %}"
                      {% if preview_image != blank %}
                        data-mega-preview-src="{{ preview_image | image_url: width: 560 }}"
                        data-mega-preview-caption="{{ grandchild.title | escape }}"
                      {% endif %}
                    >
                      <span>{{ grandchild.title | escape }}</span>
                      {%- if is_new -%}
                        <span class="gemluxjewel-header__mega-badge">New</span>
                      {%- endif -%}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- elsif child.url != blank -%}
              <ul class="gemluxjewel-header__mega-list">
                <li>
                  <a
                    href="{{ child.url }}"
                    class="gemluxjewel-header__mega-link"
                    {% if child_preview_image != blank %}
                      data-mega-preview-src="{{ child_preview_image | image_url: width: 560 }}"
                      data-mega-preview-caption="{{ child.title | escape }}"
                    {% endif %}
                  >
                    <span>{{ child.title | escape }}</span>
                  </a>
                </li>
              </ul>
            {%- endif -%}
          </div>
        {%- endfor -%}

        <div
          class="gemluxjewel-header__mega-col gemluxjewel-header__mega-col--preview"
          data-gemluxjewel-mega-preview
          {% if default_preview_image != blank %}
            data-default-src="{{ default_preview_image | image_url: width: 560 }}"
            data-default-caption="{{ default_preview_caption | escape }}"
          {% endif %}
        >
          {%- if nav_default_link != blank -%}
            <a href="{{ nav_default_link }}" class="gemluxjewel-header__mega-preview">
          {%- else -%}
            <div class="gemluxjewel-header__mega-preview">
          {%- endif -%}
            <div class="gemluxjewel-header__mega-preview-img">
              <img
                class="gemluxjewel-header__mega-preview-current"
                data-gemluxjewel-mega-preview-current
                {% if default_preview_image != blank %}
                  src="{{ default_preview_image | image_url: width: 560 }}"
                  alt="{{ default_preview_caption | escape }}"
                {% endif %}
                loading="lazy"
                width="560"
                height="560"
              >
            </div>
            {%- if default_preview_caption != blank -%}
              <span class="gemluxjewel-header__mega-preview-caption" data-gemluxjewel-mega-preview-caption>
                {{ default_preview_caption | escape }}
              </span>
            {%- else -%}
              <span class="gemluxjewel-header__mega-preview-caption" data-gemluxjewel-mega-preview-caption hidden></span>
            {%- endif -%}
          {%- if nav_default_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
