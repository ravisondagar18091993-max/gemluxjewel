{% comment %}
  Shopify robots.txt — keeps default crawl rules and declares the store sitemap.
  Live sitemap: {{ shop.url }}/sitemap.xml (auto-generated by Shopify)
{% endcomment %}

{% for group in robots.default_groups %}
  {{- group.user_agent -}}

  {% for rule in group.rules %}
    {{- rule -}}
  {% endfor %}

  {%- if group.sitemap != blank -%}
    {{ group.sitemap }}
  {%- endif -%}
{% endfor %}

Sitemap: {{ shop.url }}/sitemap.xml
